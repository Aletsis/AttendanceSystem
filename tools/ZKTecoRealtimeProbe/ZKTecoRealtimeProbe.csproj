<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Prueba técnica (fase 1) de checadas en tiempo real por SDK ZKTeco.
    Proyecto independiente: no forma parte de AttendanceSystem.sln ni toca la base de datos.
    Necesita Windows x86 (zkemkeeper es COM de 32 bits) y un hilo STA con bucle de mensajes, por eso WinForms.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZKTecoRealtimeProbe</RootNamespace>
    <AssemblyName>ZKTecoRealtimeProbe</AssemblyName>
  </PropertyGroup>

  <!-- Se reutilizan las DLL del SDK que ya usa el servicio ZKTeco, sin duplicarlas en el repositorio. -->
  <PropertyGroup>
    <ZKTecoLib>..\..\src\Infrastructure\AttendanceSystem.ZKTeco\lib</ZKTecoLib>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Interop.zkemkeeper">
      <HintPath>$(ZKTecoLib)\Interop.zkemkeeper.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(ZKTecoLib)\*.dll"
          Exclude="$(ZKTecoLib)\Interop.zkemkeeper.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
