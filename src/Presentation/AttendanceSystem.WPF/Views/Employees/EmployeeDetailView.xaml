<UserControl x:Class="AttendanceSystem.WPF.Views.Employees.EmployeeDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="{StaticResource Brush.Background}">

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Rejilla de dos columnas para los campos de cada pestaña. -->
        <Style x:Key="TwoColumnGrid" TargetType="Grid">
            <Setter Property="MaxWidth" Value="920"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="30,24,30,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Encabezado -->
                <RowDefinition Height="*"/>    <!-- Pestañas -->
                <RowDefinition Height="Auto"/> <!-- Vigencia -->
                <RowDefinition Height="Auto"/> <!-- Acciones -->
            </Grid.RowDefinitions>

            <!-- Encabezado: regresar, iniciales, nombre y estatus -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding CancelCommand}" Style="{StaticResource MahApps.Styles.Button.Circle}"
                        Width="40" Height="40" Margin="0,0,16,0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                        ToolTip="Regresar sin guardar" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="18" Height="18" Foreground="{StaticResource Brush.Primary}"/>
                </Button>

                <Border Grid.Column="1" Width="56" Height="56" CornerRadius="28" Background="{StaticResource Brush.PrimarySoft}" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Initials}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Brush.Primary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Brush.Text}"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Border Grid.Column="3" Style="{StaticResource BadgeBorderStyle}" Padding="12,5"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding Status, Converter={StaticResource EnumDisplayConverter}}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}"/>
                </Border>
            </Grid>

            <!-- Pestañas del formulario -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24,8,24,0" Margin="0">
                <TabControl Style="{StaticResource PageTabControlStyle}" ItemContainerStyle="{StaticResource PageTabItemStyle}"
                            SelectedIndex="{Binding SelectedTabIndex}">

                    <!-- ===== General ===== -->
                    <TabItem Header="Datos generales">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Style="{StaticResource TwoColumnGrid}" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="No. de empleado *" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"
                                             IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBooleanConverter}}"
                                             mah:TextBoxHelper.Watermark="Mismo número que en el reloj"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="Fecha de ingreso *" Style="{StaticResource FormLabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding HireDate}" Style="{StaticResource FormDatePickerStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="Nombre(s) *" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="Apellidos *" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="Sexo" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding GenderOptions}" ItemTemplate="{StaticResource EnumItemTemplate}" SelectedItem="{Binding Gender}" Style="{StaticResource FormComboBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="Estatus" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding StatusOptions}" ItemTemplate="{StaticResource EnumItemTemplate}" SelectedItem="{Binding Status}" Style="{StaticResource FormComboBoxStyle}"
                                              IsEnabled="{Binding CanChangeStatus}"/>
                                    <TextBlock Text="El alta siempre inicia en Alta; el estatus se cambia al editar." Style="{StaticResource FormHelperStyle}" Margin="0,4,0,0"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="Correo electrónico" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Email}" Style="{StaticResource FormTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2" Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="Teléfono" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding PhoneNumber}" Style="{StaticResource FormTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Organización ===== -->
                    <TabItem Header="Puesto">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Style="{StaticResource TwoColumnGrid}" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="Sucursal *" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Branches}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedBranchId}"
                                              Style="{StaticResource FormComboBoxStyle}" IsEnabled="{Binding CanEditSchedule}"/>
                                    <TextBlock Text="Cambiar de sucursal lleva fecha de vigencia." Style="{StaticResource FormHelperStyle}" Margin="0,4,0,0"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="Departamento *" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Departments}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedDepartmentId}" Style="{StaticResource FormComboBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="Puesto *" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding VisiblePositions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedPositionId}" Style="{StaticResource FormComboBoxStyle}"/>
                                    <TextBlock Text="Sólo los puestos del departamento elegido." Style="{StaticResource FormHelperStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Horario ===== -->
                    <TabItem Header="Horario y descanso">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="920" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <Border Style="{StaticResource InfoBannerStyle}"
                                        Visibility="{Binding CanEditSchedule, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <TextBlock Text="Sólo RH o Administrador pueden cambiar el turno, el horario y los descansos." Style="{StaticResource BannerTextStyle}"/>
                                </Border>

                                <Grid IsEnabled="{Binding CanEditSchedule}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Style="{StaticResource FormFieldStyle}">
                                        <TextBlock Text="Turno *" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding ShiftTypeOptions}" ItemTemplate="{StaticResource EnumItemTemplate}" SelectedItem="{Binding SelectedShiftType}" Style="{StaticResource FormComboBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Style="{StaticResource FormFieldStyle}"
                                                Visibility="{Binding IsFixedSchedule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Horario *" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding VisibleShifts}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedShiftId}" Style="{StaticResource FormComboBoxStyle}"/>
                                        <TextBlock Text="Sólo los horarios del turno elegido." Style="{StaticResource FormHelperStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Descansos (horario fijo): uno o varios días -->
                                <StackPanel Visibility="{Binding IsFixedSchedule, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding CanEditSchedule}">
                                    <TextBlock Text="Días de descanso" Style="{StaticResource FormLabelStyle}"/>
                                    <ItemsControl ItemsSource="{Binding RestDays}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected}" Style="{StaticResource DayChipStyle}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding RestDaysSummary}" Style="{StaticResource FormHelperStyle}" Margin="0,0,0,8"/>
                                </StackPanel>

                                <!-- Esquema rotativo vigente -->
                                <Border Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Primary}" BorderThickness="4,0,0,0"
                                        CornerRadius="6" Padding="16,12" Margin="0,0,0,16"
                                        Visibility="{Binding HasExistingRoster, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="Autorenew" Width="16" Height="16" Foreground="{StaticResource Brush.Primary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock FontWeight="Bold" Foreground="{StaticResource Brush.Text}">
                                                    <Run Text="Esquema rotativo activo:"/>
                                                    <Run Text="{Binding ExistingRoster.SchemeName, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ExistingRosterPeriod}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" Margin="24,4,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" IsChecked="{Binding EditRotation}" Style="{StaticResource DayChipStyle}" Margin="0" VerticalAlignment="Center"
                                                      Content="Modificar esquema" Visibility="{Binding CanModifyRotation, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Editor del esquema rotativo (igual que la web) -->
                                <StackPanel Visibility="{Binding ShowRotationEditor, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding CanEditSchedule}">
                                <StackPanel DataContext="{Binding Rotation}">
                                    <Border Style="{StaticResource InfoBannerStyle}">
                                        <TextBlock Text="El empleado rotativo sigue un calendario de turnos (roster). Configure el esquema; se genera al guardar." Style="{StaticResource BannerTextStyle}"/>
                                    </Border>

                                    <StackPanel Style="{StaticResource FormFieldStyle}">
                                        <TextBlock Text="Esquema *" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding SchemeTypes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding SchemeType}" Style="{StaticResource FormComboBoxStyle}"/>
                                        <TextBlock Text="{Binding SchemeHint}" Style="{StaticResource FormHelperStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Style="{StaticResource FormFieldStyle}">
                                            <TextBlock Text="Inicia *" Style="{StaticResource FormLabelStyle}"/>
                                            <DatePicker SelectedDate="{Binding StartDate}" Style="{StaticResource FormDatePickerStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource FormFieldStyle}">
                                            <TextBlock Text="Termina" Style="{StaticResource FormLabelStyle}"/>
                                            <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource FormDatePickerStyle}"
                                                        IsEnabled="{Binding IsIndefinite, Converter={StaticResource InverseBooleanConverter}}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <mah:ToggleSwitch Grid.Column="0" IsOn="{Binding IsIndefinite}" Content="Sin fecha de término" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="2" Style="{StaticResource FormFieldStyle}"
                                                    Visibility="{Binding IsIndefinite, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Proyectar inicialmente" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding HorizonOptions}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding IndefiniteHorizonMonths}" Style="{StaticResource FormComboBoxStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Turnos que rotan (3x8 / 2x8) -->
                                    <Grid Visibility="{Binding UsesRotatingShifts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Style="{StaticResource FormFieldStyle}">
                                            <TextBlock Text="{Binding Shift1Label}" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding Shifts}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Shift1}" Style="{StaticResource FormComboBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource FormFieldStyle}">
                                            <TextBlock Text="{Binding Shift2Label}" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding Shifts}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Shift2}" Style="{StaticResource FormComboBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Style="{StaticResource FormFieldStyle}"
                                                    Visibility="{Binding UsesThirdShift, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Turno 3 (noche)" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding Shifts}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Shift3}" Style="{StaticResource FormComboBoxStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Visibility="{Binding UsesRotatingShifts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Style="{StaticResource FormFieldStyle}">
                                            <TextBlock Text="Días por turno antes de rotar" Style="{StaticResource FormLabelStyle}"/>
                                            <mah:NumericUpDown Value="{Binding DaysPerShift}" Minimum="1" Maximum="30" Interval="1" StringFormat="N0" MinHeight="38"
                                                               Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Border}"/>
                                            <TextBlock Text="Por ejemplo, 7 para rotar cada semana." Style="{StaticResource FormHelperStyle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource FormFieldStyle}">
                                            <TextBlock Text="Descanso" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding RestDayModes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding RestDayMode}" Style="{StaticResource FormComboBoxStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Style="{StaticResource FormFieldStyle}" HorizontalAlignment="Left" MinWidth="300"
                                                Visibility="{Binding ShowRestDaysAfterShift, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Días de descanso al rotar" Style="{StaticResource FormLabelStyle}"/>
                                        <mah:NumericUpDown Value="{Binding RestDaysAfterShift}" Minimum="0" Maximum="7" Interval="1" StringFormat="N0" MinHeight="38"
                                                           Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Border}"/>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding ShowFixedRestDays, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding FixedRestDaysLabel}" Style="{StaticResource FormLabelStyle}"/>
                                        <ItemsControl ItemsSource="{Binding FixedRestDays}" Focusable="False" Margin="0,0,0,8">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected}" Style="{StaticResource DayChipStyle}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Turno base (4x3 / 24x48) -->
                                    <StackPanel Style="{StaticResource FormFieldStyle}" Visibility="{Binding UsesBaseShift, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding BaseShiftLabel}" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding Shifts}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding BaseShift}" Style="{StaticResource FormComboBoxStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                                </StackPanel>

                                <CheckBox IsChecked="{Binding ApplyRotationScheme}" Style="{StaticResource FormCheckBoxStyle}" IsEnabled="{Binding CanEditSchedule}"
                                          Content="Generar o actualizar la proyección de turnos al guardar"
                                          Visibility="{Binding ShowRotationEditor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Tiempo extra ===== -->
                    <TabItem Header="Tiempo extra">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="920" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <Border Style="{StaticResource InfoBannerStyle}"
                                        Visibility="{Binding CanEditOvertime, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <TextBlock Text="Sólo RH o Administrador pueden configurar el tiempo extra." Style="{StaticResource BannerTextStyle}"/>
                                </Border>

                                <mah:ToggleSwitch IsOn="{Binding OvertimeAuthorized}" IsEnabled="{Binding CanEditOvertime}" Content="Autorizar tiempo extra" Margin="0,0,0,6"/>
                                <TextBlock Text="Sin autorización, el excedente del día se muestra en el reporte de asistencia para que RH lo autorice por día."
                                           Style="{StaticResource FormHelperStyle}" Margin="0,0,0,16"/>

                                <StackPanel IsEnabled="{Binding OvertimeOptionsEnabled}">
                                    <CheckBox IsChecked="{Binding CalculateOvertimeBeforeEntry}" Style="{StaticResource FormCheckBoxStyle}" Content="Contar tiempo extra antes de la hora de entrada"
                                              Visibility="{Binding AllowsOvertimeBeforeEntry, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Style="{StaticResource FormFieldStyle}">
                                            <TextBlock Text="Redondeo" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding OvertimeCalculationMethodOptions}" ItemTemplate="{StaticResource EnumItemTemplate}" SelectedItem="{Binding SelectedOvertimeCalculationMethod}" Style="{StaticResource FormComboBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource FormFieldStyle}">
                                            <TextBlock Text="Tope" Style="{StaticResource FormLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding OvertimeCapTypeOptions}" ItemTemplate="{StaticResource EnumItemTemplate}" SelectedItem="{Binding SelectedOvertimeCapType}" Style="{StaticResource FormComboBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Style="{StaticResource FormFieldStyle}" IsEnabled="{Binding HasOvertimeCap}">
                                            <TextBlock Text="Minutos del tope" Style="{StaticResource FormLabelStyle}"/>
                                            <mah:NumericUpDown Value="{Binding OvertimeCapMinutes}" Minimum="0" StringFormat="N0" Interval="30" MinHeight="38"
                                                               Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Border}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Reloj checador ===== -->
                    <TabItem Header="Reloj checador">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Style="{StaticResource TwoColumnGrid}" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="Número de tarjeta" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding CardNumber}" Style="{StaticResource FormTextBoxStyle}" mah:TextBoxHelper.Watermark="Vacío si no usa tarjeta"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Style="{StaticResource FormFieldStyle}">
                                    <TextBlock Text="Contraseña (PIN)" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding DevicePassword}" Style="{StaticResource FormTextBoxStyle}" mah:TextBoxHelper.Watermark="Máximo 8 dígitos" MaxLength="8"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Bitácora (sólo al editar) ===== -->
                    <TabItem Header="Bitácora" Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <UniformGrid Columns="2" Margin="-8,0,-8,16">
                                <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="8" Padding="14" Margin="8,0">
                                    <StackPanel>
                                        <TextBlock Text="Alta en el sistema" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Foreground="{StaticResource Brush.Text}"/>
                                        <TextBlock Text="{Binding CreatedBy, TargetNullValue='Sistema', StringFormat='Por {0}'}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="8" Padding="14" Margin="8,0">
                                    <StackPanel>
                                        <TextBlock Text="Última modificación" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}', TargetNullValue='Sin modificaciones'}" Foreground="{StaticResource Brush.Text}"/>
                                        <TextBlock Text="{Binding UpdatedBy, TargetNullValue='—', StringFormat='Por {0}'}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <DataGrid Grid.Row="1" Style="{StaticResource ModernDataGridStyle}" ItemsSource="{Binding AuditLogs}" RowHeight="40" MinHeight="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha / hora" Binding="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140"/>
                                    <DataGridTextColumn Header="Acción" Binding="{Binding Action}" Width="140"/>
                                    <DataGridTextColumn Header="Usuario" Binding="{Binding UserName}" Width="130"/>
                                    <DataGridTextColumn Header="Detalle" Binding="{Binding Details}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Vigencia del cambio: visible desde cualquier pestaña en cuanto hay un cambio que la necesita -->
            <Border Grid.Row="2" Style="{StaticResource WarningBannerStyle}" Margin="0,12,0,0" Padding="18,14"
                    Visibility="{Binding HasDatedChange, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial Kind="CalendarClock" Width="20" Height="20" Foreground="{StaticResource Brush.WarningText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding EffectiveFromTitle}" FontWeight="Bold" Foreground="{StaticResource Brush.WarningText}"/>
                        <TextBlock Text="Si la fecha es pasada, las jornadas desde esa fecha se recalculan solas." FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Width="170" Margin="0,0,12,0">
                        <TextBlock Text="{Binding EffectiveFromLabel}" Style="{StaticResource FormLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding EffectiveFrom}" Style="{StaticResource FormDatePickerStyle}" Background="{StaticResource Brush.Surface}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Width="170" Visibility="{Binding StartsLeave, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="Último día del período; al día siguiente regresa solo a Alta. Sin fecha: hasta que RH lo regrese a Alta.">
                        <TextBlock Text="Hasta (opcional)" Style="{StaticResource FormLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding LeaveTo}" Style="{StaticResource FormDatePickerStyle}" Background="{StaticResource Brush.Surface}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Acciones -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,24">
                <Button Command="{Binding CancelCommand}" Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" MinWidth="120" Margin="0,0,12,0"/>
                <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="180" ToolTip="Guardar (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Guardar empleado" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Cargando -->
        <Border Background="{StaticResource Brush.BusyOverlay}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <mah:ProgressRing IsActive="{Binding IsBusy}" Width="56" Height="56" Foreground="{StaticResource Brush.Primary}" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
