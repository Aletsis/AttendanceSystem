<UserControl x:Class="AttendanceSystem.WPF.Views.Employees.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource Brush.Background}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>
    
    <UserControl.Resources>
        <!-- Estatus: verde en alta, rojo en baja y ámbar en ausencias con período (vacaciones, incapacidad, baja temporal). -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource Brush.WarningSoft}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusValue}" Value="Alta">
                    <Setter Property="Background" Value="{StaticResource Brush.SuccessSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusValue}" Value="Baja">
                    <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.WarningText}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusValue}" Value="Alta">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusValue}" Value="Baja">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" 
                          BlurRadius="15" 
                          ShadowDepth="2" 
                          Opacity="0.1" 
                          Color="Black"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Circle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Gestión de Empleados" 
                               FontSize="26" 
                               FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}"
                               Margin="0,0,20,0"/>
                    
                    <!-- Segmented Mode Selector: Internos vs Externos -->
                    <Border Background="{StaticResource Brush.Border}" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Sucursales Internas"
                                    Command="{Binding SwitchToInternalCommand}"
                                    BorderThickness="0"
                                    Padding="14,6"
                                    FontWeight="SemiBold"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInternalMode}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            
                            <Button Content="Sucursales Externas"
                                    Command="{Binding SwitchToExternalCommand}"
                                    BorderThickness="0"
                                    Padding="14,6"
                                    FontWeight="SemiBold"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExternalMode}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Success}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Subtitle for Internal -->
                <TextBlock Text="Personal de sucursales internas con control de asistencia, turnos y retardos"
                           FontSize="13"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Visibility="{Binding IsInternalMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                
                <!-- Subtitle for External -->
                <TextBlock Text="Personal de sucursales externas (aislado de cálculos y turnos internos; permite IDs repetidos por sucursal)"
                           FontSize="13"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Visibility="{Binding IsExternalMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Actions Header for Internal Employees -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal"
                        Visibility="{Binding IsInternalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Command="{Binding DownloadTemplateCommand}" Visibility="{Binding CanImport, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource MahApps.Styles.Button.Square}"
                        Width="42"
                        Height="42"
                        Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="{StaticResource Brush.Border}"
                        ToolTip="Descargar Plantilla Excel"
                        Effect="{StaticResource CardShadow}">
                    <iconPacks:PackIconMaterial Kind="FileDownloadOutline" Width="20" Height="20" Foreground="{StaticResource Brush.Info}"/>
                </Button>
                
                <Button Command="{Binding ExportEmployeesCommand}" Visibility="{Binding CanExport, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource MahApps.Styles.Button.Square}"
                        Width="42"
                        Height="42"
                        Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="{StaticResource Brush.Border}"
                        ToolTip="Exportar a Excel"
                        Effect="{StaticResource CardShadow}">
                    <iconPacks:PackIconMaterial Kind="FileExcel" Width="20" Height="20" Foreground="{StaticResource Brush.Success}"/>
                </Button>

                <Button Command="{Binding ImportEmployeesCommand}" Visibility="{Binding CanImport, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource MahApps.Styles.Button.Square}"
                        Width="42"
                        Height="42"
                        Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="{StaticResource Brush.Border}"
                        ToolTip="Importar desde Excel"
                        Effect="{StaticResource CardShadow}">
                    <iconPacks:PackIconMaterial Kind="FileUpload" Width="20" Height="20" Foreground="{StaticResource Brush.Warning}"/>
                </Button>

                <Button Command="{Binding AddEmployeeCommand}" Visibility="{Binding CanCreate, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{StaticResource Brush.Primary}"
                        Foreground="White"
                        Height="45"
                        Padding="20,0"
                        BorderThickness="0"
                        Effect="{StaticResource CardShadow}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" 
                                                  Width="18" 
                                                  Height="18"
                                                  Margin="0,0,10,0"
                                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Nuevo Empleado" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Actions Header for External Employees -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal"
                        Visibility="{Binding IsExternalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Command="{Binding AddExternalEmployeeCommand}" Visibility="{Binding CanCreateExternal, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{StaticResource Brush.Success}"
                        Foreground="White"
                        Height="45"
                        Padding="20,0"
                        BorderThickness="0"
                        Effect="{StaticResource CardShadow}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" 
                                                  Width="18" 
                                                  Height="18"
                                                  Margin="0,0,10,0"
                                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Nuevo Empleado Externo" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Card -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="15" 
                Effect="{StaticResource CardShadow}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <TextBox Grid.Column="0"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            mah:TextBoxHelper.Watermark="Buscar por nombre, código o número de empleado..."
                            mah:TextBoxHelper.ClearTextButton="True"
                            FontSize="14"
                            Padding="12,10"
                            BorderThickness="1"
                            BorderBrush="{StaticResource Brush.Border}"
                            Background="{StaticResource Brush.SurfaceAlt}"
                            Margin="0,0,10,0"/>

                    <!-- Status Filter -->
                    <ComboBox Grid.Column="1"
                             ItemsSource="{Binding StatusOptions}"
                             SelectedItem="{Binding SelectedStatus}"
                             Width="180"
                             Margin="0,0,10,0"
                             Padding="12,10"
                             BorderThickness="1"
                             BorderBrush="{StaticResource Brush.Border}"/>

                    <!-- Refresh Button -->
                    <Button Grid.Column="2"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MahApps.Styles.Button.Square}"
                            Width="42"
                            Height="42"
                            Background="{StaticResource Brush.SurfaceAlt}"
                            BorderBrush="{StaticResource Brush.Border}">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="20" Height="20" Foreground="{StaticResource Brush.Primary}"/>
                    </Button>
                </Grid>

                <!-- 1. Internal Employee Table -->
                <DataGrid Style="{StaticResource ModernDataGridStyle}"
                          Grid.Row="1"
                          ItemsSource="{Binding Employees}"
                          SelectedItem="{Binding SelectedEmployee}"
                          Visibility="{Binding IsInternalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditEmployeeCommand}"
                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGrid.InputBindings>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No. Empleado" Binding="{Binding EmployeeNumber}" Width="120"/>
                        <DataGridTemplateColumn Header="Empleado" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5,0">
                                        <Border Width="32" Height="32" Background="{StaticResource Brush.PrimarySoft}" CornerRadius="16" Margin="0,0,10,0">
                                            <iconPacks:PackIconMaterial Kind="Account" Width="16" Height="16" Foreground="{StaticResource Brush.Primary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding FullName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Sucursal" Binding="{Binding BranchName}" Width="140"/>
                        <DataGridTextColumn Header="Departamento" Binding="{Binding DepartmentName}" Width="140"/>
                        <DataGridTextColumn Header="Puesto" Binding="{Binding PositionName}" Width="140"/>
                        <DataGridTemplateColumn Header="Estado" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadgeStyle}">
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusBadgeTextStyle}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="Acciones" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.SendToDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Visibility="{Binding DataContext.CanSendToDevice, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Sincronizar con Reloj Checador">
                                            <iconPacks:PackIconMaterial Kind="CloudSync" Width="14" Height="14" Foreground="{StaticResource Brush.Info}"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Editar">
                                            <iconPacks:PackIconMaterial Kind="Pencil" Width="14" Height="14" Foreground="{StaticResource Brush.Primary}"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Visibility="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Eliminar">
                                            <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14" Foreground="{StaticResource Brush.Danger}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 2. External Employee Table -->
                <DataGrid Style="{StaticResource ModernDataGridStyle}"
                          Grid.Row="1"
                          ItemsSource="{Binding ExternalEmployees}"
                          SelectedItem="{Binding SelectedExternalEmployee}"
                          Visibility="{Binding IsExternalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditExternalEmployeeCommand}"
                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGrid.InputBindings>
                    
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Sucursal Externa" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#EDE9FE" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" Margin="5,0">
                                        <TextBlock Text="{Binding BranchName}" Foreground="#7C3AED" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="No. Empleado" Binding="{Binding EmployeeNumber}" Width="120"/>
                        <DataGridTemplateColumn Header="Empleado" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5,0">
                                        <Border Width="32" Height="32" Background="#DCFCE7" CornerRadius="16" Margin="0,0,10,0">
                                            <iconPacks:PackIconMaterial Kind="AccountBadge" Width="16" Height="16" Foreground="#16A34A" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding FullName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Departamento" Binding="{Binding Department}" Width="140"/>
                        <DataGridTextColumn Header="Puesto" Binding="{Binding Position}" Width="140"/>
                        <DataGridTextColumn Header="No. Tarjeta" Binding="{Binding CardNumber}" Width="110"/>
                        <DataGridTemplateColumn Header="Estado" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadgeStyle}">
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusBadgeTextStyle}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="Acciones" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.EditExternalEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Visibility="{Binding DataContext.CanEditExternal, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Editar Empleado Externo">
                                            <iconPacks:PackIconMaterial Kind="Pencil" Width="14" Height="14" Foreground="{StaticResource Brush.Primary}"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteExternalEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Visibility="{Binding DataContext.CanDeleteExternal, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Eliminar Empleado Externo">
                                            <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14" Foreground="{StaticResource Brush.Danger}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="{StaticResource Brush.BusyOverlay}"
                CornerRadius="15"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="-30">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="{Binding IsBusy}" 
                                  Width="60" 
                                  Height="60"
                                  Foreground="{StaticResource Brush.Primary}"/>
                <TextBlock Text="{Binding BusyMessage}" 
                           Foreground="{StaticResource Brush.Text}" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
