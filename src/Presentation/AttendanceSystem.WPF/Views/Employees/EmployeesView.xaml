<UserControl x:Class="AttendanceSystem.WPF.Views.Employees.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#F5F7FA">
    
    <UserControl.Resources>
        <!-- Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" 
                          BlurRadius="15" 
                          ShadowDepth="2" 
                          Opacity="0.1" 
                          Color="Black"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Circle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#F8F9FC"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding BackToDashboardCommand}"
                    Style="{StaticResource MahApps.Styles.Button.Circle}"
                    Width="40"
                    Height="40"
                    Margin="0,0,15,0"
                    Background="White"
                    Effect="{StaticResource CardShadow}">
                <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="20" Height="20" Foreground="#4E73DF"/>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Gestión de Empleados" 
                               FontSize="26" 
                               FontWeight="Bold"
                               Foreground="#4E5D78"
                               Margin="0,0,20,0"/>
                    
                    <!-- Segmented Mode Selector: Internos vs Externos -->
                    <Border Background="#EAECF4" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Sucursales Internas"
                                    Command="{Binding SwitchToInternalCommand}"
                                    BorderThickness="0"
                                    Padding="14,6"
                                    FontWeight="SemiBold"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#5A5C69"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInternalMode}" Value="True">
                                                <Setter Property="Background" Value="#4E73DF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            
                            <Button Content="Sucursales Externas"
                                    Command="{Binding SwitchToExternalCommand}"
                                    BorderThickness="0"
                                    Padding="14,6"
                                    FontWeight="SemiBold"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#5A5C69"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExternalMode}" Value="True">
                                                <Setter Property="Background" Value="#1CC88A"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Subtitle for Internal -->
                <TextBlock Text="Personal de sucursales internas con control de asistencia, turnos y retardos"
                           FontSize="13"
                           Foreground="#858796"
                           Visibility="{Binding IsInternalMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                
                <!-- Subtitle for External -->
                <TextBlock Text="Personal de sucursales externas (aislado de cálculos y turnos internos; permite IDs repetidos por sucursal)"
                           FontSize="13"
                           Foreground="#858796"
                           Visibility="{Binding IsExternalMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Actions Header for Internal Employees -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal"
                        Visibility="{Binding IsInternalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Command="{Binding DownloadTemplateCommand}"
                        Style="{StaticResource MahApps.Styles.Button.Square}"
                        Width="42"
                        Height="42"
                        Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="#EAECF4"
                        ToolTip="Descargar Plantilla Excel"
                        Effect="{StaticResource CardShadow}">
                    <iconPacks:PackIconMaterial Kind="FileDownloadOutline" Width="20" Height="20" Foreground="#36B9CC"/>
                </Button>
                
                <Button Command="{Binding ExportEmployeesCommand}"
                        Style="{StaticResource MahApps.Styles.Button.Square}"
                        Width="42"
                        Height="42"
                        Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="#EAECF4"
                        ToolTip="Exportar a Excel"
                        Effect="{StaticResource CardShadow}">
                    <iconPacks:PackIconMaterial Kind="FileExcel" Width="20" Height="20" Foreground="#1CC88A"/>
                </Button>

                <Button Command="{Binding ImportEmployeesCommand}"
                        Style="{StaticResource MahApps.Styles.Button.Square}"
                        Width="42"
                        Height="42"
                        Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="#EAECF4"
                        ToolTip="Importar desde Excel"
                        Effect="{StaticResource CardShadow}">
                    <iconPacks:PackIconMaterial Kind="FileUpload" Width="20" Height="20" Foreground="#F6C23E"/>
                </Button>

                <Button Command="{Binding AddEmployeeCommand}"
                        Background="#4E73DF"
                        Foreground="White"
                        Height="45"
                        Padding="20,0"
                        BorderThickness="0"
                        Effect="{StaticResource CardShadow}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" 
                                                  Width="18" 
                                                  Height="18"
                                                  Margin="0,0,10,0"
                                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Nuevo Empleado" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Actions Header for External Employees -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal"
                        Visibility="{Binding IsExternalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Command="{Binding AddExternalEmployeeCommand}"
                        Background="#1CC88A"
                        Foreground="White"
                        Height="45"
                        Padding="20,0"
                        BorderThickness="0"
                        Effect="{StaticResource CardShadow}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" 
                                                  Width="18" 
                                                  Height="18"
                                                  Margin="0,0,10,0"
                                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Nuevo Empleado Externo" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Card -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="15" 
                Effect="{StaticResource CardShadow}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <TextBox Grid.Column="0"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            mah:TextBoxHelper.Watermark="Buscar por nombre, código o número de empleado..."
                            mah:TextBoxHelper.ClearTextButton="True"
                            FontSize="14"
                            Padding="12,10"
                            BorderThickness="1"
                            BorderBrush="#EAECF4"
                            Background="#F8F9FC"
                            Margin="0,0,10,0"/>

                    <!-- Status Filter -->
                    <ComboBox Grid.Column="1"
                             ItemsSource="{Binding StatusOptions}"
                             SelectedItem="{Binding SelectedStatus}"
                             Width="180"
                             Margin="0,0,10,0"
                             Padding="12,10"
                             BorderThickness="1"
                             BorderBrush="#EAECF4"/>

                    <!-- Refresh Button -->
                    <Button Grid.Column="2"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MahApps.Styles.Button.Square}"
                            Width="42"
                            Height="42"
                            Background="#F8F9FC"
                            BorderBrush="#EAECF4">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="20" Height="20" Foreground="#4E73DF"/>
                    </Button>
                </Grid>

                <!-- 1. Internal Employee Table -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Employees}"
                          SelectedItem="{Binding SelectedEmployee}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="50"
                          Visibility="{Binding IsInternalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
                            <Setter Property="Background" Value="#F8F9FC"/>
                            <Setter Property="Foreground" Value="#4E5D78"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,15"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#EAECF4"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F8F9FC"/>
                        </Style>
                    </DataGrid.RowStyle>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No. Empleado" Binding="{Binding EmployeeNumber}" Width="120"/>
                        <DataGridTemplateColumn Header="Empleado" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5,0">
                                        <Border Width="32" Height="32" Background="#EBF0F9" CornerRadius="16" Margin="0,0,10,0">
                                            <iconPacks:PackIconMaterial Kind="Account" Width="16" Height="16" Foreground="#4E73DF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding FullName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#5A5C69"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Sucursal" Binding="{Binding BranchName}" Width="140"/>
                        <DataGridTextColumn Header="Departamento" Binding="{Binding DepartmentName}" Width="140"/>
                        <DataGridTextColumn Header="Posición" Binding="{Binding PositionName}" Width="140"/>
                        <DataGridTemplateColumn Header="Estado" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E1F7EF" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Margin="5,0">
                                        <TextBlock Text="{Binding Status}" Foreground="#1CC88A" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="Acciones" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.SendToDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Sincronizar con Reloj Checador">
                                            <iconPacks:PackIconMaterial Kind="CloudSync" Width="14" Height="14" Foreground="#36B9CC"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Editar">
                                            <iconPacks:PackIconMaterial Kind="Pencil" Width="14" Height="14" Foreground="#4E73DF"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Eliminar">
                                            <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14" Foreground="#E74A3B"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 2. External Employee Table -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ExternalEmployees}"
                          SelectedItem="{Binding SelectedExternalEmployee}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="50"
                          Visibility="{Binding IsExternalMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
                            <Setter Property="Background" Value="#F8F9FC"/>
                            <Setter Property="Foreground" Value="#4E5D78"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,15"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#EAECF4"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F8F9FC"/>
                        </Style>
                    </DataGrid.RowStyle>
                    
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Sucursal Externa" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#EDE9FE" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" Margin="5,0">
                                        <TextBlock Text="{Binding BranchName}" Foreground="#7C3AED" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="No. Empleado" Binding="{Binding EmployeeNumber}" Width="120"/>
                        <DataGridTemplateColumn Header="Empleado" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5,0">
                                        <Border Width="32" Height="32" Background="#DCFCE7" CornerRadius="16" Margin="0,0,10,0">
                                            <iconPacks:PackIconMaterial Kind="AccountBadge" Width="16" Height="16" Foreground="#16A34A" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding FullName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#5A5C69"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Departamento" Binding="{Binding Department}" Width="140"/>
                        <DataGridTextColumn Header="Puesto" Binding="{Binding Position}" Width="140"/>
                        <DataGridTextColumn Header="No. Tarjeta" Binding="{Binding CardNumber}" Width="110"/>
                        <DataGridTemplateColumn Header="Estado" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E1F7EF" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Margin="5,0">
                                        <TextBlock Text="{Binding Status}" Foreground="#1CC88A" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="Acciones" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.EditExternalEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Editar Empleado Externo">
                                            <iconPacks:PackIconMaterial Kind="Pencil" Width="14" Height="14" Foreground="#4E73DF"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteExternalEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Eliminar Empleado Externo">
                                            <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14" Foreground="#E74A3B"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#B3000000"
                CornerRadius="15"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="-30">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="{Binding IsBusy}" 
                                  Width="60" 
                                  Height="60"
                                  Foreground="White"/>
                <TextBlock Text="{Binding BusyMessage}" 
                           Foreground="White" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
