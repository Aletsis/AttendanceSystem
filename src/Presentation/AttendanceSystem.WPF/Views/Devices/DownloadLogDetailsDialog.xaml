<UserControl x:Class="AttendanceSystem.WPF.Views.Devices.DownloadLogDetailsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Width="600">
    
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="SizeToContent" Value="Height"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Border Background="White" CornerRadius="15" BorderThickness="1" BorderBrush="#EAECF4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Color="Black"/>
        </Border.Effect>
        
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Detalles de Sincronización" FontSize="22" FontWeight="Bold" Foreground="#4E5D78"/>
                <TextBlock Text="{Binding DeviceName}" FontSize="14" Foreground="#858796" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" MaxHeight="600" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Summary Grid -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,5">
                            <TextBlock Text="Inicio" FontSize="11" Foreground="#858796" FontWeight="Bold"/>
                            <TextBlock Text="{Binding StartedAt, StringFormat='dd/MM/yyyy HH:mm:ss'}" FontSize="14" Foreground="#4E5D78"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,5">
                            <TextBlock Text="Fin" FontSize="11" Foreground="#858796" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CompletedAt, StringFormat='dd/MM/yyyy HH:mm:ss', TargetNullValue='En curso...'}" FontSize="14" Foreground="#4E5D78"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,5">
                            <TextBlock Text="Estado" FontSize="11" Foreground="#858796" FontWeight="Bold"/>
                            <Border Background="{Binding StatusColor}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Margin="0,3,0,0">
                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5">
                            <TextBlock Text="Iniciado por" FontSize="11" Foreground="#858796" FontWeight="Bold"/>
                            <TextBlock Text="{Binding InitiatedBy, TargetNullValue='Sistema'}" FontSize="14" Foreground="#4E5D78"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,5">
                            <TextBlock Text="Registros Totales" FontSize="11" Foreground="#858796" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalRecords}" FontSize="18" FontWeight="Bold" Foreground="#4E73DF"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,5">
                            <TextBlock Text="Nuevos Registros" FontSize="11" Foreground="#858796" FontWeight="Bold"/>
                            <TextBlock Text="{Binding NewRecords}" FontSize="18" FontWeight="Bold" Foreground="#1CC88A"/>
                        </StackPanel>
                    </Grid>

                    <!-- Error Alert -->
                    <Border Background="#FDEDEC" BorderBrush="#E74A3B" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AlertCircle" Foreground="#E74A3B" VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Error en la descarga" FontWeight="Bold" Foreground="#E74A3B"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#5A5C69" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Records List -->
                    <Expander Header="Ver registros importados" IsExpanded="{Binding ShowRecords}" Background="Transparent" BorderThickness="0" Margin="0,0,0,10">
                        <Grid MinHeight="200" Margin="0,10,0,0">
                            <DataGrid ItemsSource="{Binding ImportedRecords}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      MaxHeight="300"
                                      mah:ScrollViewerHelper.IsHorizontalScrollWheelEnabled="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Empleado" Binding="{Binding EmployeeName}" Width="*"/>
                                    <DataGridTextColumn Header="Hora" Binding="{Binding CheckTime, StringFormat='HH:mm:ss'}" Width="80"/>
                                    <DataGridTextColumn Header="Método" Binding="{Binding VerifyMethod}" Width="100"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding EntryType}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            
                            <mah:ProgressRing IsActive="{Binding IsLoadingRecords}" Width="40" Height="40" Visibility="{Binding IsLoadingRecords, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cerrar" 
                        Command="{Binding CancelCommand}"
                        Background="#4E73DF"
                        Foreground="White"
                        Padding="30,10"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
