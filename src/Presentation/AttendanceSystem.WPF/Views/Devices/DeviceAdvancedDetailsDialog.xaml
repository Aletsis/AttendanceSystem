<UserControl x:Class="AttendanceSystem.WPF.Views.Devices.DeviceAdvancedDetailsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Width="900" Height="700">
    
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <Border Background="White" CornerRadius="15" BorderThickness="1" BorderBrush="#EAECF4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Color="Black"/>
        </Border.Effect>
        
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Detalles del Dispositivo" FontSize="24" FontWeight="Bold" Foreground="#4E5D78"/>
                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#858796" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Background="{Binding StatusColor}" CornerRadius="12" Padding="12,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                </Border>
            </Grid>

            <!-- Content Tabs -->
            <mah:MetroAnimatedSingleRowTabControl Grid.Row="1">
                <!-- Info & Stats Tab -->
                <TabItem Header="Información General">
                    <ScrollViewer Margin="0,15,0,0">
                        <StackPanel>
                            <!-- Stats Row -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Background="#F8F9FC" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="AccountGroup" Foreground="#4E73DF" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding UserCount, TargetNullValue='-'}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Usuarios" FontSize="11" Foreground="#858796" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#F8F9FC" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="Fingerprint" Foreground="#1CC88A" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding FingerprintCount, TargetNullValue='-'}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Huellas" FontSize="11" Foreground="#858796" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#F8F9FC" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="History" Foreground="#36B9CC" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding AttendanceRecordCount, TargetNullValue='-'}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Registros" FontSize="11" Foreground="#858796" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Background="#F8F9FC" CornerRadius="8" Padding="15">
                                    <StackPanel HorizontalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="ShieldAccount" Foreground="#F6C23E" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding FaceCount, TargetNullValue='-'}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Rostros" FontSize="11" Foreground="#858796" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Margin="0,0,15,0">
                                    <Label Content="Identificación y Red" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <mah:ClipBorder Background="#F8F9FC" CornerRadius="8" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="Nombre" FontSize="11" Foreground="#858796"/>
                                            <TextBlock Text="{Binding Name}" FontSize="15" Margin="0,0,0,10"/>
                                            
                                            <TextBlock Text="IP / Host" FontSize="11" Foreground="#858796"/>
                                            <TextBlock Text="{Binding IpAddress}" FontSize="15" Margin="0,0,0,10"/>
                                            
                                            <TextBlock Text="Puerto" FontSize="11" Foreground="#858796"/>
                                            <TextBlock Text="{Binding Port}" FontSize="15" Margin="0,0,0,10"/>
                                            
                                            <TextBlock Text="Ubicación" FontSize="11" Foreground="#858796"/>
                                            <TextBlock Text="{Binding Location, TargetNullValue='Sin ubicación'}" FontSize="15"/>
                                        </StackPanel>
                                    </mah:ClipBorder>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <Label Content="Conexión y Hardware" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <mah:ClipBorder Background="#F8F9FC" CornerRadius="8" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="Marca" FontSize="11" Foreground="#858796"/>
                                            <TextBlock Text="{Binding Brand}" FontSize="15" Margin="0,0,0,10"/>
                                            
                                            <TextBlock Text="Método de Descarga" FontSize="11" Foreground="#858796"/>
                                            <TextBlock Text="{Binding DownloadMethod}" FontSize="15" Margin="0,0,0,10"/>
                                            
                                            <TextBlock Text="Número de Serie" FontSize="11" Foreground="#858796"/>
                                            <TextBlock Text="{Binding SerialNumber, TargetNullValue='No disponible'}" FontSize="15" Margin="0,0,0,10"/>
                                            
                                            <TextBlock Text="Firmware" FontSize="11" Foreground="#858796"/>
                                            <TextBlock Text="{Binding FirmwareVersion, TargetNullValue='No disponible'}" FontSize="15"/>
                                        </StackPanel>
                                    </mah:ClipBorder>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Users Tab -->
                <TabItem Header="Usuarios en Dispositivo">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Command="{Binding LoadUsersCommand}"
                                    Style="{StaticResource MahApps.Styles.Button.Flat}"
                                    Background="#4E73DF" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Consultar Usuarios del Dispositivo"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding DeviceUsers}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="80"/>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Privilegio" Binding="{Binding Privilege}" Width="100"/>
                                <DataGridTemplateColumn Header="Huellas" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Fingerprints.Count}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridCheckBoxColumn Header="Habilitado" Binding="{Binding Enabled}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <mah:ProgressRing Grid.Row="1" IsActive="{Binding IsLoadingUsers}"/>
                    </Grid>
                </TabItem>

                <!-- Remote Config Tab -->
                <TabItem Header="Configuración Remota">
                    <Grid Margin="0,15,0,0">
                        <StackPanel>
                            <Label Content="Acciones de Control" FontWeight="Bold" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <Button Command="{Binding SetTimeCommand}" Margin="0,0,10,10" Padding="15,10">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Clock" Width="16" Height="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="Sincronizar Hora"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Command="{Binding ResetToFactoryCommand}" Margin="0,0,10,10" Padding="15,10">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Factory" Width="16" Height="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="Reiniciar Fábrica"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ClearLogsCommand}" Margin="0,0,10,10" Padding="15,10">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="DeleteSweep" Width="16" Height="16" Margin="0,0,10,0"/>
                                        <TextBlock Text="Borrar Logs en Dispositivo"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <Border BorderThickness="0,1,0,0" BorderBrush="#EAECF4" Margin="0,10,0,20"/>
                            
                            <Label Content="Capacidades del Hardware" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <mah:ClipBorder Background="#F8F9FC" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Límite Usuarios" FontSize="11" Foreground="#858796"/>
                                        <TextBlock Text="{Binding UserCapacity, TargetNullValue='Desconocido'}" FontSize="15" Margin="0,0,0,10"/>
                                        
                                        <TextBlock Text="Límite Huellas" FontSize="11" Foreground="#858796"/>
                                        <TextBlock Text="{Binding FingerprintCapacity, TargetNullValue='Desconocido'}" FontSize="15" Margin="0,0,0,10"/>
                                    </StackPanel>
                                </mah:ClipBorder>
                                <mah:ClipBorder Grid.Column="1" Background="#F8F9FC" CornerRadius="8" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="Límite Rostros" FontSize="11" Foreground="#858796"/>
                                        <TextBlock Text="{Binding FaceCapacity, TargetNullValue='Desconocido'}" FontSize="15" Margin="0,0,0,10"/>
                                        
                                        <TextBlock Text="Límite Registros" FontSize="11" Foreground="#858796"/>
                                        <TextBlock Text="{Binding AttendanceRecordCapacity, TargetNullValue='Desconocido'}" FontSize="15"/>
                                    </StackPanel>
                                </mah:ClipBorder>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- History Tab -->
                <TabItem Header="Historial de Descargas">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <DatePicker SelectedDate="{Binding HistoryFromDate}" mah:TextBoxHelper.Watermark="Desde" Width="150" Margin="0,0,10,0"/>
                            <DatePicker SelectedDate="{Binding HistoryToDate}" mah:TextBoxHelper.Watermark="Hasta" Width="150" Margin="0,0,10,0"/>
                            <Button Content="Filtrar" Command="{Binding FilterHistoryCommand}" Style="{StaticResource MahApps.Styles.Button.Flat}"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding DownloadHistory}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  RowHeight="45">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding StartedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="130"/>
                                <DataGridTemplateColumn Header="Estado" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <iconPacks:PackIconMaterial Kind="{Binding IsSuccessful, Converter={StaticResource SuccessToIconConverter}}" 
                                                                      Foreground="{Binding IsSuccessful, Converter={StaticResource SuccessToBrushConverter}}"
                                                                      HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Registros" Binding="{Binding TotalRecordsDownloaded}" Width="80"/>
                                <DataGridTextColumn Header="Nuevos" Binding="{Binding NewRecordsAdded}" Width="80"/>
                                <DataGridTemplateColumn Header="Acciones" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ShowLogDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MahApps.Styles.Button.Circle}"
                                                    Width="30" Height="30">
                                                <iconPacks:PackIconMaterial Kind="InformationVariant" Width="14" Height="14"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <mah:ProgressRing Grid.Row="1" IsActive="{Binding IsLoadingHistory}"/>
                    </Grid>
                </TabItem>
            </mah:MetroAnimatedSingleRowTabControl>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cerrar" 
                        Command="{Binding CancelCommand}"
                        Background="#4E73DF"
                        Foreground="White"
                        Padding="30,10"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
