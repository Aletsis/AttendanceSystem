<UserControl x:Class="AttendanceSystem.WPF.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource Brush.Background}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4E73DF" Offset="0"/>
            <GradientStop Color="#224ABE" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1CC88A" Offset="0"/>
            <GradientStop Color="#13855C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F6C23E" Offset="0"/>
            <GradientStop Color="#DDA20A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E74A3B" Offset="0"/>
            <GradientStop Color="#BE2617" Offset="1"/>
        </LinearGradientBrush>

        <!-- Tarjeta de cifra del día. Tag = título; Content = valor. -->
        <Style x:Key="StatCardStyle" TargetType="ContentControl">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="24,20" Effect="{StaticResource Effect.CardShadow}">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
                                <ContentPresenter Margin="0,6,0,0" TextElement.FontSize="34" TextElement.FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Acceso rápido a una pantalla. -->
        <Style x:Key="QuickLinkStyle" TargetType="Button">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{StaticResource Brush.Surface}" CornerRadius="12" Padding="20,18"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                <Setter TargetName="Card" Property="Effect" Value="{StaticResource Effect.CardShadow}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <!-- Encabezado -->
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{Binding WelcomeMessage}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Brush.Text}"/>
                        <TextBlock Foreground="{StaticResource Brush.TextMuted}" FontSize="14" Margin="0,4,0,0">
                            <Run Text="{Binding TodayText, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding RoleName, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding RefreshCommand}"
                            Style="{StaticResource MahApps.Styles.Button.Square}" Width="42" Height="42"
                            Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" ToolTip="Actualizar (F5)">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="18" Height="18" Foreground="{StaticResource Brush.Primary}"/>
                    </Button>
                </Grid>

                <!-- Error al cargar las cifras -->
                <Border Background="{StaticResource Brush.DangerSoft}" CornerRadius="10" Padding="16,12" Margin="0,0,0,10"
                        Visibility="{Binding StatsError, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding StatsError}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap"/>
                </Border>

                <!-- Cifras del día -->
                <UniformGrid Columns="4" Margin="-10,0">
                    <ContentControl Style="{StaticResource StatCardStyle}" Background="{StaticResource PrimaryGradient}" Tag="Empleados activos" Content="{Binding ActiveEmployees}"/>
                    <ContentControl Style="{StaticResource StatCardStyle}" Background="{StaticResource SuccessGradient}" Tag="Presentes hoy" Content="{Binding PresentToday}"/>
                    <ContentControl Style="{StaticResource StatCardStyle}" Background="{StaticResource DangerGradient}" Tag="Faltas hoy" Content="{Binding AbsentToday}"/>
                    <ContentControl Style="{StaticResource StatCardStyle}" Background="{StaticResource WarningGradient}" Tag="Retardos hoy" Content="{Binding LateToday}"/>
                </UniformGrid>
                <TextBlock Text="Presentes, faltas y retardos son los de la asistencia ya calculada para hoy."
                           FontSize="12" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,30"/>

                <!-- Accesos -->
                <TextBlock Text="Accesos rápidos" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding QuickLinks}" Margin="-10,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource QuickLinkStyle}"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource Brush.PrimarySoft}" VerticalAlignment="Top">
                                        <iconPacks:PackIconMaterial Kind="{Binding Icon}" Width="22" Height="22" Foreground="{StaticResource Brush.Primary}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="180">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Background="{StaticResource Brush.BusyOverlay}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <mah:ProgressRing IsActive="{Binding IsBusy}" Width="50" Height="50" Foreground="{StaticResource Brush.Primary}"/>
                <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource Brush.Text}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
