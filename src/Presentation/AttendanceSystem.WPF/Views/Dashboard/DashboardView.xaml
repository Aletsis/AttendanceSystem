<UserControl x:Class="AttendanceSystem.WPF.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F5F7FA">
    
    <UserControl.Resources>
        <!-- Gradients for Stat Cards -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4E73DF" Offset="0"/>
            <GradientStop Color="#224ABE" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1CC88A" Offset="0"/>
            <GradientStop Color="#13855C" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F6C23E" Offset="0"/>
            <GradientStop Color="#DDA20A" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E74A3B" Offset="0"/>
            <GradientStop Color="#BE2617" Offset="1"/>
        </LinearGradientBrush>

        <!-- Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" 
                          BlurRadius="15" 
                          ShadowDepth="2" 
                          Opacity="0.1" 
                          Color="Black"/>

        <!-- Quick Action Card Style -->
        <Style x:Key="QuickActionCardStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border x:Name="iconContainer" 
                                            Width="60" 
                                            Height="60" 
                                            CornerRadius="30" 
                                            Background="#F8F9FC"
                                            Margin="0,0,0,10">
                                        <ContentPresenter Content="{TemplateBinding Content}" 
                                                         VerticalAlignment="Center" 
                                                         HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="text" 
                                               Text="{TemplateBinding Tag}" 
                                               FontSize="14" 
                                               FontWeight="SemiBold" 
                                               Foreground="#5A5C69"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8F9FC"/>
                                <Setter TargetName="iconContainer" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                <Setter TargetName="text" Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Panel de Control" 
                               FontSize="32" 
                               FontWeight="Bold" 
                               Foreground="#4E5D78"/>
                    <TextBlock Text="{Binding WelcomeMessage}" 
                               FontSize="16" 
                               Foreground="#858796" 
                               Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="White" 
                            CornerRadius="20" 
                            Padding="15,8" 
                            Effect="{StaticResource CardShadow}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CalendarClock" 
                                                      VerticalAlignment="Center" 
                                                      Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                      Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Source={x:Static System:DateTime.Now}, StringFormat='{}{0:dd MMMM, yyyy}'}" 
                                       xmlns:System="clr-namespace:System;assembly=mscorlib"
                                       VerticalAlignment="Center" 
                                       FontWeight="Medium" 
                                       Foreground="#5A5C69"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Statistics Section -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="-10,0,-10,40">
                <!-- Total Employees -->
                <Border Background="{StaticResource PrimaryGradient}" 
                        CornerRadius="16" 
                        Margin="10" 
                        Padding="25"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Total Empleados" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="White" 
                                       Opacity="0.8"/>
                            <TextBlock Text="{Binding TotalEmployees}" 
                                       FontSize="36" 
                                       FontWeight="Bold" 
                                       Foreground="White" 
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                        <iconPacks:PackIconMaterial Kind="AccountGroup" 
                                                  Width="48" 
                                                  Height="48" 
                                                  Foreground="White" 
                                                  HorizontalAlignment="Right" 
                                                  VerticalAlignment="Center" 
                                                  Opacity="0.3"/>
                    </Grid>
                </Border>

                <!-- Present Today -->
                <Border Background="{StaticResource SuccessGradient}" 
                        CornerRadius="16" 
                        Margin="10" 
                        Padding="25"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Presentes Hoy" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="White" 
                                       Opacity="0.8"/>
                            <TextBlock Text="{Binding PresentToday}" 
                                       FontSize="36" 
                                       FontWeight="Bold" 
                                       Foreground="White" 
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                        <iconPacks:PackIconMaterial Kind="AccountCheck" 
                                                  Width="48" 
                                                  Height="48" 
                                                  Foreground="White" 
                                                  HorizontalAlignment="Right" 
                                                  VerticalAlignment="Center" 
                                                  Opacity="0.3"/>
                    </Grid>
                </Border>

                <!-- Absent Today -->
                <Border Background="{StaticResource DangerGradient}" 
                        CornerRadius="16" 
                        Margin="10" 
                        Padding="25"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Ausentes Hoy" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="White" 
                                       Opacity="0.8"/>
                            <TextBlock Text="{Binding AbsentToday}" 
                                       FontSize="36" 
                                       FontWeight="Bold" 
                                       Foreground="White" 
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                        <iconPacks:PackIconMaterial Kind="AccountRemove" 
                                                  Width="48" 
                                                  Height="48" 
                                                  Foreground="White" 
                                                  HorizontalAlignment="Right" 
                                                  VerticalAlignment="Center" 
                                                  Opacity="0.3"/>
                    </Grid>
                </Border>

                <!-- Late Today -->
                <Border Background="{StaticResource WarningGradient}" 
                        CornerRadius="16" 
                        Margin="10" 
                        Padding="25"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Retardos Hoy" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="White" 
                                       Opacity="0.8"/>
                            <TextBlock Text="{Binding LateToday}" 
                                       FontSize="36" 
                                       FontWeight="Bold" 
                                       Foreground="White" 
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                        <iconPacks:PackIconMaterial Kind="AccountClock" 
                                                  Width="48" 
                                                  Height="48" 
                                                  Foreground="White" 
                                                  HorizontalAlignment="Right" 
                                                  VerticalAlignment="Center" 
                                                  Opacity="0.3"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Quick Actions Section -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Accesos Rápidos" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="#4E5D78" 
                           Margin="0,0,0,20"/>
                
                <UniformGrid Columns="4" Margin="-10">
                    <Button Command="{Binding NavigateToEmployeesCommand}" Style="{StaticResource QuickActionCardStyle}" Tag="Empleados">
                        <iconPacks:PackIconMaterial Kind="AccountMultiple" Width="30" Height="30"/>
                    </Button>

                    <Button Command="{Binding NavigateToAttendanceCommand}" Style="{StaticResource QuickActionCardStyle}" Tag="Asistencia">
                        <iconPacks:PackIconMaterial Kind="CalendarCheck" Width="30" Height="30"/>
                    </Button>

                    <Button Command="{Binding NavigateToDepartmentsCommand}" Style="{StaticResource QuickActionCardStyle}" Tag="Departamentos">
                        <iconPacks:PackIconMaterial Kind="Domain" Width="30" Height="30"/>
                    </Button>

                    <Button Command="{Binding NavigateToPositionsCommand}" Style="{StaticResource QuickActionCardStyle}" Tag="Posiciones">
                        <iconPacks:PackIconMaterial Kind="AccountBadge" Width="30" Height="30"/>
                    </Button>

                    <Button Command="{Binding NavigateToBranchesCommand}" Style="{StaticResource QuickActionCardStyle}" Tag="Sucursales">
                        <iconPacks:PackIconMaterial Kind="OfficeBuilding" Width="30" Height="30"/>
                    </Button>

                    <Button Command="{Binding NavigateToShiftsCommand}" Style="{StaticResource QuickActionCardStyle}" Tag="Turnos">
                        <iconPacks:PackIconMaterial Kind="ClockFast" Width="30" Height="30"/>
                    </Button>

                    <Button Command="{Binding NavigateToDevicesCommand}" Style="{StaticResource QuickActionCardStyle}" Tag="Dispositivos">
                        <iconPacks:PackIconMaterial Kind="Devices" Width="30" Height="30"/>
                    </Button>

                    <Button Command="{Binding NavigateToReportsCommand}" Style="{StaticResource QuickActionCardStyle}" Tag="Reportes">
                        <iconPacks:PackIconMaterial Kind="ChartBar" Width="30" Height="30"/>
                    </Button>

                    <Button Command="{Binding NavigateToSettingsCommand}" Style="{StaticResource QuickActionCardStyle}" Tag="Configuración">
                        <iconPacks:PackIconMaterial Kind="Cog" Width="30" Height="30"/>
                    </Button>

                    <Button Command="{Binding NavigateToBackupCommand}" Style="{StaticResource QuickActionCardStyle}" Tag="Respaldo">
                        <iconPacks:PackIconMaterial Kind="Database" Width="30" Height="30"/>
                    </Button>

                    <Button Command="{Binding LogoutCommand}" Style="{StaticResource QuickActionCardStyle}" Tag="Salir" Foreground="#E74A3B">
                        <iconPacks:PackIconMaterial Kind="Power" Width="30" Height="30"/>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
