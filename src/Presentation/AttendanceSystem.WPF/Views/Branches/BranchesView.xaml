<UserControl x:Class="AttendanceSystem.WPF.Views.Branches.BranchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#F5F7FA">
    
    <UserControl.Resources>
        <!-- Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" 
                          BlurRadius="15" 
                          ShadowDepth="2" 
                          Opacity="0.1" 
                          Color="Black"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Circle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#F8F9FC"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding BackToDashboardCommand}"
                    Style="{StaticResource MahApps.Styles.Button.Circle}"
                    Width="40"
                    Height="40"
                    Margin="0,0,15,0"
                    Background="White"
                    Effect="{StaticResource CardShadow}">
                <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="20" Height="20" Foreground="#4E73DF"/>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Gestión de Sucursales" 
                           FontSize="28" 
                           FontWeight="Bold"
                           Foreground="#4E5D78"/>
                <TextBlock Text="Administre las ubicaciones físicas y sucursales de su empresa"
                           FontSize="14"
                           Foreground="#858796"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Command="{Binding DownloadTemplateCommand}"
                        Style="{StaticResource MahApps.Styles.Button.Square}"
                        Width="42"
                        Height="42"
                        Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="#EAECF4"
                        ToolTip="Descargar Plantilla Excel"
                        Effect="{StaticResource CardShadow}">
                    <iconPacks:PackIconMaterial Kind="FileDownloadOutline" Width="20" Height="20" Foreground="#36B9CC"/>
                </Button>
                
                <Button Command="{Binding ExportBranchesCommand}"
                        Style="{StaticResource MahApps.Styles.Button.Square}"
                        Width="42"
                        Height="42"
                        Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="#EAECF4"
                        ToolTip="Exportar a Excel"
                        Effect="{StaticResource CardShadow}">
                    <iconPacks:PackIconMaterial Kind="FileExcel" Width="20" Height="20" Foreground="#1CC88A"/>
                </Button>

                <Button Command="{Binding ImportBranchesCommand}"
                        Style="{StaticResource MahApps.Styles.Button.Square}"
                        Width="42"
                        Height="42"
                        Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="#EAECF4"
                        ToolTip="Importar desde Excel"
                        Effect="{StaticResource CardShadow}">
                    <iconPacks:PackIconMaterial Kind="FileUpload" Width="20" Height="20" Foreground="#F6C23E"/>
                </Button>

                <Button Command="{Binding AddBranchCommand}"
                        Background="#4E73DF"
                        Foreground="White"
                        Height="45"
                        Padding="20,0"
                        BorderThickness="0"
                        Effect="{StaticResource CardShadow}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" 
                                                  Width="18" 
                                                  Height="18"
                                                  Margin="0,0,10,0"
                                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Nueva Sucursal" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Card -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="15" 
                Effect="{StaticResource CardShadow}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search and Refresh -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            mah:TextBoxHelper.Watermark="Buscar por nombre o código de sucursal..."
                            mah:TextBoxHelper.ClearTextButton="True"
                            FontSize="14"
                            Padding="12,10"
                            BorderThickness="1"
                            BorderBrush="#EAECF4"
                            Background="#F8F9FC"
                            Margin="0,0,10,0"/>

                    <Button Grid.Column="1"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MahApps.Styles.Button.Square}"
                            Width="42"
                            Height="42"
                            Background="#F8F9FC"
                            BorderBrush="#EAECF4">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="20" Height="20" Foreground="#4E73DF"/>
                    </Button>
                </Grid>

                <!-- Branch Table -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Branches}"
                          SelectedItem="{Binding SelectedBranch}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="50">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
                            <Setter Property="Background" Value="#F8F9FC"/>
                            <Setter Property="Foreground" Value="#4E5D78"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,15"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#EAECF4"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F8F9FC"/>
                        </Style>
                    </DataGrid.RowStyle>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100"/>
                        
                        <DataGridTemplateColumn Header="Sucursal" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5,0">
                                        <Border Width="32" Height="32" Background="#EBF0F9" CornerRadius="16" Margin="0,0,10,0">
                                            <iconPacks:PackIconMaterial Kind="OfficeBuilding" Width="16" Height="16" Foreground="#4E73DF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#5A5C69"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="Dirección" Binding="{Binding Address}" Width="2*"/>

                        <DataGridTemplateColumn Header="Empleados" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0">
                                        <iconPacks:PackIconMaterial Kind="AccountGroup" Width="14" Height="14" Foreground="#858796" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding EmployeeCount}" VerticalAlignment="Center" Foreground="#5A5C69"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="Tipo" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsExternal, Converter={StaticResource BooleanToStatusBrushConverter}, ConverterParameter='External'}" 
                                            CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Margin="5,0">
                                        <TextBlock Text="{Binding IsExternal, Converter={StaticResource BooleanToStatusTextConverter}, ConverterParameter='External'}" 
                                                   Foreground="{Binding IsExternal, Converter={StaticResource BooleanToStatusBrushConverter}, ConverterParameter='ExternalText'}" 
                                                   FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="Acciones" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.EditBranchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Editar">
                                            <iconPacks:PackIconMaterial Kind="Pencil" Width="14" Height="14" Foreground="#4E73DF"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteBranchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Eliminar">
                                            <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14" Foreground="#E74A3B"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#B3000000"
                CornerRadius="15"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="-30">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="{Binding IsBusy}" 
                                  Width="60" 
                                  Height="60"
                                  Foreground="White"/>
                <TextBlock Text="{Binding BusyMessage}" 
                           Foreground="White" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
