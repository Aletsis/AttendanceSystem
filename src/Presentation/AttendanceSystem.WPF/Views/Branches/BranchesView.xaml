<UserControl x:Class="AttendanceSystem.WPF.Views.Branches.BranchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource Brush.Background}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>
    
    <UserControl.Resources>
        <!-- Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" 
                          BlurRadius="15" 
                          ShadowDepth="2" 
                          Opacity="0.1" 
                          Color="Black"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Circle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Gestión de Sucursales" 
                           FontSize="28" 
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="Administre las ubicaciones físicas y sucursales de su empresa"
                           FontSize="14"
                           Foreground="{StaticResource Brush.TextMuted}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Command="{Binding DownloadTemplateCommand}" Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource MahApps.Styles.Button.Square}"
                        Width="42"
                        Height="42"
                        Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="{StaticResource Brush.Border}"
                        ToolTip="Descargar Plantilla Excel"
                        Effect="{StaticResource CardShadow}">
                    <iconPacks:PackIconMaterial Kind="FileDownloadOutline" Width="20" Height="20" Foreground="{StaticResource Brush.Info}"/>
                </Button>
                
                <Button Command="{Binding ExportBranchesCommand}"
                        Style="{StaticResource MahApps.Styles.Button.Square}"
                        Width="42"
                        Height="42"
                        Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="{StaticResource Brush.Border}"
                        ToolTip="Exportar a Excel"
                        Effect="{StaticResource CardShadow}">
                    <iconPacks:PackIconMaterial Kind="FileExcel" Width="20" Height="20" Foreground="{StaticResource Brush.Success}"/>
                </Button>

                <Button Command="{Binding ImportBranchesCommand}" Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource MahApps.Styles.Button.Square}"
                        Width="42"
                        Height="42"
                        Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="{StaticResource Brush.Border}"
                        ToolTip="Importar desde Excel"
                        Effect="{StaticResource CardShadow}">
                    <iconPacks:PackIconMaterial Kind="FileUpload" Width="20" Height="20" Foreground="{StaticResource Brush.Warning}"/>
                </Button>

                <Button Command="{Binding AddBranchCommand}" Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{StaticResource Brush.Primary}"
                        Foreground="White"
                        Height="45"
                        Padding="20,0"
                        BorderThickness="0"
                        Effect="{StaticResource CardShadow}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" 
                                                  Width="18" 
                                                  Height="18"
                                                  Margin="0,0,10,0"
                                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Nueva Sucursal" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Card -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="15" 
                Effect="{StaticResource CardShadow}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search and Refresh -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            mah:TextBoxHelper.Watermark="Buscar por nombre o código de sucursal..."
                            mah:TextBoxHelper.ClearTextButton="True"
                            FontSize="14"
                            Padding="12,10"
                            BorderThickness="1"
                            BorderBrush="{StaticResource Brush.Border}"
                            Background="{StaticResource Brush.SurfaceAlt}"
                            Margin="0,0,10,0"/>

                    <Button Grid.Column="1"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MahApps.Styles.Button.Square}"
                            Width="42"
                            Height="42"
                            Background="{StaticResource Brush.SurfaceAlt}"
                            BorderBrush="{StaticResource Brush.Border}">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="20" Height="20" Foreground="{StaticResource Brush.Primary}"/>
                    </Button>
                </Grid>

                <!-- Branch Table -->
                <DataGrid Style="{StaticResource ModernDataGridStyle}"
                          Grid.Row="1"
                          ItemsSource="{Binding Branches}"
                          SelectedItem="{Binding SelectedBranch}">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditBranchCommand}"
                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGrid.InputBindings>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="100"/>
                        
                        <DataGridTemplateColumn Header="Sucursal" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5,0">
                                        <Border Width="32" Height="32" Background="{StaticResource Brush.PrimarySoft}" CornerRadius="16" Margin="0,0,10,0">
                                            <iconPacks:PackIconMaterial Kind="OfficeBuilding" Width="16" Height="16" Foreground="{StaticResource Brush.Primary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="Dirección" Binding="{Binding Address}" Width="2*"/>

                        <DataGridTemplateColumn Header="Empleados" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0">
                                        <iconPacks:PackIconMaterial Kind="AccountGroup" Width="14" Height="14" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding EmployeeCount}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="Tipo" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Margin="5,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Brush.PrimarySoft}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExternal}" Value="True">
                                                        <Setter Property="Background" Value="#EDE9FE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Interna"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExternal}" Value="True">
                                                            <Setter Property="Text" Value="Externa"/>
                                                            <Setter Property="Foreground" Value="#7C3AED"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTemplateColumn Header="Acciones" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.EditBranchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Editar">
                                            <iconPacks:PackIconMaterial Kind="Pencil" Width="14" Height="14" Foreground="{StaticResource Brush.Primary}"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteBranchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Eliminar">
                                            <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14" Foreground="{StaticResource Brush.Danger}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="{StaticResource Brush.BusyOverlay}"
                CornerRadius="15"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="-30">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="{Binding IsBusy}" 
                                  Width="60" 
                                  Height="60"
                                  Foreground="{StaticResource Brush.Primary}"/>
                <TextBlock Text="{Binding BusyMessage}" 
                           Foreground="{StaticResource Brush.Text}" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
