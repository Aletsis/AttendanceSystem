<UserControl x:Class="AttendanceSystem.WPF.Views.Auth.ChangePasswordDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             Width="420">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="SizeToContent" Value="Height"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <!-- Esc cancela por el comando (IsCancel cerraría la ventana por fuera del servicio de diálogos de Prism). -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </UserControl.InputBindings>

    <Border Background="{StaticResource Brush.Surface}" CornerRadius="15" BorderThickness="1" BorderBrush="{StaticResource Brush.Border}"
            Effect="{StaticResource Effect.CardShadow}">
        <StackPanel Margin="25" FocusManager.FocusedElement="{Binding ElementName=CurrentBox}">
            <TextBlock Text="Cambiar mi contraseña" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Text}"/>
            <TextBlock Text="Al cambiarla se cierran sus demás sesiones abiertas en la versión web."
                       FontSize="13" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,5,0,20"/>

            <TextBlock Text="Contraseña actual" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="CurrentBox" Padding="10,8" Margin="0,0,0,15" PasswordChanged="OnPasswordChanged"/>

            <TextBlock Text="Nueva contraseña" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="NewBox" Padding="10,8" PasswordChanged="OnPasswordChanged"/>
            <TextBlock Text="Mínimo 6 caracteres, con mayúscula, minúscula y número." FontSize="11"
                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,15"/>

            <TextBlock Text="Confirmar nueva contraseña" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="ConfirmBox" Padding="10,8" PasswordChanged="OnPasswordChanged"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Command="{Binding CancelCommand}"
                        Style="{StaticResource MahApps.Styles.Button.Flat}" Margin="0,0,10,0" Padding="20,10"/>
                <Button Content="Cambiar contraseña" Command="{Binding SaveCommand}" IsDefault="True"
                        Style="{StaticResource MahApps.Styles.Button.Square.Accent}" Padding="20,10"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
