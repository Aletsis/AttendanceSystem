<UserControl x:Class="AttendanceSystem.WPF.Views.Attendance.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource Brush.Background}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Tarjeta de cifra del resumen. -->
        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Opción de los menús de la fila. -->
        <Style x:Key="RowActionItemStyle" TargetType="MenuItem" BasedOn="{StaticResource MahApps.Styles.MenuItem}">
            <Setter Property="Header" Value="{Binding Header}"/>
            <Setter Property="Command" Value="{Binding Command}"/>
        </Style>

        <Style x:Key="TextCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado y acciones -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Asistencia" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Brush.Text}"/>
                    <TextBlock Text="Asistencia calculada por día: horario, marcajes, retardos y tiempo extra." FontSize="14" Foreground="{StaticResource Brush.TextMuted}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" ToolTip="Exporta a Excel lo que se está viendo">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileExcel" Width="16" Height="16" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Exportar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ManualEntryCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                            Visibility="{Binding CanManualPunch, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ClipboardEdit" Width="16" Height="16" Foreground="{StaticResource Brush.Primary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Registro manual" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CalculateAttendanceCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{Binding CanCalculate, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Recalcula el rango de fechas seleccionado">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Calculator" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Calcular asistencia" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Filtros -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Desde" Style="{StaticResource FormLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Style="{StaticResource FormDatePickerStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hasta" Style="{StaticResource FormLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource FormDatePickerStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Sucursal" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name" Style="{StaticResource FormComboBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Mostrar" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Filters}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding SelectedFilter}" Style="{StaticResource FormComboBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="8">
                        <TextBlock Text="Empleado" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"
                                 mah:TextBoxHelper.Watermark="Buscar por número o nombre..." mah:TextBoxHelper.ClearTextButton="True"/>
                    </StackPanel>
                    <Button Grid.Column="9" Command="{Binding RefreshCommand}" Style="{StaticResource MahApps.Styles.Button.Square}" Width="38" Height="38"
                            Margin="12,0,0,0" VerticalAlignment="Bottom" Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Border}" ToolTip="Actualizar (F5)">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="18" Height="18" Foreground="{StaticResource Brush.Primary}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Resumen y avisos -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <Border Style="{StaticResource InfoBannerStyle}" Visibility="{Binding ClosedPeriodsText, Converter={StaticResource NullToCollapsedConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Lock" Width="14" Height="14" Foreground="{StaticResource Brush.Primary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ClosedPeriodsText}" Style="{StaticResource BannerTextStyle}"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Días" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"/>
                            <TextBlock Text="{Binding DaysCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Text}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Faltas" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"/>
                            <TextBlock Text="{Binding AbsencesCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Danger}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Retardos" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"/>
                            <TextBlock Text="{Binding LatesCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.WarningText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Tiempo extra" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"/>
                            <TextBlock Text="{Binding OvertimeTotal}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Primary}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCardStyle}" ToolTip="Salidas temporales sin clasificar o tiempo extra sin autorizar">
                        <StackPanel>
                            <TextBlock Text="Pendientes de RH" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"/>
                            <TextBlock Text="{Binding PendingCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.WarningText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Tabla -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="8" Margin="0">
                <DataGrid Style="{StaticResource ModernDataGridStyle}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                          RowHeight="NaN" MinRowHeight="48" VirtualizingPanel.ScrollUnit="Pixel">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No." Binding="{Binding EmployeeId}" Width="70" ElementStyle="{StaticResource TextCellStyle}"/>
                        <DataGridTextColumn Header="Empleado" Binding="{Binding EmployeeName}" Width="1.4*" MinWidth="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCellStyle}">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat='ddd dd/MM/yy'}" Width="100" ElementStyle="{StaticResource TextCellStyle}"/>
                        <DataGridTemplateColumn Header="Horario" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,4">
                                        <TextBlock Text="{Binding ShiftName}" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Scheduled}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Entrada" Binding="{Binding CheckIn}" Width="85" ElementStyle="{StaticResource TextCellStyle}"/>
                        <DataGridTextColumn Header="Salida" Binding="{Binding CheckOut}" Width="85" ElementStyle="{StaticResource TextCellStyle}"/>
                        <DataGridTextColumn Header="Trabajado" Binding="{Binding Worked}" Width="90" ElementStyle="{StaticResource TextCellStyle}"/>
                        <DataGridTextColumn Header="Retardo" Binding="{Binding Late}" Width="75" ElementStyle="{StaticResource TextCellStyle}"/>

                        <!-- Tiempo extra y, si el empleado no tiene extras autorizadas, la autorización del día -->
                        <DataGridTemplateColumn Header="Tiempo extra" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,4">
                                        <TextBlock Text="{Binding Overtime}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                                        <TextBlock Text="{Binding OvertimeStatus}" FontSize="11" Foreground="{StaticResource Brush.WarningText}"
                                                   Visibility="{Binding OvertimeStatus, Converter={StaticResource NullToCollapsedConverter}}"/>
                                        <mah:DropDownButton Content="Autorizar..." ItemsSource="{Binding OvertimeActions}" ItemContainerStyle="{StaticResource RowActionItemStyle}"
                                                            FontSize="11" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                            Visibility="{Binding HasOvertimeActions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Estado" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Badges}" VerticalAlignment="Center" Margin="0,4" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="8,2" Margin="0,2,4,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="danger"><Setter Property="Background" Value="{StaticResource Brush.DangerSoft}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="warning"><Setter Property="Background" Value="{StaticResource Brush.WarningSoft}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="info"><Setter Property="Background" Value="{StaticResource Brush.PrimarySoft}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="success"><Setter Property="Background" Value="{StaticResource Brush.SuccessSoft}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Text}" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="danger"><Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="warning"><Setter Property="Foreground" Value="{StaticResource Brush.WarningText}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="info"><Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="success"><Setter Property="Foreground" Value="{StaticResource Brush.Success}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Notas y salidas temporales (caso 11: cada salida se clasifica por separado) -->
                        <DataGridTemplateColumn Header="Notas y salidas" Width="2*" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,4">
                                        <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ExitSummary}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap"
                                                   Visibility="{Binding ExitSummary, Converter={StaticResource NullToCollapsedConverter}}"/>
                                        <ItemsControl ItemsSource="{Binding ExitMenus}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,6,0">
                                                        <iconPacks:PackIconMaterial Kind="AlertCircle" Width="14" Height="14" Foreground="{StaticResource Brush.Warning}"
                                                                                    VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Pendiente de clasificar"
                                                                                    Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <mah:DropDownButton Content="{Binding Label}" ItemsSource="{Binding Actions}" ItemContainerStyle="{StaticResource RowActionItemStyle}"
                                                                            FontSize="11" Padding="6,2"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Cargando -->
        <Border Background="{StaticResource Brush.BusyOverlay}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="{Binding IsBusy}" Width="56" Height="56" Foreground="{StaticResource Brush.Primary}"/>
                <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource Brush.Text}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
