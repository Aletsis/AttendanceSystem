<UserControl x:Class="AttendanceSystem.WPF.Views.Attendance.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#F5F7FA">
    
    <UserControl.Resources>
        <!-- Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" 
                          BlurRadius="15" 
                          ShadowDepth="2" 
                          Opacity="0.1" 
                          Color="Black"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Circle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#F8F9FC"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding BackToDashboardCommand}"
                    Style="{StaticResource MahApps.Styles.Button.Circle}"
                    Width="40"
                    Height="40"
                    Margin="0,0,15,0"
                    Background="White"
                    Effect="{StaticResource CardShadow}">
                <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="20" Height="20" Foreground="#4E73DF"/>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Registros de Asistencia" 
                           FontSize="28" 
                           FontWeight="Bold"
                           Foreground="#4E5D78"/>
                <TextBlock Text="Historial detallado y gestión de entradas y salidas del personal"
                           FontSize="14"
                           Foreground="#858796"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Command="{Binding ManualEntryCommand}"
                        Background="White"
                        Foreground="#4E5D78"
                        Height="45"
                        Padding="15,0"
                        Margin="0,0,10,0"
                        BorderBrush="#EAECF4"
                        Effect="{StaticResource CardShadow}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ClipboardEdit" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#4E73DF"/>
                        <TextBlock Text="Registro Manual" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding CalculateAttendanceCommand}"
                        Background="#4E73DF"
                        Foreground="White"
                        Height="45"
                        Padding="15,0"
                        BorderThickness="0"
                        Effect="{StaticResource CardShadow}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Calculator" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Calcular Asistencia" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Card -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="15" 
                Effect="{StaticResource CardShadow}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,15,0">
                        <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#858796"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Width="150" mah:TextBoxHelper.Watermark="Fecha Inicio"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,15,0">
                        <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#858796"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="150" mah:TextBoxHelper.Watermark="Fecha Fin"/>
                    </StackPanel>

                    <TextBox Grid.Column="2"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            mah:TextBoxHelper.Watermark="Buscar por nombre de empleado..."
                            mah:TextBoxHelper.ClearTextButton="True"
                            FontSize="14"
                            Padding="12,10"
                            BorderThickness="1"
                            BorderBrush="#EAECF4"
                            Background="#F8F9FC"
                            Margin="0,0,10,0"/>

                    <Button Grid.Column="3"
                            Command="{Binding ExportCommand}"
                            Style="{StaticResource MahApps.Styles.Button.Square}"
                            Width="42"
                            Height="42"
                            Background="#F8F9FC"
                            BorderBrush="#EAECF4"
                            Margin="0,0,10,0"
                            ToolTip="Exportar a Excel">
                        <iconPacks:PackIconMaterial Kind="FileExcel" Width="20" Height="20" Foreground="#1CC88A"/>
                    </Button>

                    <Button Grid.Column="4"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MahApps.Styles.Button.Square}"
                            Width="42"
                            Height="42"
                            Background="#F8F9FC"
                            BorderBrush="#EAECF4">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="20" Height="20" Foreground="#4E73DF"/>
                    </Button>
                </Grid>

                <!-- Attendance Table -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding AttendanceLogs}"
                          SelectedItem="{Binding SelectedLog}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="50">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
                            <Setter Property="Background" Value="#F8F9FC"/>
                            <Setter Property="Foreground" Value="#4E5D78"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,15"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#EAECF4"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F8F9FC"/>
                        </Style>
                    </DataGrid.RowStyle>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No. Emp" Binding="{Binding EmployeeNumber}" Width="100"/>
                        
                        <DataGridTemplateColumn Header="Empleado" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5,0">
                                        <Border Width="28" Height="28" Background="#EBF0F9" CornerRadius="14" Margin="0,0,10,0">
                                            <iconPacks:PackIconMaterial Kind="Account" Width="14" Height="14" Foreground="#4E73DF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding EmployeeName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#5A5C69"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat='dd/MM/yyyy'}" Width="110"/>
                        <DataGridTextColumn Header="Entrada" Binding="{Binding EntryTime}" Width="100"/>
                        <DataGridTextColumn Header="Salida" Binding="{Binding ExitTime}" Width="100"/>
                        <DataGridTextColumn Header="Horas" Binding="{Binding WorkedHours}" Width="90"/>
                        
                        <DataGridTemplateColumn Header="Estado" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Margin="5,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F8F9FC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Presente">
                                                        <Setter Property="Background" Value="#E1F7EF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Ausente">
                                                        <Setter Property="Background" Value="#FADBD8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Retraso">
                                                        <Setter Property="Background" Value="#FEF9E7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#858796"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Presente">
                                                            <Setter Property="Foreground" Value="#1CC88A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ausente">
                                                            <Setter Property="Foreground" Value="#E74A3B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Retraso">
                                                            <Setter Property="Foreground" Value="#F6C23E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Notas" Binding="{Binding Notes}" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#B3000000"
                CornerRadius="15"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="-30">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="{Binding IsBusy}" 
                                  Width="60" 
                                  Height="60"
                                  Foreground="White"/>
                <TextBlock Text="{Binding BusyMessage}" 
                           Foreground="White" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
