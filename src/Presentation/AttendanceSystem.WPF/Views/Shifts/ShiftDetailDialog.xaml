<UserControl x:Class="AttendanceSystem.WPF.Views.Shifts.ShiftDetailDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             Width="500">
    
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="SizeToContent" Value="Height"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="DayConfigTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DayName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4E5D78"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.DayShiftTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedValue="{Binding ShiftType}"
                          SelectedValuePath="Key"
                          DisplayMemberPath="Value"
                          Margin="5,0"/>
                <mah:TimePicker Grid.Column="2" SelectedDateTime="{Binding StartDateTime}" 
                                mah:TextBoxHelper.Watermark="Entrada" Margin="5,0"
                                Culture="es-MX" IsClockVisible="False"/>
                <mah:TimePicker Grid.Column="3" SelectedDateTime="{Binding EndDateTime}" 
                                mah:TextBoxHelper.Watermark="Salida" Margin="5,0"
                                Culture="es-MX" IsClockVisible="False"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="15" BorderThickness="1" BorderBrush="#EAECF4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Color="Black"/>
        </Border.Effect>
        
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="#4E5D78"/>
                <TextBlock Text="Defina el tipo de jornada y las reglas de asistencia" FontSize="13" Foreground="#858796" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" MaxHeight="500" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Margin="0,0,10,15">
                            <TextBlock Text="Nombre del Turno" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                     mah:TextBoxHelper.Watermark="Ej: Matutino Oficina"
                                     Padding="10,8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,0,15">
                            <TextBlock Text="Tolerancia" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                            <mah:NumericUpDown Value="{Binding ToleranceMinutes}" Minimum="0" Margin="0" Padding="5"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Tipo de Turno" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding ShiftTypes}" 
                                  SelectedItem="{Binding SelectedShiftType}"
                                  DisplayMemberPath="Value"
                                  SelectedValuePath="Key"
                                  Padding="10,8"/>
                    </StackPanel>

                    <!-- Conditional Fields based on Shift Type -->
                    
                    <!-- Standard Shift (Matutino, Vespertino, Nocturno) -->
                    <StackPanel Visibility="{Binding IsStandardShift, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,5,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Hora de Entrada" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                                <mah:TimePicker SelectedDateTime="{Binding StartDateTime}" 
                                                mah:TextBoxHelper.Watermark="9:00 AM"
                                                Culture="es-MX" IsClockVisible="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Hora de Salida" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                                <mah:TimePicker SelectedDateTime="{Binding EndDateTime}" 
                                                mah:TextBoxHelper.Watermark="6:00 PM"
                                                Culture="es-MX" IsClockVisible="False"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Continuous Shift -->
                    <StackPanel Visibility="{Binding IsContinuousShift, Converter={StaticResource BoolToVis}}" Margin="0,0,0,15">
                        <TextBlock Text="Horas de Jornada Objetivo" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                        <mah:NumericUpDown Value="{Binding TargetHours}" Minimum="1" Maximum="24" Interval="1" Margin="0,0,0,5" />
                        <TextBlock Text="Horas mínimas que el empleado debe cumplir para evitar falta." 
                                   FontSize="11" Foreground="#858796" Margin="0,0,0,15" FontStyle="Italic"/>
                        
                        <CheckBox Content="Habilitar Redondeos" IsChecked="{Binding RoundingsEnabled}" Foreground="#4E5D78" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        
                        <StackPanel Visibility="{Binding RoundingsEnabled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Intervalo de Redondeo" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                            <ComboBox SelectedValue="{Binding RoundingInterval}" SelectedValuePath="Tag" Height="30" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="15 minutos">
                                    <ComboBoxItem.Tag>
                                        <sys:Int32>15</sys:Int32>
                                    </ComboBoxItem.Tag>
                                </ComboBoxItem>
                                <ComboBoxItem Content="30 minutos">
                                    <ComboBoxItem.Tag>
                                        <sys:Int32>30</sys:Int32>
                                    </ComboBoxItem.Tag>
                                </ComboBoxItem>
                                <ComboBoxItem Content="1 hora (60 minutos)">
                                    <ComboBoxItem.Tag>
                                        <sys:Int32>60</sys:Int32>
                                    </ComboBoxItem.Tag>
                                </ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Mixto Shift -->
                    <StackPanel Visibility="{Binding IsMixedShift, Converter={StaticResource BoolToVis}}" Margin="0,0,0,15">
                        <TextBlock Text="Configuración por Día" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,8"/>
                        <Border BorderThickness="1" BorderBrush="#EAECF4" CornerRadius="8" Padding="10">
                            <ItemsControl ItemsSource="{Binding Days}" ItemTemplate="{StaticResource DayConfigTemplate}"/>
                        </Border>
                    </StackPanel>

                    <!-- Flexible Shift -->
                    <StackPanel Visibility="{Binding IsFlexibleShift, Converter={StaticResource BoolToVis}}" Margin="0,0,0,15">
                        <Grid Margin="0,5,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Inicio Ventana Llegada" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                                <mah:TimePicker SelectedDateTime="{Binding StartDateTime}" 
                                                mah:TextBoxHelper.Watermark="8:00 AM"
                                                Culture="es-MX" IsClockVisible="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Fin Ventana Llegada" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                                <mah:TimePicker SelectedDateTime="{Binding FlexWindowEndDateTime}" 
                                                mah:TextBoxHelper.Watermark="9:30 AM"
                                                Culture="es-MX" IsClockVisible="False"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Esquema de Horas Objetivo" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Content="Por Día (Horas Diarias)" IsChecked="{Binding IsDailyFlexibleMode}" GroupName="FlexTargetGroup" Margin="0,0,20,0" Foreground="#4E5D78"/>
                            <RadioButton Content="Por Semana (Bolsa de Horas)" IsChecked="{Binding IsWeeklyFlexibleMode}" GroupName="FlexTargetGroup" Foreground="#4E5D78"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsDailyFlexibleMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,15">
                            <TextBlock Text="Horas Diarias Objetivo" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                            <mah:NumericUpDown Value="{Binding TargetHours}" Minimum="1" Maximum="24" Interval="1"/>
                            <TextBlock Text="Horas requeridas por cada día laborable." FontSize="11" Foreground="#858796" Margin="0,2,0,0" FontStyle="Italic"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsWeeklyFlexibleMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,15">
                            <TextBlock Text="Horas Semanales Objetivo (Bolsa)" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                            <mah:NumericUpDown Value="{Binding WeeklyHours}" Minimum="1" Maximum="168" Interval="1"/>
                            <TextBlock Text="Meta acumulada de horas a cumplir durante la semana." FontSize="11" Foreground="#858796" Margin="0,2,0,0" FontStyle="Italic"/>
                        </StackPanel>
                        
                        <CheckBox Content="Habilitar Redondeos en Entrada" IsChecked="{Binding RoundingsEnabled}" Foreground="#4E5D78" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        
                        <StackPanel Visibility="{Binding RoundingsEnabled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Intervalo de Redondeo" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                            <ComboBox SelectedValue="{Binding RoundingInterval}" SelectedValuePath="Tag" Height="30" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="15 minutos">
                                    <ComboBoxItem.Tag>
                                        <sys:Int32>15</sys:Int32>
                                    </ComboBoxItem.Tag>
                                </ComboBoxItem>
                                <ComboBoxItem Content="30 minutos">
                                    <ComboBoxItem.Tag>
                                        <sys:Int32>30</sys:Int32>
                                    </ComboBoxItem.Tag>
                                </ComboBoxItem>
                                <ComboBoxItem Content="1 hora (60 minutos)">
                                    <ComboBoxItem.Tag>
                                        <sys:Int32>60</sys:Int32>
                                    </ComboBoxItem.Tag>
                                </ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Partido / Doble Turno Shift -->
                    <StackPanel Visibility="{Binding IsSplitShift, Converter={StaticResource BoolToVis}}" Margin="0,0,0,15">
                        <TextBlock Text="Primer Bloque" FontWeight="Bold" Foreground="#4E5D78" Margin="0,5,0,8"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Entrada Bloque 1" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                                <mah:TimePicker SelectedDateTime="{Binding StartDateTime}" 
                                                mah:TextBoxHelper.Watermark="9:00 AM"
                                                Culture="es-MX" IsClockVisible="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Salida Bloque 1" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                                <mah:TimePicker SelectedDateTime="{Binding EndDateTime}" 
                                                mah:TextBoxHelper.Watermark="2:00 PM"
                                                Culture="es-MX" IsClockVisible="False"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Segundo Bloque" FontWeight="Bold" Foreground="#4E5D78" Margin="0,10,0,8"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Entrada Bloque 2" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                                <mah:TimePicker SelectedDateTime="{Binding SecondBlockStartDateTime}" 
                                                mah:TextBoxHelper.Watermark="4:00 PM"
                                                Culture="es-MX" IsClockVisible="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Salida Bloque 2" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                                <mah:TimePicker SelectedDateTime="{Binding SecondBlockEndDateTime}" 
                                                mah:TextBoxHelper.Watermark="8:00 PM"
                                                Culture="es-MX" IsClockVisible="False"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Tolerancia Bloque 2 (min)" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,5"/>
                            <mah:NumericUpDown Value="{Binding SecondBlockToleranceMinutes}" Minimum="0" Maximum="60" Interval="1"/>
                            <TextBlock Text="Tolerancia independiente para la entrada del segundo bloque." FontSize="11" Foreground="#858796" Margin="0,2,0,0" FontStyle="Italic"/>
                        </StackPanel>

                        <TextBlock Text="* Horario partido con 4 marcajes obligatorios. Admite salida de segundo bloque al día siguiente." FontSize="11" Foreground="#858796" Margin="0,0,0,10" FontStyle="Italic"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" 
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MahApps.Styles.Button.Flat}"
                        Margin="0,0,10,0"
                        Padding="20,10"/>
                
                <Button Content="Guardar" 
                        Command="{Binding SaveCommand}"
                        Background="#4E73DF"
                        Foreground="White"
                        Padding="30,10"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
