<UserControl x:Class="AttendanceSystem.WPF.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#F5F7FA">
    
    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="2" Opacity="0.1" Color="Black"/>
        
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4E5D78"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4E5D78"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding BackToDashboardCommand}"
                    Style="{StaticResource MahApps.Styles.Button.Circle}"
                    Width="40" Height="40" Margin="0,0,15,0"
                    Background="White" Effect="{StaticResource CardShadow}">
                <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="20" Height="20" Foreground="#4E73DF"/>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Configuración del Sistema" FontSize="28" FontWeight="Bold" Foreground="#4E5D78"/>
                <TextBlock Text="Personalice los parámetros globales y técnicos de la aplicación" FontSize="14" Foreground="#858796"/>
            </StackPanel>

            <!-- Top Right Save Button -->
            <Button Grid.Column="2"
                    Command="{Binding SaveSettingsCommand}" 
                    Background="#1CC88A" Foreground="White" Height="45" Padding="25,0" BorderThickness="0" Effect="{StaticResource CardShadow}">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ContentSave" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Guardar" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Center">
                
                <!-- Identidad Corporativa -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Identidad Corporativa" Style="{StaticResource SettingTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nombre de la Empresa" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding CompanyName}" Padding="12,10" BorderBrush="#EAECF4" Background="#F8F9FC"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Logo de la Empresa" Style="{StaticResource LabelStyle}"/>
                                <Grid Height="100">
                                    <Border BorderThickness="1" BorderBrush="#EAECF4" CornerRadius="8" Background="#F8F9FC">
                                        <Grid>
                                            <Image Source="{Binding CompanyLogo, Converter={StaticResource ByteArrayToImageConverter}}" Stretch="Uniform" Margin="10"/>
                                            <TextBlock Text="Sin Logo" Foreground="#858796" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding CompanyLogo, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5">
                                        <Button Command="{Binding UploadLogoCommand}" ToolTip="Subir Logo" Style="{StaticResource MahApps.Styles.Button.Circle}" Width="30" Height="30" Background="White" BorderBrush="#EAECF4">
                                            <iconPacks:PackIconMaterial Kind="CloudUpload" Width="14" Height="14" Foreground="#4E73DF"/>
                                        </Button>
                                        <Button Command="{Binding RemoveLogoCommand}" ToolTip="Eliminar Logo" Style="{StaticResource MahApps.Styles.Button.Circle}" Width="30" Height="30" Background="White" BorderBrush="#EAECF4" Margin="5,0,0,0">
                                            <iconPacks:PackIconMaterial Kind="Delete" Width="14" Height="14" Foreground="#E74A3B"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- General & ADMS -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Parámetros Generales y ADMS" Style="{StaticResource SettingTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="20"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tolerancia Retardo (Minutos)" Style="{StaticResource LabelStyle}"/>
                                <mah:NumericUpDown Value="{Binding ToleranceMinutes}" Minimum="0" Maximum="60" Padding="12,10" BorderBrush="#EAECF4" Background="#F8F9FC"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Jornada Laboral Estándar (Horas)" Style="{StaticResource LabelStyle}"/>
                                <mah:NumericUpDown Value="{Binding StandardWorkHours}" Minimum="1" Maximum="24" Padding="12,10" BorderBrush="#EAECF4" Background="#F8F9FC"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Puerto ADMS" Style="{StaticResource LabelStyle}"/>
                                <mah:NumericUpDown Value="{Binding AdmsPort}" Minimum="1024" Maximum="65535" Padding="12,10" BorderBrush="#EAECF4" Background="#F8F9FC"/>
                            </StackPanel>

                            <Border Grid.Row="2" Grid.Column="2" Background="#E1F5FE" CornerRadius="8" Padding="10">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Information" Foreground="#0288D1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cambiar el puerto ADMS requiere reiniciar la aplicación." FontSize="11" Foreground="#01579B" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Periodos Laborales -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Periodos Laborales" Style="{StaticResource SettingTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Modo de Periodo" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding WorkPeriodModes}" SelectedItem="{Binding WorkPeriodMode}" Padding="12,10" BorderBrush="#EAECF4" Background="#F8F9FC"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <!-- Semanal -->
                                <StackPanel Visibility="{Binding WorkPeriodMode, Converter={StaticResource WorkPeriodModeToVisibilityConverter}, ConverterParameter=Weekly}">
                                    <TextBlock Text="Día de Inicio" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding DaysOfWeek}" SelectedItem="{Binding WeeklyStartDay}" Padding="12,10" BorderBrush="#EAECF4" Background="#F8F9FC"/>
                                </StackPanel>
                                
                                <!-- Quincenal -->
                                <Grid Visibility="{Binding WorkPeriodMode, Converter={StaticResource WorkPeriodModeToVisibilityConverter}, ConverterParameter=Fortnightly}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Inicio 1º (Día)" Style="{StaticResource LabelStyle}"/>
                                        <mah:NumericUpDown Value="{Binding FortnightFirstDay}" Minimum="1" Maximum="28" Padding="12,10" BorderBrush="#EAECF4" Background="#F8F9FC"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Inicio 2º (Día)" Style="{StaticResource LabelStyle}"/>
                                        <mah:NumericUpDown Value="{Binding FortnightSecondDay}" Minimum="1" Maximum="28" Padding="12,10" BorderBrush="#EAECF4" Background="#F8F9FC"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Mensual -->
                                <StackPanel Visibility="{Binding WorkPeriodMode, Converter={StaticResource WorkPeriodModeToVisibilityConverter}, ConverterParameter=Monthly}">
                                    <TextBlock Text="Día de Inicio Mes" Style="{StaticResource LabelStyle}"/>
                                    <mah:NumericUpDown Value="{Binding MonthlyStartDay}" Minimum="1" Maximum="28" Padding="12,10" BorderBrush="#EAECF4" Background="#F8F9FC"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Automatización y Respaldos -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Automatización y Respaldos" Style="{StaticResource SettingTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="20"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0">
                                <mah:ToggleSwitch Header="Descarga Automática Diaria" IsOn="{Binding IsAutoDownloadEnabled}" OnContent="Activado" OffContent="Desactivado"/>
                                <StackPanel IsEnabled="{Binding IsAutoDownloadEnabled}" Margin="0,10,0,0">
                                    <TextBlock Text="Hora de Ejecución" Style="{StaticResource LabelStyle}"/>
                                    <mah:TimePicker SelectedDateTime="{Binding AutoDownloadDateTime}" Padding="12,10" BorderBrush="#EAECF4" Background="#F8F9FC"
                                                   xmlns:System="clr-namespace:System;assembly=System.Runtime"/>
                                    <CheckBox Content="Solo procesar día actual" IsChecked="{Binding AutoDownloadOnlyToday}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <mah:ToggleSwitch Header="Limpieza de Dispositivos" IsOn="{Binding AutoClearDevicesAfterDownload}" OnContent="Limpiar tras descarga" OffContent="No limpiar"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Directorio de Respaldos" Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding BackupDirectory}" Padding="12,10" BorderBrush="#EAECF4" Background="#F8F9FC"/>
                                    <Button Grid.Column="1" Command="{Binding SelectBackupFolderCommand}" Style="{StaticResource MahApps.Styles.Button.Flat}" BorderBrush="#EAECF4" BorderThickness="0,1,1,1" Background="#F8F9FC" Padding="10,0">
                                        <iconPacks:PackIconMaterial Kind="FolderOpen" Width="16" Height="16" Foreground="#4E73DF"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Timeout Respaldo (Min)" Style="{StaticResource LabelStyle}"/>
                                <mah:NumericUpDown Value="{Binding BackupTimeoutMinutes}" Minimum="1" Maximum="60" Padding="12,10" BorderBrush="#EAECF4" Background="#F8F9FC"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Rectangle Height="50" Fill="Transparent"/>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#B3000000" CornerRadius="15" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="-30">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="{Binding IsBusy}" Width="60" Height="60" Foreground="White"/>
                <TextBlock Text="{Binding BusyMessage}" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
