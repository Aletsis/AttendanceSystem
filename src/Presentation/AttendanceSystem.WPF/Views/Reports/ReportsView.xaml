<UserControl x:Class="AttendanceSystem.WPF.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#F5F7FA">
    
    <UserControl.Resources>
        <!-- Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" 
                          BlurRadius="15" 
                          ShadowDepth="2" 
                          Opacity="0.1" 
                          Color="Black"/>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding BackToDashboardCommand}"
                    Style="{StaticResource MahApps.Styles.Button.Circle}"
                    Width="40"
                    Height="40"
                    Margin="0,0,15,0"
                    Background="White"
                    Effect="{StaticResource CardShadow}">
                <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="20" Height="20" Foreground="#4E73DF"/>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Generación de Reportes" 
                           FontSize="28" 
                           FontWeight="Bold"
                           Foreground="#4E5D78"/>
                <TextBlock Text="Analice el rendimiento y puntualidad de su equipo"
                           FontSize="14"
                           Foreground="#858796"/>
            </StackPanel>
        </Grid>

        <!-- Form Card -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" 
                    CornerRadius="15" 
                    Effect="{StaticResource CardShadow}"
                    Padding="30"
                    MaxWidth="1100"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Report Selection -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,25">
                        <TextBlock Text="Tipo de Reporte" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding ReportTypes}" 
                                  SelectedItem="{Binding SelectedReportType}" 
                                  Padding="12,10"
                                  BorderThickness="1"
                                  BorderBrush="#EAECF4"/>
                    </StackPanel>

                    <!-- Date Range -->
                    <Grid Grid.Row="1" Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fecha Inicio" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,10"/>
                            <DatePicker SelectedDate="{Binding StartDate}" 
                                       Padding="12,10"
                                       mah:TextBoxHelper.Watermark="Seleccione fecha inicio"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fecha Fin" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,10"/>
                            <DatePicker SelectedDate="{Binding EndDate}" 
                                       Padding="12,10"
                                       mah:TextBoxHelper.Watermark="Seleccione fecha fin"/>
                        </StackPanel>
                    </Grid>

                    <!-- Filters -->
                    <Grid Grid.Row="2" Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Empleado" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding Employees}" 
                                      SelectedItem="{Binding SelectedEmployee}" 
                                      Padding="12,10"
                                      BorderThickness="1"
                                      BorderBrush="#EAECF4"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Departamento" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding Departments}" 
                                      SelectedItem="{Binding SelectedDepartment}" 
                                      Padding="12,10"
                                      BorderThickness="1"
                                      BorderBrush="#EAECF4"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Sucursal" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding Branches}" 
                                      SelectedItem="{Binding SelectedBranch}" 
                                      Padding="12,10"
                                      BorderThickness="1"
                                      BorderBrush="#EAECF4"/>
                        </StackPanel>
                    </Grid>

                    <!-- Export Format -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,40" Width="300" HorizontalAlignment="Left">
                        <TextBlock Text="Formato de Exportación" FontWeight="SemiBold" Foreground="#4E5D78" Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding ExportFormats}" 
                                  SelectedItem="{Binding SelectedFormat}" 
                                  Padding="12,10"
                                  BorderThickness="1"
                                  BorderBrush="#EAECF4"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding PreviewReportCommand}" 
                                Background="White"
                                Foreground="#4E5D78"
                                Height="50"
                                Padding="25,0"
                                Margin="0,0,15,0"
                                BorderBrush="#EAECF4">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Eye" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#4E73DF"/>
                                <TextBlock Text="Vista Previa" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding GenerateReportCommand}" 
                                Background="#4E73DF"
                                Foreground="White"
                                Height="50"
                                Padding="25,0"
                                BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FileChart" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Generar Reporte" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#B3000000"
                CornerRadius="15"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="-30">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <mah:ProgressRing IsActive="{Binding IsBusy}" 
                                  Width="60" 
                                  Height="60"
                                  Foreground="White"/>
                <TextBlock Text="{Binding BusyMessage}" 
                           Foreground="White" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
