<UserControl x:Class="AttendanceSystem.WPF.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource Brush.Background}">

    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="Reportes" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="Los mismos reportes de la versión web, a partir de la asistencia calculada."
                           FontSize="14" Foreground="{StaticResource Brush.TextMuted}"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tipo de reporte -->
                <Border Grid.Column="0" Background="{StaticResource Brush.Surface}" CornerRadius="15" Effect="{StaticResource Effect.CardShadow}" Padding="10">
                    <ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,10">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Opciones -->
                <Border Grid.Column="2" Background="{StaticResource Brush.Surface}" CornerRadius="15" Effect="{StaticResource Effect.CardShadow}" Padding="30">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SelectedReport.Title}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Primary}"/>
                            <TextBlock Text="{Binding SelectedReport.Description}" FontSize="13" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,4,0,25"/>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Desde" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding StartDate}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Hasta" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding EndDate}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sucursal" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Visibility="{Binding ShowDepartment, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Departamento" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}" DisplayMemberPath="Name"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Empleado" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" DisplayMemberPath="Name"
                                      IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" Margin="0,0,0,18"/>

                            <TextBlock Text="Formato" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" Margin="0,0,0,18" HorizontalAlignment="Left" MinWidth="220"/>

                            <CheckBox IsChecked="{Binding Detailed}" Content="Detallado (día por día)" Margin="0,0,0,10"
                                      Visibility="{Binding ShowDetailed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <CheckBox IsChecked="{Binding IncludeOvertime}" Content="Incluir horas extra en las tarjetas" Margin="0,0,0,10"
                                      Visibility="{Binding ShowIncludeOvertime, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Button Command="{Binding GenerateReportCommand}" HorizontalAlignment="Left" Margin="0,15,0,0" Height="45" Padding="24,0"
                                    Background="{StaticResource Brush.Primary}" Foreground="White" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FileDownloadOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Generar y guardar" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Border Background="{StaticResource Brush.BusyOverlay}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <mah:ProgressRing IsActive="{Binding IsBusy}" Width="50" Height="50" Foreground="{StaticResource Brush.Primary}"/>
                <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource Brush.Text}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
