<UserControl x:Class="AttendanceSystem.WPF.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource Brush.Background}">

    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Reportes" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Brush.Text}"/>
                <TextBlock Text="Los mismos reportes de la versión web, a partir de la asistencia calculada."
                           FontSize="14" Foreground="{StaticResource Brush.TextMuted}"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tipo de reporte -->
                <Border Grid.Column="0" Background="{StaticResource Brush.Surface}" CornerRadius="15" Effect="{StaticResource Effect.CardShadow}" Padding="10">
                    <ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,10">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Opciones -->
                    <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" CornerRadius="15" Effect="{StaticResource Effect.CardShadow}" Padding="24,20">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedReport.Title}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Primary}"/>
                            <TextBlock Text="{Binding SelectedReport.Description}" FontSize="13" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,4,0,18"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" Style="{StaticResource FieldStyle}">
                                    <TextBlock Text="Desde" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding StartDate}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Style="{StaticResource FieldStyle}">
                                    <TextBlock Text="Hasta" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding EndDate}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Style="{StaticResource FieldStyle}">
                                    <TextBlock Text="Sucursal" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6" Style="{StaticResource FieldStyle}"
                                            Visibility="{Binding ShowDepartment, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Departamento" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}" DisplayMemberPath="Name"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource FieldStyle}">
                                    <TextBlock Text="Empleado" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" DisplayMemberPath="Name"
                                              IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="4" Style="{StaticResource FieldStyle}">
                                    <TextBlock Text="Formato" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="6" VerticalAlignment="Bottom" Style="{StaticResource FieldStyle}">
                                    <CheckBox IsChecked="{Binding Detailed}" Content="Detallado (día por día)" Margin="0,0,0,8"
                                              Visibility="{Binding ShowDetailed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <CheckBox IsChecked="{Binding IncludeOvertime}" Content="Incluir horas extra" Margin="0,0,0,8"
                                              Visibility="{Binding ShowCardOptions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Observaciones de las tarjetas (igual que en la versión web) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14"
                                        Visibility="{Binding ShowCardOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Observaciones:" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ItemsControl ItemsSource="{Binding ObservationOptions}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" Margin="0,0,18,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="TableEye" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                    Foreground="{StaticResource Brush.Primary}"/>
                                        <TextBlock Text="Vista previa" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding GenerateReportCommand}" Style="{StaticResource PrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FileDownloadOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Generar y guardar" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Vista previa -->
                    <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" CornerRadius="15" Effect="{StaticResource Effect.CardShadow}" Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Vista previa" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PreviewSummary}" FontSize="13" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" Style="{StaticResource ModernDataGridStyle}" ItemsSource="{Binding Preview}"
                                      AutoGenerateColumns="True" AutoGeneratingColumn="OnPreviewColumnGenerating"
                                      RowHeight="NaN" MinRowHeight="34" CanUserSortColumns="True"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                      Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasPreview, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <iconPacks:PackIconMaterial Kind="TableSearch" Width="40" Height="40" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}"/>
                                <TextBlock Text="Pulse «Vista previa» para ver lo que llevará el reporte antes de guardarlo."
                                           Foreground="{StaticResource Brush.TextMuted}" FontSize="13" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Background="{StaticResource Brush.BusyOverlay}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <mah:ProgressRing IsActive="{Binding IsBusy}" Width="50" Height="50" Foreground="{StaticResource Brush.Primary}"/>
                <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource Brush.Text}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
