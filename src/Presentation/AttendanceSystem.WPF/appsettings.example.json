{
  "ConnectionStrings": {
    "AttendanceDb": "Host=SERVIDOR;Port=5432;Database=AttendanceSystem;Username=attendancesystem_user;Password=YOUR_PASSWORD;"
  },
  "BackendUrl": "http://SERVIDOR:18372",
  "ApiKey": "LA_MISMA_API_KEY_DEL_SITIO_WEB",
  "Maintenance": {
    "PollIntervalSeconds": 5
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/wpf-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "AttendanceSystem.WPF"
    }
  }
}
