{
  "ConnectionStrings": {
    "AttendanceDb": "Host=localhost;Port=5432;Database=AttendanceSystem;Username=attendancesystem_user;Password=YOUR_PASSWORD;",
    "HangfireDb": "Host=localhost;Port=5432;Database=AttendanceSystem;Username=attendancesystem_user;Password=YOUR_PASSWORD;"
  },
  "Hosting": {
    "Standalone": false
  },
  "ZKTecoService": {
    "Url": "http://localhost:5001",
    "ApiKey": "LA_API_KEY_DEL_SERVICIO_ZKTECO"
  },
  "Maintenance": {
    "PollIntervalSeconds": 5
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/wpf-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "AttendanceSystem.WPF"
    }
  }
}
