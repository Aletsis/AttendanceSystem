@page "/"
@using MudBlazor
@using MediatR
@using AttendanceSystem.Application.DTOs
@using AttendanceSystem.Application.Features.Employees.Queries
@using AttendanceSystem.Application.Features.Devices.Queries.GetAllDevices
@using AttendanceSystem.Application.Features.Branches.Queries.GetBranches
@using AttendanceSystem.Application.Features.Departments.Queries.GetDepartments
@using AttendanceSystem.Application.Features.Positions.Queries.GetPositions
@using AttendanceSystem.Application.Features.Shifts.Queries.GetShifts
@using AttendanceSystem.Application.Features.Configuration.Queries.GetSystemConfiguration
@using AttendanceSystem.Application.Features.Reports.Queries.GetAttendanceReport
@inject IMediator Mediator

<PageTitle>Sistema de Asistencia</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h3" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="mr-2" />
        Panel de Control
    </MudText>
    <MudText Typo="Typo.body1" Class="mb-6">Bienvenido al sistema de control de asistencia con dispositivos ZKTeco.</MudText>
    
    @if (!_isLoading)
    {
        <!-- Resumen Ejecutivo -->
        <MudGrid Class="mb-6">
            <MudItem xs="12" md="8">
                <MudCard Elevation="4" Style="border-radius: 16px;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5">Asistencia de Hoy</MudText>
                            <MudText Typo="Typo.caption">@DateTime.Today.ToString("D")</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                             <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/attendance/reports">Ver Detalle</MudButton>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="4" Class="text-center">
                                <MudText Typo="Typo.h4" Color="Color.Success">@_todayOnTime</MudText>
                                <MudText Typo="Typo.caption">Puntuales</MudText>
                            </MudItem>
                            <MudItem xs="4" Class="text-center">
                                <MudText Typo="Typo.h4" Color="Color.Warning">@_todayLates</MudText>
                                <MudText Typo="Typo.caption">Retardos</MudText>
                            </MudItem>
                            <MudItem xs="4" Class="text-center">
                                <MudText Typo="Typo.h4" Color="Color.Error">@_todayAbsents</MudText>
                                <MudText Typo="Typo.caption">Faltas</MudText>
                            </MudItem>
                        </MudGrid>
                        <MudDivider Class="my-4" />
                        <div class="d-flex justify-space-between align-center">
                             <MudText Typo="Typo.body2">Cumplimiento General</MudText>
                             <MudText Typo="Typo.h6" Color="Color.Primary">@GetComplianceRate() %</MudText>
                        </div>
                        <MudProgressLinear Color="Color.Primary" Value="@GetComplianceRate()" Class="mt-2" Size="Size.Large" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Elevation="4" Style="border-radius: 16px; height: 100%;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5">Salud de Equipos</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="string">
                            <MudListItem Icon="@Icons.Material.Filled.Wifi" IconColor="Color.Success">
                                <div class="d-flex justify-space-between">
                                    <MudText>En Línea</MudText>
                                    <MudText Typo="Typo.body2" Class="fw-bold">@_onlineDevices / @_totalDevices</MudText>
                                </div>
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Storage" IconColor="Color.Info">
                                <div class="d-flex justify-space-between">
                                    <MudText>Memoria OK</MudText>
                                    <MudText Typo="Typo.body2" Class="fw-bold">@_storageOkDevices / @_totalDevices</MudText>
                                </div>
                            </MudListItem>
                        </MudList>
                        <MudAlert Severity="@(GetHealthSeverity())" Dense="true" Class="mt-2">
                            @(GetHealthStatus())
                        </MudAlert>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Estadísticas Rápidas (Compactas) -->
        <MudGrid Spacing="2" Class="mb-6">
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-radius: 12px;">
                    <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">@_totalEmployees</MudText>
                    <MudText Typo="Typo.caption">Personal</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-radius: 12px;">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Info" />
                    <MudText Typo="Typo.h6">@_totalBranches</MudText>
                    <MudText Typo="Typo.caption">Sucursales</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-radius: 12px;">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Warning" />
                    <MudText Typo="Typo.h6">@_totalDepartments</MudText>
                    <MudText Typo="Typo.caption">Depto</MudText>
                </MudPaper>
            </MudItem>
             <MudItem xs="6" sm="4" md="2">
                <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-radius: 12px;">
                    <MudIcon Icon="@Icons.Material.Filled.Work" Color="Color.Tertiary" />
                    <MudText Typo="Typo.h6">@_totalPositions</MudText>
                    <MudText Typo="Typo.caption">Puestos</MudText>
                </MudPaper>
            </MudItem>
             <MudItem xs="6" sm="4" md="2">
                <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-radius: 12px;">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Secondary" />
                    <MudText Typo="Typo.h6">@_totalShifts</MudText>
                    <MudText Typo="Typo.caption">Turnos</MudText>
                </MudPaper>
            </MudItem>
             <MudItem xs="6" sm="4" md="2">
                <MudPaper Elevation="2" Class="pa-4 text-center" Style="border-radius: 12px;">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Color="Color.Dark" />
                    <MudText Typo="Typo.h6">@_config?.WorkPeriodMode</MudText>
                    <MudText Typo="Typo.caption">Periodo</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- ⚠️ Alertas de Permisos Temporales Pendientes -->
        @if (_pendingExitAlerts.Any())
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4" Icon="@Icons.Material.Filled.Warning">
                <strong>@_totalPendingExits permiso(s) temporal(es) pendiente(s) de clasificar hoy.</strong>
                Revisa el reporte de asistencia para clasificarlos como con/sin goce de sueldo.
            </MudAlert>
            <MudCard Elevation="3" Style="border-left: 4px solid var(--mud-palette-warning); border-radius: 12px;" Class="mb-6">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Class="mr-2" Color="Color.Warning" />
                            Permisos Temporales — Pendientes de Clasificar
                        </MudText>
                        <MudText Typo="Typo.caption">Salidas intermedias detectadas hoy que requieren atención del administrador</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Variant="Variant.Text" Color="Color.Warning" Href="/attendance/reports"
                                   StartIcon="@Icons.Material.Filled.OpenInNew">Ver Reporte</MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent Class="pt-0">
                    <MudTable Items="@_pendingExitAlerts" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Empleado</MudTh>
                            <MudTh>Fecha</MudTh>
                            <MudTh>Minutos Fuera</MudTh>
                            <MudTh>Nota del Sistema</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.EmployeeName</MudTd>
                            <MudTd>@context.Date.ToString("dd/MM/yyyy")</MudTd>
                            <MudTd>
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small">@($"{context.TemporaryExitMinutes} min")</MudChip>
                            </MudTd>
                            <MudTd>@context.AttendanceNote</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        }

        <!-- Gestión de Personal -->
        <MudText Typo="Typo.h5" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
            Gestión de Personal
        </MudText>
        <MudGrid Spacing="2" Class="mb-6">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Class="mt-2">Empleados</MudText>
                        <MudText Typo="Typo.body2">Gestiona el registro de empleados</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/employees" FullWidth="true">Ir a Empleados</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large" Color="Color.Info" />
                        <MudText Typo="Typo.h6" Class="mt-2">Sucursales</MudText>
                        <MudText Typo="Typo.body2">Administra las sucursales</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/branches" FullWidth="true">Ir a Sucursales</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Large" Color="Color.Warning" />
                        <MudText Typo="Typo.h6" Class="mt-2">Departamentos</MudText>
                        <MudText Typo="Typo.body2">Gestiona departamentos</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/departments" FullWidth="true">Ir a Departamentos</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.Work" Size="Size.Large" Color="Color.Tertiary" />
                        <MudText Typo="Typo.h6" Class="mt-2">Puestos</MudText>
                        <MudText Typo="Typo.body2">Administra puestos de trabajo</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/positions" FullWidth="true">Ir a Puestos</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.h6" Class="mt-2">Horarios</MudText>
                        <MudText Typo="Typo.body2">Configura turnos y horarios</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/shifts" FullWidth="true">Ir a Horarios</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
        
        <!-- Dispositivos y Descargas -->
        <MudText Typo="Typo.h5" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Devices" Class="mr-2" />
            Dispositivos y Descargas
        </MudText>
        <MudGrid Spacing="2" Class="mb-6">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.DeviceHub" Size="Size.Large" Color="Color.Success" />
                        <MudText Typo="Typo.h6" Class="mt-2">Dispositivos</MudText>
                        <MudText Typo="Typo.body2">Gestiona dispositivos biométricos</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/devices" FullWidth="true">Ir a Dispositivos</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Size="Size.Large" Color="Color.Info" />
                        <MudText Typo="Typo.h6" Class="mt-2">Estado de Dispositivos</MudText>
                        <MudText Typo="Typo.body2">Monitoreo y memoria en tiempo real</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/device-status" FullWidth="true">Ir a Monitoreo</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Class="mt-2">Descargar Registros</MudText>
                        <MudText Typo="Typo.body2">Descarga logs de dispositivos</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/attendance/download" FullWidth="true">Ir a Descargas</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.EditNote" Size="Size.Large" Color="Color.Info" />
                        <MudText Typo="Typo.h6" Class="mt-2">Registros Manuales</MudText>
                        <MudText Typo="Typo.body2">Gestiona registros manuales</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/attendance/manual-logs" FullWidth="true">Ir a Registros</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.Calculate" Size="Size.Large" Color="Color.Warning" />
                        <MudText Typo="Typo.h6" Class="mt-2">Calcular Asistencia</MudText>
                        <MudText Typo="Typo.body2">Procesa registros de asistencia</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/attendance/calculation" FullWidth="true">Ir a Cálculo</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
        
        <!-- Reportes y Análisis -->
        <MudText Typo="Typo.h5" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" />
            Reportes y Análisis
        </MudText>
        <MudGrid Spacing="2" Class="mb-6">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.TableChart" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Class="mt-2">Reporte de Asistencia</MudText>
                        <MudText Typo="Typo.body2">Consulta asistencia diaria</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/attendance/reports" FullWidth="true">Ir a Reportes</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Large" Color="Color.Success" />
                        <MudText Typo="Typo.h6" Class="mt-2">Reportes Avanzados</MudText>
                        <MudText Typo="Typo.body2">Análisis de incidencias</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/attendance/advanced-reports" FullWidth="true">Ir a Avanzados</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Large" Color="Color.Info" />
                        <MudText Typo="Typo.h6" Class="mt-2">Logs de Asistencia</MudText>
                        <MudText Typo="Typo.body2">Revisa logs sin procesar</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/attendance/logs" FullWidth="true">Ir a Logs</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.h6" Class="mt-2">Análisis de Ausentismo</MudText>
                        <MudText Typo="Typo.body2">Identifica patrones de faltas</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/attendance/absenteeism-analysis" FullWidth="true">Ir a Análisis</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Large" Color="Color.Warning" />
                        <MudText Typo="Typo.h6" Class="mt-2">Análisis de Retardos</MudText>
                        <MudText Typo="Typo.body2">Identifica patrones de retardos</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/attendance/tardiness-analysis" FullWidth="true">Ir a Análisis</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
        
        <!-- Configuración -->
        <MudText Typo="Typo.h5" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
            Configuración
        </MudText>
        <MudGrid Spacing="2" Class="mb-6">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="2" Class="hover-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.h6" Class="mt-2">Configuración</MudText>
                        <MudText Typo="Typo.body2">Ajustes del sistema</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/settings" FullWidth="true">Ir a Configuración</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    }
</MudContainer>

@code {
    private bool _isLoading = true;
    private int _totalEmployees;
    private int _totalDevices;
    private int _totalBranches;
    private int _totalDepartments;
    private int _totalPositions;
    private int _totalShifts;
    
    // Today Stats
    private int _todayOnTime;
    private int _todayLates;
    private int _todayAbsents;
    
    // Device Health
    private int _onlineDevices;
    private int _storageOkDevices;

    // Alertas de permisos temporales
    private List<AttendanceReportViewDto> _pendingExitAlerts = new();
    private int _totalPendingExits;

    private SystemConfigurationDto? _config;

    private double GetComplianceRate()
    {
        if (_totalEmployees == 0) return 0;
        return Math.Round((double)_todayOnTime / _totalEmployees * 100, 1);
    }

    private Severity GetHealthSeverity()
    {
        if (_totalDevices == 0) return Severity.Normal;
        if (_onlineDevices == _totalDevices && _storageOkDevices == _totalDevices) return Severity.Success;
        if (_onlineDevices == 0) return Severity.Error;
        return Severity.Warning;
    }

    private string GetHealthStatus()
    {
        if (_totalDevices == 0) return "No hay equipos registrados.";
        if (_onlineDevices == _totalDevices && _storageOkDevices == _totalDevices) return "Todos los equipos operan normalmente.";
        if (_onlineDevices < _totalDevices) return $"{_totalDevices - _onlineDevices} equipos están desconectados.";
        if (_storageOkDevices < _totalDevices) return "Atención: Algunos equipos tienen memoria casi llena.";
        return "Revisión técnica recomendada.";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
    }

    private async Task LoadStats()
    {
        _isLoading = true;
        try 
        {
            // Cargar conteos básicos
            var employeesResult = await Mediator.Send(new GetAllEmployeesQuery());
            _totalEmployees = employeesResult.Value?.Count ?? 0;
            
            var devicesResult = await Mediator.Send(new GetAllDevicesQuery());
            _totalDevices = devicesResult.Value?.Count() ?? 0;
            _onlineDevices = devicesResult.Value?.Count(d => d.Status == "Online" || d.Status == "En Línea") ?? 0;
            _storageOkDevices = devicesResult.Value?.Count(d => (d.AttendanceRecordCount ?? 0) < (d.AttendanceRecordCapacity ?? 100000) * 0.9) ?? 0;

            var branchesResult = await Mediator.Send(new GetBranchesQuery());
            _totalBranches = branchesResult.Value?.Count() ?? 0;

            var deptsResult = await Mediator.Send(new GetDepartmentsQuery());
            _totalDepartments = deptsResult.Value?.Count() ?? 0;

            var positionsResult = await Mediator.Send(new GetPositionsQuery());
            _totalPositions = positionsResult.Value?.Count() ?? 0;

            var shiftsResult = await Mediator.Send(new GetShiftsQuery());
            _totalShifts = shiftsResult.Value?.Count() ?? 0;

            var configResult = await Mediator.Send(new GetSystemConfigurationQuery());
            _config = configResult.Value;

            // --- Permisos temporales pendientes de hoy ---
            var todayReport = await Mediator.Send(new GetAttendanceReportQuery(
                DateTime.Today, DateTime.Today, null, null));
            _pendingExitAlerts = todayReport
                .Where(r => r.HasTemporaryExits && r.TemporaryExitStatus == 0)
                .OrderBy(r => r.EmployeeName)
                .ToList();
            _totalPendingExits = _pendingExitAlerts.Count;

            // Stats del día (aproximación mientras no haya DashboardQuery dedicado)
            var todayAll = todayReport.ToList();
            _todayOnTime  = todayAll.Count(r => !r.IsAbsent && r.LateMinutes == 0 && !r.MissingCheckIn);
            _todayLates   = todayAll.Count(r => r.LateMinutes > 0);
            _todayAbsents = todayAll.Count(r => r.IsAbsent);
        }
        catch (Exception)
        {
            // En caso de error, mantener los valores en 0
        }
        finally
        {
            _isLoading = false;
        }
    }
}
