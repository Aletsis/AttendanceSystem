@page "/roster"
@using AttendanceSystem.Application.Features.Roster.Queries.GetRosterEmployees
@using AttendanceSystem.Application.Features.Branches.Queries.GetBranches
@using AttendanceSystem.Application.DTOs
@using AttendanceSystem.Blazor.Server.Components.Dialogs
@using MediatR
@inject ISender Sender
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Roster de Turnos y Horarios Rotativos</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h5" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="mr-2 vertical-align-middle" />
                Roster de Turnos y Horarios Rotativos
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Gestione los empleados con esquemas rotativos asignados (3x8, 4x3, 24x48) y consulte sus proyecciones de turnos.
            </MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoMode" OnClick="OpenRotationSchemeDialog">
                Asignar Esquema Rotativo
            </MudButton>
        </div>
    </div>

    <!-- Filtros de búsqueda -->
    <MudCard Class="mb-4">
        <MudCardContent>
            <MudGrid Class="align-center">
                <MudItem xs="12" sm="4">
                    <MudSelect T="Guid?" @bind-Value="_selectedBranchId" @bind-Value:after="LoadEmployees" Label="Sucursal" Clearable="true" Dense="true">
                        @foreach (var b in _branches)
                        {
                            <MudSelectItem T="Guid?" Value="@b.Id">@b.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudTextField @bind-Value="_searchString"
                                  Placeholder="Buscar por nombre, ID o esquema..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Medium"
                                  Clearable="true"
                                  Immediate="true"
                                  DebounceInterval="300"
                                  OnDebounceIntervalElapsed="LoadEmployees" />
                </MudItem>
                <MudItem xs="12" sm="3" Class="d-flex align-center gap-2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadEmployees" FullWidth="true">
                        Actualizar
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <!-- Resumen rápido de métricas -->
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-3 d-flex align-center justify-space-between" Elevation="1">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Empleados con Esquema</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Primary">@_employees.Count</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-3 d-flex align-center justify-space-between" Elevation="1">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Con Proyección Activa</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Success">@_employees.Count(e => e.HasRoster)</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-3 d-flex align-center justify-space-between" Elevation="1">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">En Descanso Hoy</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Warning">@_employees.Count(e => e.TodayStatus != null && e.TodayStatus.Contains("Descanso"))</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.Weekend" Color="Color.Warning" Size="Size.Large" />
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Tabla principal de empleados con esquema rotativo -->
    <MudCard>
        <MudTable Items="_employees" Dense="true" Hover="true" Loading="_loading">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Empleados Asignados a Esquema Rotativo (@_employees.Count)</MudText>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Empleado</MudTh>
                <MudTh>Sucursal / Departamento</MudTh>
                <MudTh>Esquema Rotativo</MudTh>
                <MudTh>Proyección / Vigencia</MudTh>
                <MudTh>Estado Hoy</MudTh>
                <MudTh Style="text-align: right;">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Empleado">
                    <div class="d-flex align-center">
                        <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-2">
                            @(context.FullName.Length > 0 ? context.FullName.Substring(0, 1).ToUpper() : "?")
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@context.FullName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">ID: @context.EmployeeId</MudText>
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="Sucursal / Depto">
                    <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(context.BranchName) ? "—" : context.BranchName)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(string.IsNullOrEmpty(context.DepartmentName) ? "—" : context.DepartmentName)</MudText>
                </MudTd>
                <MudTd DataLabel="Esquema Rotativo">
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.AutoMode">
                        @context.SchemeName
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Proyección / Vigencia">
                    @if (context.HasRoster && context.StartDate.HasValue && context.EndDate.HasValue)
                    {
                        <MudText Typo="Typo.body2">
                            @context.StartDate.Value.ToString("dd/MM/yyyy") - @context.EndDate.Value.ToString("dd/MM/yyyy")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @context.TotalAssignments días asignados
                        </MudText>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Filled" Size="Size.Small">
                            Sin proyección generada
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Estado Hoy">
                    @if (context.TodayStatus != null && context.TodayStatus.Contains("Descanso"))
                    {
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Weekend">
                            @context.TodayStatus
                        </MudChip>
                    }
                    else if (context.TodayStatus != null && (context.TodayStatus.Contains(":") || context.TodayStatus.Contains("Turno")))
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Work">
                            @context.TodayStatus
                        </MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.TodayStatus ?? "—")</MudText>
                    }
                </MudTd>
                <MudTd Style="text-align: right;">
                    <div class="d-flex justify-end gap-1">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.CalendarMonth"
                                   OnClick="@(() => OpenProjectionDialog(context))">
                            Ver Proyección
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.EditCalendar"
                                   OnClick="@(() => OpenModifySchemeDialog(context))">
                            Modificar Esquema
                        </MudButton>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="pa-4">
                    No se encontraron empleados con esquema rotativo asignado para los filtros seleccionados.
                </MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[]{ 10, 25, 50, 100 }" />
            </PagerContent>
        </MudTable>
    </MudCard>
</MudContainer>

@code {
    private Guid? _selectedBranchId;
    private string _searchString = "";
    private bool _loading;

    private List<RosterEmployeeDto> _employees = new();
    private List<BranchDto> _branches = new();

    protected override async Task OnInitializedAsync()
    {
        var branchResult = await Sender.Send(new GetBranchesQuery());
        if (branchResult.IsSuccess)
        {
            _branches = branchResult.Value.ToList();
        }

        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        try
        {
            _loading = true;
            var query = new GetRosterEmployeesQuery(_selectedBranchId, _searchString);
            _employees = await Sender.Send(query);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar empleados rotativos: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenProjectionDialog(RosterEmployeeDto employee)
    {
        var parameters = new DialogParameters
        {
            { nameof(RosterProjectionDialog.EmployeeId), employee.EmployeeId },
            { nameof(RosterProjectionDialog.EmployeeName), employee.FullName },
            { nameof(RosterProjectionDialog.SchemeName), employee.SchemeName }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<RosterProjectionDialog>($"Proyección de Turnos - {employee.FullName}", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadEmployees();
        }
    }

    private async Task OpenModifySchemeDialog(RosterEmployeeDto employee)
    {
        var parameters = new DialogParameters
        {
            { nameof(RotationSchemeDialog.PreselectedEmployeeId), employee.EmployeeId },
            { nameof(RotationSchemeDialog.PreselectedEmployeeName), employee.FullName },
            { nameof(RotationSchemeDialog.InitialSchemeName), employee.SchemeName }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<RotationSchemeDialog>($"Modificar Esquema Rotativo - {employee.FullName}", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadEmployees();
        }
    }

    private async Task OpenRotationSchemeDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<RotationSchemeDialog>("Asignar Esquema Rotativo", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadEmployees();
        }
    }
}
