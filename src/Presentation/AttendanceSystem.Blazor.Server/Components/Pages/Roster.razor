@page "/roster"
@using AttendanceSystem.Application.Features.Roster.Queries.GetShiftRoster
@using AttendanceSystem.Application.Features.Roster.Commands.AssignShiftRoster
@using AttendanceSystem.Application.Features.Roster.Commands.DeleteShiftRoster
@using AttendanceSystem.Application.DTOs
@using AttendanceSystem.Application.Features.Branches.Queries.GetBranches
@using AttendanceSystem.Application.Features.Employees.Queries
@using AttendanceSystem.Application.Features.Shifts.Queries.GetShifts
@using AttendanceSystem.Blazor.Server.Components.Dialogs
@using MediatR
@inject ISender Sender
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Roster de Turnos y Horarios Rotativos</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h5" GutterBottom="true">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="mr-2 vertical-align-middle" />
                Roster de Turnos y Horarios Rotativos
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Gestione esquemas rotativos (3x8, 4x3, 24x48) y asignaciones directas de turnos y descansos.
            </MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoMode" OnClick="OpenRotationSchemeDialog">
                Asignar Esquema Rotativo
            </MudButton>
        </div>
    </div>

    <MudCard Class="mb-4">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="3">
                    <MudDatePicker Label="Desde" @bind-Date="_startDate" DateFormat="dd/MM/yyyy" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudDatePicker Label="Hasta" @bind-Date="_endDate" DateFormat="dd/MM/yyyy" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="Guid?" @bind-Value="_selectedBranchId" Label="Sucursal" Clearable="true">
                        @foreach (var b in _branches)
                        {
                            <MudSelectItem T="Guid?" Value="@b.Id">@b.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3" Class="d-flex align-center">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="LoadRoster" FullWidth="true">
                        Filtrar Roster
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <MudCard>
        <MudTable Items="_rosterItems" Dense="true" Hover="true" Loading="_loading" Filter="FilterFunc">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Asignaciones de Calendario (@_rosterItems.Count)</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Placeholder="Buscar empleado o turno..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Fecha</MudTh>
                <MudTh>Empleado</MudTh>
                <MudTh>Estado / Turno</MudTh>
                <MudTh>Horario</MudTh>
                <MudTh>Notas / Esquema</MudTh>
                <MudTh Style="text-align: right;">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Fecha">
                    <MudText Typo="Typo.body2" Style="font-weight: 500;">
                        @context.Date.ToString("dd/MM/yyyy (ddd)")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Empleado">
                    <MudText Typo="Typo.body2">@context.EmployeeName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">ID: @context.EmployeeId</MudText>
                </MudTd>
                <MudTd DataLabel="Estado / Turno">
                    @if (context.IsRestDay)
                    {
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Weekend">
                            Día de Descanso
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Work">
                            @(context.ShiftName ?? "Turno Asignado")
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Horario">
                    @if (!context.IsRestDay && context.StartTime.HasValue && context.EndTime.HasValue)
                    {
                        <MudText Typo="Typo.body2">
                            @context.StartTime.Value.ToString(@"hh\:mm") - @context.EndTime.Value.ToString(@"hh\:mm")
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Notas">
                    <MudText Typo="Typo.caption">@(context.Notes ?? "—")</MudText>
                </MudTd>
                <MudTd Style="text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteItem(context.Id))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="pa-4">No hay asignaciones en el roster para los filtros seleccionados.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[]{ 15, 30, 50, 100 }" />
            </PagerContent>
        </MudTable>
    </MudCard>
</MudContainer>

@code {
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = DateTime.Today.AddDays(14);
    private Guid? _selectedBranchId;
    private string _searchString = "";
    private bool _loading;

    private List<ShiftRosterDto> _rosterItems = new();
    private List<BranchDto> _branches = new();

    protected override async Task OnInitializedAsync()
    {
        var branchResult = await Sender.Send(new GetBranchesQuery());
        if (branchResult.IsSuccess)
        {
            _branches = branchResult.Value.ToList();
        }

        await LoadRoster();
    }

    private async Task LoadRoster()
    {
        if (!_startDate.HasValue || !_endDate.HasValue) return;

        try
        {
            _loading = true;
            var query = new GetShiftRosterQuery(
                _startDate.Value,
                _endDate.Value,
                _selectedBranchId);

            _rosterItems = await Sender.Send(query);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar el roster: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool FilterFunc(ShiftRosterDto item)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        if (item.EmployeeName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (item.EmployeeId.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (item.ShiftName != null && item.ShiftName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (item.Notes != null && item.Notes.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private async Task OpenRotationSchemeDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<RotationSchemeDialog>("Asignar Esquema Rotativo", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadRoster();
        }
    }

    private async Task DeleteItem(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirmar eliminación",
            "¿Desea eliminar esta asignación del roster?",
            yesText: "Eliminar", cancelText: "Cancelar", noText: null,
            options: new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall });

        if (confirm == true)
        {
            var success = await Sender.Send(new DeleteShiftRosterCommand(id));
            if (success)
            {
                Snackbar.Add("Asignación eliminada.", Severity.Success);
                await LoadRoster();
            }
        }
    }
}
