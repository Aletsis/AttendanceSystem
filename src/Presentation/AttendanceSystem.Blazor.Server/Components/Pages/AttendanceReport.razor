@page "/attendance/reports"
@attribute [Authorize(Policy = Permissions.ReportsView)]
@using MediatR
@using AttendanceSystem.Application.Features.Reports.Queries.GetAttendanceReport
@using AttendanceSystem.Application.Features.Employees.Queries
@using AttendanceSystem.Application.Features.Branches.Queries.GetBranches
@using AttendanceSystem.Application.DTOs
@using AttendanceSystem.Domain.ValueObjects
@using AttendanceSystem.Application.Features.Employees
@using AttendanceSystem.Application.Features.Configuration.Queries.GetSystemConfiguration
@using AttendanceSystem.Domain.Enumerations
@using AttendanceSystem.Domain.Aggregates.DailyAttendanceAggregate
@using AttendanceSystem.Application.Features.Attendance.Decisions
@using AttendanceSystem.Application.Common
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IReportExportService ExportService
@inject IJSRuntime JS

<PageTitle>Reporte de Asistencia</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Reporte de Asistencia</MudText>

<MudGrid Spacing="2">
    <MudItem xs="6" sm="3">
        <MudDatePicker Label="Desde" @bind-Date="StartDate" />
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudDatePicker Label="Hasta" @bind-Date="EndDate" />
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudSelect T="Guid?" Label="Sucursal" Value="SelectedBranchId" ValueChanged="OnBranchChanged" Clearable="true" AdornmentColor="Color.Primary">
            <MudSelectItem T="Guid?" Value="null">Todas</MudSelectItem>
            @foreach (var branch in Branches)
            {
                <MudSelectItem T="Guid?" Value="@branch.Id">@branch.Name</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudAutocomplete T="EmployeeDto" 
                        Label="Empleado"
                        @bind-Value="SelectedEmployeeObj" 
                        SearchFunc="@SearchEmployees"
                        ToStringFunc="@(e => e == null ? null : $"{e.Id} - {e.FullName}")"
                        Clearable="true"
                        AdornmentColor="Color.Primary"
                        ResetValueOnEmptyText="true" />
    </MudItem>
    
    <MudItem xs="12" Class="d-flex flex-wrap align-center justify-end gap-2">
        <MudHidden Breakpoint="Breakpoint.Xs">
            <MudButton Variant="Variant.Filled" Color="Color.Surface" OnClick="ExportPdf" StartIcon="@Icons.Material.Filled.PictureAsPdf">PDF</MudButton>
            @if (StartDate.HasValue && EndDate.HasValue && StartDate.Value.Date == EndDate.Value.Date)
            {
                 <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => ExportExcel(false))" StartIcon="@Icons.Material.Filled.TableView">Excel</MudButton>
            }
            else
            {
                <MudMenu Label="Excel" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.TableView" EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                    <MudMenuItem OnClick="@(() => ExportExcel(false))">Resumido</MudMenuItem>
                    <MudMenuItem OnClick="@(() => ExportExcel(true))">Detallado</MudMenuItem>
                </MudMenu>
            }
            @if (_canExportPayroll)
            {
                <MudMenu Label="Nómina" Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Payments" EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                    <MudMenuItem OnClick="ExportContpaqi">CONTPAQi Nóminas (.csv)</MudMenuItem>
                    <MudMenuItem OnClick="ExportAspelNoi">Aspel NOI (.txt)</MudMenuItem>
                </MudMenu>
            }
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
            <MudMenu Icon="@Icons.Material.Filled.FileDownload" Label="Exportar" Variant="Variant.Filled" Color="Color.Info">
                <MudMenuItem OnClick="ExportPdf">PDF</MudMenuItem>
                <MudMenuItem OnClick="@(() => ExportExcel(false))">Excel Resumido</MudMenuItem>
                <MudMenuItem OnClick="@(() => ExportExcel(true))">Excel Detallado</MudMenuItem>
                @if (_canExportPayroll)
                {
                    <MudMenuItem OnClick="ExportContpaqi">CONTPAQi</MudMenuItem>
                    <MudMenuItem OnClick="ExportAspelNoi">Aspel NOI</MudMenuItem>
                }
            </MudMenu>
        </MudHidden>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadData">Ver Reporte</MudButton>
    </MudItem>
</MudGrid>

@if (_closedPeriods.Count > 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-4" Dense="true" Icon="@Icons.Material.Filled.Lock">
        Periodo cerrado: @string.Join(", ", _closedPeriods.Select(p => p.Describe())). Esos días no cambian.
    </MudAlert>
}
<MudDataGrid @ref="_dataGrid" Items="@AttendanceList" Filterable="true" Class="mt-4" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
    <Columns>
        <PropertyColumn T="AttendanceReportViewDto" TProperty="string" Property="x => x.EmployeeId" Title="ID" SortBy="@SortByEmployeeId" />
        <PropertyColumn Property="x => x.EmployeeName" Title="Empleado" />
        <PropertyColumn Property="x => x.Date" Title="Fecha" Format="dd/MM/yyyy" />
        <PropertyColumn Property="x => x.ShiftName" Title="Horario" />
        <TemplateColumn Title="Entrada Prog.">
            <CellTemplate>
                @if (context.Item.ShiftType == ShiftType.Partido && context.Item.ScheduledBlock2CheckIn.HasValue)
                {
                    <div style="font-size: 0.82rem; line-height: 1.2;">
                        <div><span class="mud-text-secondary">B1:</span> @(context.Item.ScheduledCheckIn?.ToString(@"hh\:mm") ?? "--")</div>
                        <div><span class="mud-text-secondary">B2:</span> @(context.Item.ScheduledBlock2CheckIn?.ToString(@"hh\:mm") ?? "--")</div>
                    </div>
                }
                else
                {
                    @(context.Item.ScheduledCheckIn?.ToString(@"hh\:mm") ?? "--")
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Salida Prog.">
            <CellTemplate>
                @if (context.Item.ShiftType == ShiftType.Partido && context.Item.ScheduledBlock2CheckOut.HasValue)
                {
                    <div style="font-size: 0.82rem; line-height: 1.2;">
                        <div><span class="mud-text-secondary">B1:</span> @(context.Item.ScheduledCheckOut?.ToString(@"hh\:mm") ?? "--")</div>
                        <div><span class="mud-text-secondary">B2:</span> @(context.Item.ScheduledBlock2CheckOut?.ToString(@"hh\:mm") ?? "--")</div>
                    </div>
                }
                else
                {
                    @(context.Item.ScheduledCheckOut?.ToString(@"hh\:mm") ?? "--")
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Entrada Real">
            <CellTemplate>
                @if (context.Item.ShiftType == ShiftType.Partido)
                {
                    <div style="font-size: 0.82rem; line-height: 1.2;">
                        <div><span class="mud-text-secondary">B1:</span> @(context.Item.ActualCheckIn?.ToString("HH:mm") ?? (context.Item.MissingCheckIn ? "--" : ""))</div>
                        <div><span class="mud-text-secondary">B2:</span> @(context.Item.ActualBlock2CheckIn?.ToString("HH:mm") ?? (context.Item.MissingBlock2CheckIn ? "--" : ""))</div>
                    </div>
                }
                else
                {
                    @(context.Item.ActualCheckIn?.ToString("HH:mm:ss") ?? (context.Item.MissingCheckIn ? "--" : ""))
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Salida Real">
            <CellTemplate>
                @if (context.Item.ShiftType == ShiftType.Partido)
                {
                    <div style="font-size: 0.82rem; line-height: 1.2;">
                        <div><span class="mud-text-secondary">B1:</span> @(context.Item.ActualBlock1CheckOut?.ToString("HH:mm") ?? (context.Item.MissingBlock1CheckOut ? "--" : ""))</div>
                        <div><span class="mud-text-secondary">B2:</span> @(context.Item.ActualCheckOut?.ToString("HH:mm") ?? (context.Item.MissingCheckOut ? "--" : ""))</div>
                    </div>
                }
                else
                {
                    @(context.Item.ActualCheckOut?.ToString("HH:mm:ss") ?? (context.Item.MissingCheckOut ? "--" : ""))
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.LateMinutes" Title="Retardo (min)" />
        <PropertyColumn Property="x => x.RoundedOvertimeMinutes" Title="Extra (min)" />
        <TemplateColumn Title="Estado">
            <CellTemplate>
                <div class="d-flex gap-1 flex-wrap">
                @if (context.Item.IsAbsent) { <MudChip Color="Color.Error" Size="Size.Small">Falta</MudChip> }
                @if (context.Item.LateMinutes > 0) { <MudChip Color="Color.Warning" Size="Size.Small">Retardo</MudChip> }
                @if (context.Item.ShiftType == ShiftType.Partido)
                {
                    @if (context.Item.MissingCheckIn) { <MudChip Color="Color.Warning" Size="Size.Small">Sin Ent B1</MudChip> }
                    @if (context.Item.MissingBlock1CheckOut) { <MudChip Color="Color.Warning" Size="Size.Small">Sin Sal B1</MudChip> }
                    @if (context.Item.MissingBlock2CheckIn) { <MudChip Color="Color.Warning" Size="Size.Small">Sin Ent B2</MudChip> }
                    @if (context.Item.MissingCheckOut) { <MudChip Color="Color.Warning" Size="Size.Small">Sin Sal B2</MudChip> }
                }
                else
                {
                    @if (context.Item.MissingCheckIn) { <MudChip Color="Color.Warning" Size="Size.Small">Sin Entrada</MudChip> }
                    @if (context.Item.MissingCheckOut) { <MudChip Color="Color.Warning" Size="Size.Small">Sin Salida</MudChip> }
                }
                @if (context.Item.WorkedOnRestDay) { <MudChip Color="Color.Success" Size="Size.Small">Trabajo en Descanso</MudChip> }
                else if (context.Item.IsRestDay) { <MudChip Color="Color.Info" Size="Size.Small">Descanso</MudChip> }
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Notas" Sortable="false">
            <CellTemplate>
                @foreach (var note in context.Item.Notes)
                {
                    <MudText Typo="Typo.caption" Style="display: block; line-height: 1.3;">@note</MudText>
                }
                @* Caso 12: a quien no tiene extras autorizadas, RH le autoriza el excedente del día completo o en bloques de
                   30 min; si el excedente cambia al recalcular, se vuelve a pedir. *@
                @if (!context.Item.EmployeeOvertimeAuthorized && context.Item.RawOvertimeMinutes > 0)
                {
                    var otItem = context.Item;
                    <AuthorizeView Policy="@Permissions.AttendanceAdjust" Context="auth">
                        <Authorized>
                            <div class="mt-1">
                                @if (otItem.OvertimeAuthorized && !otItem.OvertimeAuthorizationOutdated)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary"
                                               OnClick="@(() => SetDayOvertime(otItem, false, null))">Retirar autorización de extras</MudButton>
                                }
                                else
                                {
                                    <MudMenu Label="Autorizar extras" Size="Size.Small" Dense="true" Variant="Variant.Outlined" Color="Color.Primary"
                                             EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                                        <MudMenuItem OnClick="@(() => SetDayOvertime(otItem, true, otItem.RawOvertimeMinutes))">Completo (@otItem.RawOvertimeMinutes min)</MudMenuItem>
                                        @foreach (var block in OvertimeBlocks(otItem.RawOvertimeMinutes))
                                        {
                                            <MudMenuItem OnClick="@(() => SetDayOvertime(otItem, true, block))">@BlockLabel(block)</MudMenuItem>
                                        }
                                    </MudMenu>
                                }
                            </div>
                        </Authorized>
                    </AuthorizeView>
                }
                @if (context.Item.TemporaryExits.Any())
                {
                    var item = context.Item;
                    <AuthorizeView Policy="@Permissions.AttendanceAdjust" Context="auth">
                        <Authorized>
                            @* Caso 11: cada salida se clasifica por separado. *@
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var exit in item.TemporaryExits)
                                {
                                    <MudMenu Label="@ExitLabel(exit)" Size="Size.Small" Dense="true" Variant="Variant.Outlined"
                                             Color="@(exit.Status == TemporaryExitStatus.Pending ? Color.Warning : Color.Default)"
                                             EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                                        <MudMenuItem OnClick="@(() => ClassifyTemporaryExit(item, exit, TemporaryExitStatus.Lunch))">Comida</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => ClassifyTemporaryExit(item, exit, TemporaryExitStatus.ApprovedPaid))">Permiso con goce</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => ClassifyTemporaryExit(item, exit, TemporaryExitStatus.ApprovedUnpaid))">Permiso sin goce (descontar)</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => ClassifyTemporaryExit(item, exit, TemporaryExitStatus.Dismissed))">Error de checada</MudMenuItem>
                                        @if (exit.Status != (exit.IsAutomaticLunch ? TemporaryExitStatus.Lunch : TemporaryExitStatus.Pending))
                                        {
                                            <MudMenuItem OnClick="@(() => ClassifyTemporaryExit(item, exit, null))">Quitar clasificación</MudMenuItem>
                                        }
                                    </MudMenu>
                                }
                            </div>
                        </Authorized>
                    </AuthorizeView>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="AttendanceReportViewDto" />
    </PagerContent>
</MudDataGrid>

@code {
    private DateTime? StartDate = DateTime.Today;
    private DateTime? EndDate = DateTime.Today;
    private Guid? SelectedBranchId;
    private EmployeeDto? SelectedEmployeeObj;

    private List<AttendanceReportViewDto> AttendanceList = new();
    private MudDataGrid<AttendanceReportViewDto> _dataGrid = default!;
    private List<EmployeeDto> _allEmployees = new();
    private List<BranchDto> Branches = new();
    private SystemConfigurationDto _config = default!;
    
    // Cache for autocomplete
    private List<EmployeeDto> FilteredEmployees => SelectedBranchId.HasValue
        ? _allEmployees.Where(e => e.BranchId == SelectedBranchId.Value).ToList()
        : _allEmployees;

    // Caso 13: la prenómina es de RH y Administrador.
    private bool _canExportPayroll;

    protected override async Task OnInitializedAsync()
    {
        _canExportPayroll = await UiPermissions.HasAsync(Permissions.ReportsPayrollExport);
        var configResult = await Mediator.Send(new GetSystemConfigurationQuery());
        if (configResult.IsSuccess)
        {
            _config = configResult.Value;
        }

        var empResult = await Mediator.Send(new GetAllEmployeesQuery());
        if (empResult.IsSuccess)
        {
            _allEmployees = empResult.Value.ToList(); // caso 16: los reportes muestran a cada empleado en sus días activos
        }

        var branchResult = await Mediator.Send(new GetBranchesQuery());
        if (branchResult.IsSuccess)
        {
            Branches = branchResult.Value.ToList();
        }

        await LoadData();
    }

    private void OnBranchChanged(Guid? branchId)
    {
        SelectedBranchId = branchId;
        SelectedEmployeeObj = null; 
    }
    
    private Task<IEnumerable<EmployeeDto>> SearchEmployees(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrEmpty(value))
        {
            return Task.FromResult<IEnumerable<EmployeeDto>>(FilteredEmployees);
        }

        var result = FilteredEmployees.Where(e => 
            e.Id.Contains(value, StringComparison.InvariantCultureIgnoreCase) || 
            e.FullName.Contains(value, StringComparison.InvariantCultureIgnoreCase)
        );
        
        return Task.FromResult(result);
    }

    private static string ExitLabel(TemporaryExitDto exit) =>
        $"{exit.ExitTime:HH:mm}–{exit.ReturnTime:HH:mm} · " + exit.Status switch
        {
            TemporaryExitStatus.Lunch => "Comida",
            TemporaryExitStatus.ApprovedPaid => "Con goce",
            TemporaryExitStatus.ApprovedUnpaid => "Sin goce",
            TemporaryExitStatus.Dismissed => "Error",
            _ => "Pendiente"
        };

    private async Task ClassifyTemporaryExit(AttendanceReportViewDto item, TemporaryExitDto exit, TemporaryExitStatus? status)
    {
        var result = await Mediator.Send(new ClassifyTemporaryExitCommand(
            item.EmployeeId, DateOnly.FromDateTime(item.Date), exit.ExitRecordId, status,
            status == null ? null : "Clasificado desde el reporte de asistencia",
            ExpectedRevision: item.AdjustmentRevision));
        await ShowDecisionAsync(result);
    }

    /// <summary>Partes autorizables: bloques de 30 min menores al excedente (el excedente completo es "Completo").</summary>
    private static IEnumerable<int> OvertimeBlocks(int rawMinutes) =>
        Enumerable.Range(1, rawMinutes / DailyAttendance.OvertimeAuthorizationBlockMinutes)
            .Select(k => k * DailyAttendance.OvertimeAuthorizationBlockMinutes)
            .Where(m => m < rawMinutes);

    private static string BlockLabel(int minutes) =>
        minutes < 60 ? $"{minutes} min" : minutes % 60 == 0 ? $"{minutes / 60} h" : $"{minutes / 60} h {minutes % 60} min";

    private async Task SetDayOvertime(AttendanceReportViewDto item, bool authorize, int? minutes)
    {
        var result = await Mediator.Send(new SetDailyOvertimeAuthorizationCommand(
            item.EmployeeId, DateOnly.FromDateTime(item.Date),
            authorize ? true : null, authorize ? item.CalculateOvertimeBeforeEntry : null,
            authorize ? "Extras autorizadas desde el reporte de asistencia" : null,
            ExpectedRevision: item.AdjustmentRevision,
            AuthorizedMinutes: minutes, ForRawMinutes: minutes.HasValue ? item.RawOvertimeMinutes : null));
        await ShowDecisionAsync(result);
    }

    private async Task ShowDecisionAsync(Result<AttendanceDecisionOutcome> result)
    {
        if (result.IsSuccess)
            Snackbar.Add(result.Value.UserMessage, result.Value.Consolidated ? Severity.Success : Severity.Info);
        else if (result.Error.Contains("mientras se editaba", StringComparison.OrdinalIgnoreCase))
            // Caso 13: otra persona cambió el día; se recarga para revisar y volver a aplicar.
            Snackbar.Add("Este día fue modificado por otra persona; se recargó con los datos actuales. Revise y vuelva a aplicar.", Severity.Warning);
        else
            Snackbar.Add(result.Error, Severity.Error);
        await LoadData();
    }

    private async Task LoadData()
    {
        if (StartDate == null || EndDate == null) return;
        
        var branchId = SelectedBranchId.HasValue ? BranchId.From(SelectedBranchId.Value) : null;
        var employeeId = SelectedEmployeeObj?.Id;

        // Note: Using Mediator to get view DTOs
        var result = await Mediator.Send(new GetAttendanceReportQuery(
            StartDate.Value, 
            EndDate.Value,
            branchId,
            employeeId
        ));

        AttendanceList = result.ToList();
        _closedPeriods = await Mediator.Send(new AttendanceSystem.Application.Features.Attendance.PeriodClosure.GetClosedPeriodsInRangeQuery(StartDate.Value, EndDate.Value))
            ?? Array.Empty<AttendanceSystem.Application.Features.Attendance.PeriodClosure.AttendancePeriod>();
    }

    // Caso 17: aviso de los periodos cerrados que toca el reporte.
    private IReadOnlyList<AttendanceSystem.Application.Features.Attendance.PeriodClosure.AttendancePeriod> _closedPeriods =
        Array.Empty<AttendanceSystem.Application.Features.Attendance.PeriodClosure.AttendancePeriod>();

    private async Task ExportExcel(bool detailed)
    {
        if (!AttendanceList.Any() || StartDate == null || EndDate == null)
        {
            Snackbar.Add("No hay datos para exportar o fechas inválidas", Severity.Warning);
            return;
        }

        try
        {
            var data = _dataGrid?.FilteredItems != null && _dataGrid.FilteredItems.Any() 
                ? _dataGrid.FilteredItems 
                : AttendanceList;

            var sortedData = data.OrderBy(x => 
            {
                 if (long.TryParse(x.EmployeeId, out var id)) return id;
                 return long.MaxValue;
            })
            .ThenBy(x => x.EmployeeId)
            .ThenBy(x => x.Date);

            var bytes = ExportService.GenerateExcel(sortedData, StartDate.Value, EndDate.Value, _config?.CompanyName ?? "Mi Empresa", _config?.CompanyLogo, detailed);
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            var typeStr = detailed ? "Detallado" : "Resumido";
            await JS.InvokeVoidAsync("downloadFileFromStream", $"ReporteAsistencia_{typeStr}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx", streamRef);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar Excel: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExportPdf()
    {
        if (!AttendanceList.Any() || StartDate == null || EndDate == null)
        {
            Snackbar.Add("No hay datos para exportar o fechas inválidas", Severity.Warning);
            return;
        }

        try
        {
            var data = _dataGrid?.FilteredItems != null && _dataGrid.FilteredItems.Any() 
                 ? _dataGrid.FilteredItems 
                 : AttendanceList;
                 
            var sortedData = data.OrderBy(x => 
            {
                 if (long.TryParse(x.EmployeeId, out var id)) return id;
                 return long.MaxValue;
            })
            .ThenBy(x => x.EmployeeId)
            .ThenBy(x => x.Date);

            var bytes = ExportService.GeneratePdf(sortedData, StartDate.Value, EndDate.Value, _config?.CompanyName ?? "Mi Empresa", _config?.CompanyLogo);
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"ReporteAsistencia_{DateTime.Now:yyyyMMdd_HHmm}.pdf", streamRef);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar PDF: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExportContpaqi()
    {
        if (!_canExportPayroll) return;
        if (!AttendanceList.Any())
        {
            Snackbar.Add("No hay datos para exportar", Severity.Warning);
            return;
        }

        try
        {
            var data = _dataGrid?.FilteredItems != null && _dataGrid.FilteredItems.Any() 
                 ? _dataGrid.FilteredItems 
                 : AttendanceList;

            var bytes = ExportService.GenerateContpaqiNominaExport(data);
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Layout_CONTPAQi_{DateTime.Now:yyyyMMdd}.csv", streamRef);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar CONTPAQi: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExportAspelNoi()
    {
        if (!_canExportPayroll) return;
        if (!AttendanceList.Any())
        {
            Snackbar.Add("No hay datos para exportar", Severity.Warning);
            return;
        }

        try
        {
            var data = _dataGrid?.FilteredItems != null && _dataGrid.FilteredItems.Any() 
                 ? _dataGrid.FilteredItems 
                 : AttendanceList;

            var bytes = ExportService.GenerateAspelNoiExport(data);
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Layout_AspelNOI_{DateTime.Now:yyyyMMdd}.txt", streamRef);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar Aspel NOI: {ex.Message}", Severity.Error);
        }
    }

    private object SortByEmployeeId(AttendanceReportViewDto item)
    {
        if (long.TryParse(item.EmployeeId, out var id))
            return id;
        return item.EmployeeId;
    }
}
