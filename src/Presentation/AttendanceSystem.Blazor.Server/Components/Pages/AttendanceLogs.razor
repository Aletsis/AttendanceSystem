@page "/attendance/logs"
@attribute [Authorize(Policy = Permissions.AttendanceView)]
@using MediatR
@using AttendanceSystem.Application.Features.Attendance.Queries.GetAttendanceLogs
@using AttendanceSystem.Application.Features.Employees.Queries
@using AttendanceSystem.Application.Features.Employees
@using AttendanceSystem.Application.Features.Shifts.Queries.GetShifts
@using AttendanceSystem.Application.Common
@using AttendanceSystem.Application.DTOs
@inject CircuitMediator Mediator
@inject ISnackbar Snackbar
@using AttendanceSystem.Application.Features.Attendance.Commands.ManuallyAssignAttendance
@using AttendanceSystem.Application.Features.Attendance.Commands.RegisterManualAttendance
@using AttendanceSystem.Application.Features.Attendance.Commands.ProcessDailyAttendance
@using AttendanceSystem.Application.Features.Attendance.Commands.UpdateDailyShift
@using AttendanceSystem.Application.Features.Attendance.Decisions
@using AttendanceSystem.Domain.ValueObjects
@using AttendanceSystem.Domain.Aggregates.DailyAttendanceAggregate
@inject IDialogService DialogService
@inject IReportExportService ExportService
@inject IJSRuntime JS

<PageTitle>Bitácora de Asistencia (Logs)</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Bitácora de Asistencia (Logs)</MudText>

<MudGrid>
    <MudItem xs="12" sm="4">
        <MudDatePicker Label="Fecha" @bind-Date="SelectedDate" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudAutocomplete T="EmployeeDto" 
                        Label="Empleado (Busque por ID o Nombre)"
                        @bind-Value="SelectedEmployeeObj" 
                        SearchFunc="@SearchEmployees"
                        ToStringFunc="@(e => e == null ? null : $"{e.Id} - {e.FullName}")"
                        Clearable="true"
                        AdornmentColor="Color.Primary"
                        ResetValueOnEmptyText="true" />
    </MudItem>
    
    <MudItem xs="12" Class="d-flex align-center justify-end gap-2">
        <AuthorizeView Policy="@Permissions.AttendanceAdjust">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="OpenChangeShiftDialog" Disabled="@(SelectedEmployeeObj == null)">
                    Cambiar Horario
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="OpenManualLogDialog" Disabled="@(SelectedEmployeeObj == null)">
                    Agregar Manual
                </MudButton>
            </Authorized>
        </AuthorizeView>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadData">Ver Logs</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ExportToExcel" StartIcon="@Icons.Material.Filled.FileDownload" Disabled="@(!LogsList.Any())">Exportar Excel</MudButton>
    </MudItem>

    @if (SelectedEmployeeObj != null && SelectedDate != null && _dayState != null)
    {
        <MudItem xs="12" Class="d-flex flex-wrap align-center gap-2">
            @if (_dayState.ShiftOverrideName != null)
            {
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">Horario cambiado a mano: @_dayState.ShiftOverrideName</MudChip>
                @if (_canAdjust)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Info" StartIcon="@Icons.Material.Filled.Undo" OnClick="ClearShiftOverride">Regresar al horario del roster</MudButton>
                }
            }
            @if (_dayState.IsRestDayOverride is { } rest)
            {
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@(rest ? "Marcado a mano como descanso" : "Marcado a mano como laborable")</MudChip>
                @if (_canAdjust)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Info" StartIcon="@Icons.Material.Filled.Undo" OnClick="ClearRestDayOverride">Regresar al descanso del roster</MudButton>
                }
            }
            @if (_canViewHistory && _dayState.HistoryCount > 0)
            {
                <MudTooltip Text="Historial de ajustes del día">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.History" OnClick="OpenHistory">
                        Historial (@_dayState.HistoryCount)
                    </MudButton>
                </MudTooltip>
            }
        </MudItem>
    }
</MudGrid>

<MudDataGrid Items="@LogsList" Filterable="true" Class="mt-4">
    <Columns>
        <PropertyColumn Property="x => x.EmployeeId" Title="ID Empleado" />
        <PropertyColumn Property="x => x.EmployeeName" Title="Nombre" />
        <PropertyColumn Property="x => x.CheckTime" Title="Fecha/Hora" Format="dd/MM/yyyy HH:mm:ss" />
        
        <TemplateColumn Title="Tipo (Asignación)">
            <CellTemplate>
                <div class="d-flex align-center gap-2">
                    @if (context.Item.IsVoided)
                    {
                        <MudTooltip Text="@($"{(context.Item.WasCorrected ? "Corregido" : "Anulado")} por {context.Item.VoidedBy}: {context.Item.VoidReason}")">
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Style="text-decoration: line-through">
                                @(context.Item.WasCorrected ? "Corregido (no cuenta)" : "Anulado (no cuenta)")
                            </MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                    @if (context.Item.IsCorrection)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Hora corregida</MudChip>
                    }
                    @if (context.Item.IsManual)
                    {
                        <MudTooltip Text="@($"Manual: {context.Item.RegisteredBy} — {context.Item.ManualReason}")">
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">Manual</MudChip>
                        </MudTooltip>
                    }
                    @if (context.Item.IsTemporaryExit)
                    {
                        var statusLabel = GetExitStatusLabel(context.Item.TemporaryExitStatus);
                        var tooltip = $"Salida temporal ({context.Item.TemporaryExitMinutes} min) — {statusLabel}"
                            + (context.Item.TemporaryExitReturnTime.HasValue ? $" · Regreso: {context.Item.TemporaryExitReturnTime.Value:HH:mm}" : "")
                            + (!string.IsNullOrWhiteSpace(context.Item.TemporaryExitNote) ? $" · Auditoría: {context.Item.TemporaryExitNote}" : "");
                        <MudTooltip Text="@tooltip">
                            <MudChip T="string" Size="Size.Small" Color="@GetEntryTypeColor(context.Item)" Variant="Variant.Outlined"
                                     Icon="@(context.Item.TemporaryExitStatus == TemporaryExitStatus.Pending ? Icons.Material.Filled.Warning : Icons.Material.Filled.ExitToApp)">
                                @context.Item.EntryType
                                @if (context.Item.AssignedDate.HasValue)
                                {
                                    <span class="ml-1" style="font-size: 0.8rem; opacity: 0.8;">(@context.Item.AssignedDate.Value.ToString("dd/MM"))</span>
                                }
                            </MudChip>
                        </MudTooltip>
                    }
                    else if (context.Item.IsTemporaryExitReturn)
                    {
                        var statusLabel = GetExitStatusLabel(context.Item.TemporaryExitStatus);
                        var tooltip = $"Regreso de salida ({context.Item.TemporaryExitMinutes} min) — {statusLabel}";
                        <MudTooltip Text="@tooltip">
                            <MudChip T="string" Size="Size.Small" Color="@GetEntryTypeColor(context.Item)" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.KeyboardReturn">
                                @context.Item.EntryType
                                @if (context.Item.AssignedDate.HasValue)
                                {
                                    <span class="ml-1" style="font-size: 0.8rem; opacity: 0.8;">(@context.Item.AssignedDate.Value.ToString("dd/MM"))</span>
                                }
                            </MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="@GetEntryTypeColor(context.Item)" Variant="Variant.Text">
                            @context.Item.EntryType
                            @if (context.Item.AssignedDate.HasValue)
                            {
                                <span class="ml-1" style="font-size: 0.8rem; opacity: 0.8;">(@context.Item.AssignedDate.Value.ToString("dd/MM"))</span>
                            }
                        </MudChip>
                    }
                    @if (_canAdjust)
                    {
                    <MudMenu Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Dense="true">
                        @if (context.Item.IsSplitShift)
                        {
                            <MudMenuItem OnClick="@(() => AssignLog(context.Item, "Entrada"))">Asignar como Entrada (B1)</MudMenuItem>
                            <MudMenuItem OnClick="@(() => AssignLog(context.Item, "Salida B1"))">Asignar como Salida B1</MudMenuItem>
                            <MudMenuItem OnClick="@(() => AssignLog(context.Item, "Entrada B2"))">Asignar como Entrada B2</MudMenuItem>
                            <MudMenuItem OnClick="@(() => AssignLog(context.Item, "Salida"))">Asignar como Salida (B2)</MudMenuItem>
                        }
                        else
                        {
                            <MudMenuItem OnClick="@(() => AssignLog(context.Item, "Entrada"))">Asignar como Entrada</MudMenuItem>
                            <MudMenuItem OnClick="@(() => AssignLog(context.Item, "Salida"))">Asignar como Salida</MudMenuItem>
                        }
                        <MudMenuItem OnClick="@(() => AssignLog(context.Item, "None"))">Desasignar (dejar vacío)</MudMenuItem>
                        <MudMenuItem OnClick="@(() => AssignLog(context.Item, "Restaurar"))">Restaurar cálculo automático</MudMenuItem>

                        <MudDivider Class="my-1" />

                        @* Clasificación de salidas temporales e intermedias por RH (Caso 11) *@
                        <MudMenuItem Icon="@Icons.Material.Filled.Restaurant"
                                     OnClick="@(() => ClassifyTemporaryExit(context.Item, TemporaryExitStatus.Lunch))">
                            Clasificar como Comida
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.CheckCircle"
                                     OnClick="@(() => ClassifyTemporaryExit(context.Item, TemporaryExitStatus.ApprovedPaid))">
                            Clasificar como Permiso con goce
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.RemoveCircle"
                                     OnClick="@(() => ClassifyTemporaryExit(context.Item, TemporaryExitStatus.ApprovedUnpaid))">
                            Clasificar como Permiso sin goce
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Cancel"
                                     OnClick="@(() => ClassifyTemporaryExit(context.Item, TemporaryExitStatus.Dismissed))">
                            Clasificar como Error de checada
                        </MudMenuItem>

                        @if (context.Item.IsTemporaryExit && context.Item.TemporaryExitStatus != (context.Item.IsAutomaticLunch ? TemporaryExitStatus.Lunch : TemporaryExitStatus.Pending))
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Undo"
                                         OnClick="@(() => ClassifyTemporaryExit(context.Item, null))">
                                Quitar clasificación (Restaurar)
                            </MudMenuItem>
                        }

                        @if (_canViewHistory)
                        {
                            <MudDivider Class="my-1" />
                            <MudMenuItem Icon="@Icons.Material.Filled.History"
                                         OnClick="@(() => OpenHistoryForRecord(context.Item))">
                                Ver historial del día
                            </MudMenuItem>
                        }
                    </MudMenu>
                    }
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.VerifyMethod" Title="Método" />
        <PropertyColumn Property="x => x.DeviceName" Title="Dispositivo" />
        <PropertyColumn Property="x => x.Status" Title="Estado (Procesamiento)" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="AttendanceLogViewDto" />
    </PagerContent>
</MudDataGrid>

@code {
    private DateTime? SelectedDate = DateTime.Today;
    private EmployeeDto? SelectedEmployeeObj;

    private List<AttendanceLogViewDto> LogsList = new();
    
    // Cache for autocomplete
    private List<EmployeeDto> _allEmployees = new();
    private bool _canAdjust;
    private bool _canViewHistory;
    private DayAdjustmentStateDto? _dayState;

    protected override async Task OnInitializedAsync()
    {
        _canAdjust = await UiPermissions.HasAsync(Permissions.AttendanceAdjust);
        _canViewHistory = await UiPermissions.HasAsync(Permissions.AttendanceViewHistory);
        var result = await Mediator.Send(new GetAllEmployeesQuery());
        if (result.IsSuccess)
        {
            _allEmployees = result.Value.OrderBy(e => e.FullName).ToList();
        }
        
        await LoadData();
    }

    private Task<IEnumerable<EmployeeDto>> SearchEmployees(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrEmpty(value))
        {
            return Task.FromResult<IEnumerable<EmployeeDto>>(_allEmployees);
        }

        var result = _allEmployees.Where(e => 
            e.Id.Contains(value, StringComparison.InvariantCultureIgnoreCase) || 
            e.FullName.Contains(value, StringComparison.InvariantCultureIgnoreCase)
        );
        
        return Task.FromResult(result);
    }

    private Color GetEntryTypeColor(AttendanceLogViewDto item)
    {
        if (item.IsTemporaryExit)
        {
            return item.TemporaryExitStatus switch
            {
                TemporaryExitStatus.Lunch => Color.Tertiary,
                TemporaryExitStatus.ApprovedPaid => Color.Success,
                TemporaryExitStatus.ApprovedUnpaid => Color.Error,
                TemporaryExitStatus.Dismissed => Color.Dark,
                _ => Color.Warning
            };
        }

        if (item.IsTemporaryExitReturn)
        {
            return Color.Info;
        }

        return item.EntryType switch
        {
            "Entrada" or "Entrada B1" or "Entrada B2" => Color.Success,
            "Salida" or "Salida B1" or "Salida B2" => Color.Info,
            _ => Color.Default
        };
    }

    private static string GetExitStatusLabel(TemporaryExitStatus? status) => status switch
    {
        TemporaryExitStatus.Lunch => "Comida",
        TemporaryExitStatus.ApprovedPaid => "Con goce",
        TemporaryExitStatus.ApprovedUnpaid => "Sin goce",
        TemporaryExitStatus.Dismissed => "Error de checada",
        _ => "Pendiente"
    };

    private async Task ClassifyTemporaryExit(AttendanceLogViewDto record, TemporaryExitStatus? status)
    {
        string? reason = null;
        if (status != null)
        {
            var actionLabel = status switch
            {
                TemporaryExitStatus.Lunch => "comida",
                TemporaryExitStatus.ApprovedPaid => "permiso con goce",
                TemporaryExitStatus.ApprovedUnpaid => "permiso sin goce",
                TemporaryExitStatus.Dismissed => "error de checada",
                _ => "salida temporal"
            };
            reason = await ReasonDialog.AskAsync(
                DialogService,
                $"Clasificar como {actionLabel}",
                $"Marcaje de las {record.CheckTime:HH:mm} ({record.EmployeeName})");
            if (reason == null) return;
        }

        var targetDate = DateOnly.FromDateTime(record.AssignedDate ?? SelectedDate ?? record.CheckTime);
        var command = new ClassifyTemporaryExitCommand(
            record.EmployeeId,
            targetDate,
            record.Id,
            status,
            Note: reason,
            ExpectedRevision: record.DayRevision ?? (SelectedEmployeeObj?.Id == record.EmployeeId ? _dayState?.Revision : null));

        var result = await Mediator.Send(command);
        ShowDecision(result);
        await LoadData();
    }

    private Task OpenHistoryForRecord(AttendanceLogViewDto record)
    {
        var date = DateOnly.FromDateTime(record.AssignedDate ?? SelectedDate ?? record.CheckTime);
        return AttendanceHistoryDialog.ShowAsync(DialogService, record.EmployeeId, record.EmployeeName, date);
    }

    private async Task OpenManualLogDialog()
    {
        if (SelectedEmployeeObj == null || SelectedDate == null) return;

        var parameters = new DialogParameters<ManualLogDialog>
        {
            { x => x.Values, new ManualLogDialog.ManualLogCallbackValues(SelectedEmployeeObj.FullName, DateOnly.FromDateTime(SelectedDate.Value)) }
        };

        var dialog = await DialogService.ShowAsync<ManualLogDialog>("Registro Manual", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is ManualLogDialog.ManualLogResult logResult)
        {
            await CreateManualLog(logResult.DateTime, logResult.Reason);
        }
    }

    private async Task CreateManualLog(DateTime dateTime, string reason)
    {
        if (SelectedEmployeeObj == null) return;

        try
        {
            var command = new RegisterManualAttendanceCommand(
                SelectedEmployeeObj.Id,
                dateTime,
                Reason: reason);

            var result = await Mediator.Send(command);

            if (result.IsSuccess)
            {
                Snackbar.Add("Registro manual agregado correctamente", Severity.Success);

                try
                {
                    await Mediator.Send(new ProcessDailyAttendanceCommand(
                        dateTime.Date,
                        dateTime.Date,
                        EmployeeId: EmployeeId.From(SelectedEmployeeObj.Id)));
                    Snackbar.Add("Asistencia recalculada correctamente", Severity.Info);
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Error al recalcular asistencia: {ex.Message}", Severity.Warning);
                }

                await LoadData();
            }
            else
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenChangeShiftDialog()
    {
        if (SelectedEmployeeObj == null || SelectedDate == null) return;

        var shiftResult = await Mediator.Send(new GetShiftsQuery());
        if (!shiftResult.IsSuccess)
        {
            Snackbar.Add("Error cargando horarios", Severity.Error);
            return;
        }
        
        var shifts = shiftResult.Value.ToList();
        
        var parameters = new DialogParameters<ChangeShiftDialog>
        {
            { x => x.Values, new ChangeShiftDialog.ChangeShiftCallbackValues(SelectedEmployeeObj.FullName, DateOnly.FromDateTime(SelectedDate.Value)) },
            { "Shifts", shifts } 
        };

        var dialog = await DialogService.ShowAsync<ChangeShiftDialog>("Cambiar Horario", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is Guid shiftId)
        {
            await UpdateDailyShift(shiftId);
        }
    }

    private async Task UpdateDailyShift(Guid shiftId)
    {
         if (SelectedEmployeeObj == null || SelectedDate == null) return;

         var command = new UpdateDailyShiftCommand(
             SelectedEmployeeObj.Id,
             DateOnly.FromDateTime(SelectedDate.Value),
             shiftId);

         var result = await Mediator.Send(command);

         if (result.IsSuccess)
         {
             Snackbar.Add("Horario actualizado correctamente", Severity.Success);
             await LoadData();
         }
         else
         {
             Snackbar.Add(result.Error, Severity.Error);
         }
    }

    private async Task AssignLog(AttendanceLogViewDto record, string type)
    {
        // Caso 13: asignar y desasignar exigen motivo; restaurar no.
        string? reason = null;
        if (type != "Restaurar")
        {
            reason = await ReasonDialog.AskAsync(DialogService, type == "None" ? "Desasignar marcaje" : $"Asignar como {type}",
                $"Marcaje de las {record.CheckTime:HH:mm}");
            if (reason == null) return;
        }

        // La decisión se toma sobre la jornada que se está consultando (CheckTime es UTC y podría caer en otro día).
        var command = new ManuallyAssignAttendanceCommand(
            record.EmployeeId,
            DateOnly.FromDateTime(SelectedDate ?? record.CheckTime),
            record.Id.ToString(),
            type,
            ExpectedRevision: SelectedEmployeeObj?.Id == record.EmployeeId ? _dayState?.Revision : null,
            Reason: reason);

        var result = await Mediator.Send(command);
        ShowDecision(result);
        await LoadData();
    }

    private async Task LoadData()
    {
        if (SelectedDate == null) return;

        var employeeId = SelectedEmployeeObj?.Id ?? string.Empty;

        var result = await Mediator.Send(new GetAttendanceLogsQuery(SelectedDate.Value, employeeId));
        LogsList = result.ToList();

        _dayState = SelectedEmployeeObj != null
            ? await Mediator.Send(new GetDayAdjustmentStateQuery(SelectedEmployeeObj.Id, DateOnly.FromDateTime(SelectedDate.Value)))
            : null;
    }

    private Task OpenHistory() =>
        SelectedEmployeeObj == null || SelectedDate == null
            ? Task.CompletedTask
            : AttendanceHistoryDialog.ShowAsync(DialogService, SelectedEmployeeObj.Id, SelectedEmployeeObj.FullName, DateOnly.FromDateTime(SelectedDate.Value));

    private async Task ClearShiftOverride()
    {
        if (SelectedEmployeeObj == null || SelectedDate == null) return;
        ShowDecision(await Mediator.Send(new ClearDailyShiftOverrideCommand(SelectedEmployeeObj.Id, DateOnly.FromDateTime(SelectedDate.Value), ExpectedRevision: _dayState?.Revision)));
        await LoadData();
    }

    private async Task ClearRestDayOverride()
    {
        if (SelectedEmployeeObj == null || SelectedDate == null) return;
        ShowDecision(await Mediator.Send(new ClearDailyRestDayOverrideCommand(SelectedEmployeeObj.Id, DateOnly.FromDateTime(SelectedDate.Value), ExpectedRevision: _dayState?.Revision)));
        await LoadData();
    }

    /// <summary>
    /// Caso 13: si otra persona cambió el día mientras se veía, la decisión se rechaza; se avisa y la pantalla se recarga
    /// con los datos actuales para revisar y volver a aplicar.
    /// </summary>
    private void ShowDecision(Result<AttendanceDecisionOutcome> result)
    {
        if (result.IsSuccess)
            Snackbar.Add(result.Value.UserMessage, result.Value.Consolidated ? Severity.Success : Severity.Warning);
        else if (IsConcurrencyConflict(result.Error))
            Snackbar.Add("Este día fue modificado por otra persona; se recargó con los datos actuales. Revise y vuelva a aplicar.", Severity.Warning);
        else
            Snackbar.Add(result.Error, Severity.Error);
    }

    private static bool IsConcurrencyConflict(string error) =>
        error.Contains("mientras se editaba", StringComparison.OrdinalIgnoreCase);

    private async Task ExportToExcel()
    {
        try
        {
            if (!LogsList.Any()) return;

            var bytes = ExportService.GenerateAttendanceLogsExcel(LogsList);
            var fileName = $"Logs_Asistencia_{SelectedDate?.ToString("yyyyMMdd") ?? DateTime.Now.ToString("yyyyMMdd")}.xlsx";
            
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar: {ex.Message}", Severity.Error);
        }
    }
}
