@page "/departments"
@using MediatR
@using AttendanceSystem.Application.DTOs
@using AttendanceSystem.Application.Features.Departments.Queries.GetDepartments
@using AttendanceSystem.Application.Features.Departments.Commands.CreateDepartment
@using AttendanceSystem.Application.Features.Departments.Commands.UpdateDepartment
@using AttendanceSystem.Application.Features.Departments.Commands.DeleteDepartment
@inject ISender Sender
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IReportExportService ExportService
@using Microsoft.JSInterop
@using System.IO

<PageTitle>Departamentos</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Departamentos</MudText>

<MudGrid Spacing="2" Class="mb-4">
    <MudItem xs="12" sm="6" md="4">
        <MudTextField @bind-Value="_searchString" Label="Buscar" Placeholder="Buscar departamentos..." 
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary"
                      Clearable="true" Immediate="true" />
    </MudItem>
    <MudItem xs="12" Class="d-flex flex-wrap align-center justify-end gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Upload" OnClick="ImportDepartments">Importar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportToExcel">Exportar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">Nuevo Departamento</MudButton>
    </MudItem>
</MudGrid>

<MudTable Items="@_departments" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Loading="@_loading" Filter="new Func<DepartmentDto,bool>(FilterFunc)" Class="mt-2">
    <HeaderContent>
        <MudTh>Nombre</MudTh>
        <MudTh>Descripción</MudTh>
        <AuthorizeView Roles="Administrador" Context="authContext">
            <MudTh>Acciones</MudTh>
        </AuthorizeView>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nombre">@context.Name</MudTd>
        <MudTd DataLabel="Descripción">@context.Description</MudTd>
        <AuthorizeView Roles="Administrador" Context="authContext">
            <MudTd DataLabel="Acciones">
                <MudTooltip Text="Editar">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" OnClick="@(() => OpenEditDialog(context))" Size="Size.Small" />
                </MudTooltip>
                <MudTooltip Text="Eliminar">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteDepartment(context))" Size="Size.Small" />
                </MudTooltip>
            </MudTd>
        </AuthorizeView>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    private IEnumerable<DepartmentDto> _departments = new List<DepartmentDto>();
    private bool _loading = true;
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDepartments();
    }

    private async Task LoadDepartments()
    {
        _loading = true;
        var result = await Sender.Send(new GetDepartmentsQuery());
        if (result.IsSuccess)
        {
            _departments = result.Value;
        }
        else
        {
            Snackbar.Add($"Error al cargar departamentos: {result.Error}", Severity.Error);
        }
        _loading = false;
    }

    private bool FilterFunc(DepartmentDto department)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;
        if (department.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (department.Description?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        return false;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        
        var dialog = await DialogService.ShowAsync<DepartmentDialog>("Nuevo Departamento", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateDepartmentCommand command)
        {
             var createResult = await Sender.Send(command);
             if (createResult.IsSuccess)
             {
                 Snackbar.Add("Departamento creado correctamente", Severity.Success);
                 await LoadDepartments();
             }
             else
             {
                 Snackbar.Add($"Error al crear: {createResult.Error}", Severity.Error);
             }
        }
    }

    private async Task OpenEditDialog(DepartmentDto department)
    {
        var parameters = new DialogParameters
        {
            { "DepartmentId", department.Id },
            { "Name", department.Name },
            { "Description", department.Description }
        };
        
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        
        var dialog = await DialogService.ShowAsync<DepartmentDialog>("Editar Departamento", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is UpdateDepartmentCommand command)
        {
             var updateResult = await Sender.Send(command);
             if (updateResult.IsSuccess)
             {
                 Snackbar.Add("Departamento actualizado correctamente", Severity.Success);
                 await LoadDepartments();
             }
             else
             {
                 Snackbar.Add($"Error al actualizar: {updateResult.Error}", Severity.Error);
             }
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            var bytes = ExportService.GenerateDepartmentsExcel(_departments);
            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Departamentos_{DateTime.Now:yyyyMMdd}.xlsx", streamRef);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al exportar: {ex.Message}", Severity.Error);
        }
    }

    private async Task ImportDepartments()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ImportDepartmentsDialog>("Importar Departamentos", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadDepartments();
        }
    }

    private async Task DeleteDepartment(DepartmentDto department)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"¿Estás seguro de que quieres eliminar el departamento '{department.Name}'? Esta acción no se puede deshacer." },
            { "ButtonText", "Eliminar" },
            { "Color", Color.Error }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Eliminar Departamento", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            var deleteResult = await Sender.Send(new DeleteDepartmentCommand(department.Id));
            if (deleteResult.IsSuccess)
            {
                Snackbar.Add("Departamento eliminado correctamente", Severity.Success);
                await LoadDepartments();
            }
            else
            {
                Snackbar.Add($"Error al eliminar: {deleteResult.Error}", Severity.Error);
            }
        }
    }
}
