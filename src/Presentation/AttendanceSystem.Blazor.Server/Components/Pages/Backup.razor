@page "/backup"
@attribute [Authorize(Roles = "Administrador")]
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using AttendanceSystem.Application.Features.Backup.Commands
@using AttendanceSystem.Application.Features.Backup.Queries
@using AttendanceSystem.Application.Features.Configuration.Queries.GetSystemConfiguration
@using AttendanceSystem.Application.DTOs
@using MediatR
@using MudBlazor
@using AttendanceSystem.Blazor.Server.Components
@using AttendanceSystem.Blazor.Server.Components.Dialogs
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Respaldo y Restauración</PageTitle>


<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.Backup" Class="mr-2" />
        Respaldo y Restauración
    </MudText>

    <MudGrid>
        <!-- Panel de Acciones -->
        <MudItem xs="12" md="4">
            <!-- Base de Datos Activa -->
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Storage" Class="mr-2" Color="Color.Primary" />
                            Base de Datos Activa
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_dbInfo != null)
                    {
                        <MudStack Spacing="2">
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Servidor:</MudText>
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@_dbInfo.Host</MudText>
                            </div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Puerto:</MudText>
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@_dbInfo.Port</MudText>
                            </div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Base de Datos:</MudText>
                                <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Primary">@_dbInfo.Database</MudText>
                            </div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Usuario:</MudText>
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@_dbInfo.Username</MudText>
                            </div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Motor:</MudText>
                                <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Info">@_dbInfo.Engine</MudText>
                            </div>
                        </MudStack>
                    }
                    else
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                </MudCardContent>
            </MudCard>

            <!-- Directorio de Respaldos -->
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Directorio de Almacenamiento</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="3">
                        <div class="d-flex align-center gap-2">
                            <MudTextField @bind-Value="_backupDirectory"
                                          Label="Directorio en el Servidor"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Placeholder="Backups"
                                          Disabled="_isSavingDirectory || _isCreatingBackup || _isUploadingBackup || _isRestoring" />
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.FolderOpen"
                                       OnClick="OpenFolderPicker"
                                       Disabled="_isSavingDirectory || _isCreatingBackup || _isUploadingBackup || _isRestoring">
                                Explorar
                            </MudButton>
                        </div>

                        <MudAlert Severity="Severity.Info" Dense="true">
                            Asegúrese de que el servicio tenga permisos de lectura y escritura en esta ruta.
                        </MudAlert>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SaveBackupDirectory"
                                   Disabled="_isSavingDirectory || _isCreatingBackup || _isUploadingBackup || _isRestoring">
                            @if (_isSavingDirectory)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar Directorio</span>
                            }
                        </MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Crear Respaldo</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="3">
                        <MudTextField @bind-Value="_backupDescription"
                                      Label="Descripción (opcional)"
                                      Variant="Variant.Outlined"
                                      Lines="3" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudDownload"
                                   FullWidth="true"
                                   OnClick="CreateFullBackup"
                                   Disabled="_isCreatingBackup || _isUploadingBackup">
                            @if (_isCreatingBackup)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Creando respaldo completo...</span>
                            }
                            else
                            {
                                <span>Respaldo Completo</span>
                            }
                        </MudButton>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Storage"
                                   FullWidth="true"
                                   OnClick="CreateDatabaseBackup"
                                   Disabled="_isCreatingBackup || _isUploadingBackup">
                            Solo Base de Datos
                        </MudButton>

                        <MudDivider />

                        <MudAlert Severity="Severity.Info" Dense="true">
                            <strong>Respaldo Completo:</strong> Incluye base de datos y configuración.<br />
                            <strong>Solo BD:</strong> Solo respaldo de base de datos.
                        </MudAlert>
                    </MudStack>
                </MudCardContent>
            </MudCard>

            <!-- Cargar Respaldo desde Máquina Local -->
            <MudCard Elevation="2" Class="mt-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Cargar Respaldo al Servidor</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Suba un archivo de respaldo (.zip, .backup, .bak) desde su equipo para almacenarlo o restaurarlo en el servidor.
                        </MudText>

                        <MudFileUpload T="IBrowserFile"
                                       FilesChanged="UploadBackupFile"
                                       Accept=".zip,.backup,.bak"
                                       Disabled="_isUploadingBackup || _isCreatingBackup">
                            <CustomContent>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.CloudUpload"
                                           FullWidth="true"
                                           OnClick="@context.OpenFilePickerAsync"
                                           Disabled="_isUploadingBackup || _isCreatingBackup">
                                    @if (_isUploadingBackup)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        <span>Cargando archivo...</span>
                                    }
                                    else
                                    {
                                        <span>Seleccionar y Cargar Archivo</span>
                                    }
                                </MudButton>
                            </CustomContent>
                        </MudFileUpload>

                        @if (_isUploadingBackup)
                        {
                            <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="my-2" />
                            <MudText Typo="Typo.caption" Align="Align.Center">
                                Enviando y validando el archivo en el servidor...
                            </MudText>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>

            <!-- Información del Sistema -->
            <MudCard Elevation="2" Class="mt-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Información</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.body2">
                            <strong>Total de respaldos:</strong> @_backups.Count()
                        </MudText>
                        <MudText Typo="Typo.body2">
                            <strong>Espacio usado:</strong> @FormatBytes(_backups.Sum(b => b.SizeInBytes))
                        </MudText>
                        <MudText Typo="Typo.body2">
                            <strong>Último respaldo:</strong> @(_backups.Any() ? _backups.First().CreatedAt.ToString("dd/MM/yyyy HH:mm") : "N/A")
                        </MudText>
                        <MudText Typo="Typo.body2">
                            <strong>Retención automática:</strong> Últimos @_retentionLimit respaldos
                        </MudText>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Lista de Respaldos -->
        <MudItem xs="12" md="8">
            <!-- Panel de Progreso y Logs de Restauración en Vivo -->
            @if (_showRestoreProgress)
            {
                <MudCard Elevation="4" Class="mb-4 rounded-lg border-solid border-2 border-primary">
                    <MudCardHeader Class="pb-2">
                        <CardHeaderAvatar>
                            @if (_isRestoring)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                            }
                            else if (_restoreStage == RestoreStage.Completed)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" />
                            }
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">
                                Restauración en Vivo: @_currentRestoringFile
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Estado: <span class="font-weight-bold" style="@(_restoreStage == RestoreStage.Failed ? "color: var(--mud-palette-error);" : (_restoreStage == RestoreStage.Completed ? "color: var(--mud-palette-success);" : "color: var(--mud-palette-primary);"))">@_restoreStatusText</span>
                            </MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (!_isRestoring)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="() => _showRestoreProgress = false" title="Cerrar panel de progreso" />
                            }
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent Class="pt-0">
                        <!-- Barra de Progreso Linear -->
                        <MudProgressLinear Color="@GetProgressColor()"
                                           Value="@_restorePercentage"
                                           Indeterminate="@(_isRestoring && _restoreStage == RestoreStage.ExecutingPgRestore)"
                                           Striped="true"
                                           Size="Size.Medium"
                                           Class="my-3 rounded" />

                        <!-- MudTimeline de Etapas de Restauración -->
                        <MudTimeline TimelineOrientation="TimelineOrientation.Horizontal" TimelinePosition="TimelinePosition.Top" Class="my-4">
                            <MudTimelineItem Color="@GetStageColor(RestoreStage.SafetySnapshot)" Variant="Variant.Filled">
                                <ItemOpposite>
                                    <MudText Typo="Typo.caption" Class="font-weight-bold">Paso 1</MudText>
                                </ItemOpposite>
                                <ItemContent>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">Snapshot Previo</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Respaldo rollback</MudText>
                                </ItemContent>
                            </MudTimelineItem>
                            <MudTimelineItem Color="@GetStageColor(RestoreStage.PreparingDatabase)" Variant="Variant.Filled">
                                <ItemOpposite>
                                    <MudText Typo="Typo.caption" Class="font-weight-bold">Paso 2</MudText>
                                </ItemOpposite>
                                <ItemContent>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">Preparación BD</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Limpieza esquemas</MudText>
                                </ItemContent>
                            </MudTimelineItem>
                            <MudTimelineItem Color="@GetStageColor(RestoreStage.ExecutingPgRestore)" Variant="Variant.Filled">
                                <ItemOpposite>
                                    <MudText Typo="Typo.caption" Class="font-weight-bold">Paso 3</MudText>
                                </ItemOpposite>
                                <ItemContent>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">pg_restore</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Streaming objetos</MudText>
                                </ItemContent>
                            </MudTimelineItem>
                            <MudTimelineItem Color="@GetStageColor(RestoreStage.Finalizing)" Variant="Variant.Filled">
                                <ItemOpposite>
                                    <MudText Typo="Typo.caption" Class="font-weight-bold">Paso 4</MudText>
                                </ItemOpposite>
                                <ItemContent>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">Finalización</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Reanudación tareas</MudText>
                                </ItemContent>
                            </MudTimelineItem>
                        </MudTimeline>

                        <!-- Consola de Logs en Vivo -->
                        <div class="d-flex justify-space-between align-center mt-3 mb-1">
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                                <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Small" Class="mr-1" />
                                Consola de Salida en Vivo (@_liveLogs.Count líneas)
                            </MudText>
                            <div>
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyLogsToClipboard">
                                    Copiar Logs
                                </MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearLogs">
                                    Limpiar
                                </MudButton>
                            </div>
                        </div>

                        <div id="restoreLogContainer" style="background-color: #0f172a; color: #4ade80; font-family: 'Consolas', 'Courier New', monospace; font-size: 0.82rem; height: 230px; overflow-y: scroll; padding: 12px; border-radius: 6px; border: 1px solid #1e293b;">
                            @if (!_liveLogs.Any())
                            {
                                <span style="color: #64748b;">Esperando mensajes del proceso de pg_restore...</span>
                            }
                            else
                            {
                                @foreach (var log in _liveLogs)
                                {
                                    <div style="white-space: pre-wrap; line-height: 1.4; @(log.IsError ? "color: #f87171;" : "")">
                                        <span style="color: #94a3b8;">[@log.Timestamp.ToString("HH:mm:ss")]</span> @log.Message
                                    </div>
                                }
                            }
                        </div>
                    </MudCardContent>
                </MudCard>
            }

            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Respaldos Disponibles</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Primary"
                                       OnClick="LoadBackups"
                                       Disabled="_isLoading" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    @if (_isLoading)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (!_backups.Any())
                    {
                        <MudAlert Severity="Severity.Info">
                            No hay respaldos disponibles. Cree un respaldo o cargue uno desde su máquina usando el panel de la izquierda.
                        </MudAlert>
                    }
                    else
                    {
                        <MudTable Items="_backups"
                                  Hover="true"
                                  Breakpoint="Breakpoint.Sm"
                                  Dense="true">
                            <HeaderContent>
                                <MudTh>Archivo</MudTh>
                                <MudTh>Tipo</MudTh>
                                <MudTh>Tamaño</MudTh>
                                <MudTh>Fecha</MudTh>
                                <MudTh>Acciones</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Archivo">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2">@context.FileName</MudText>
                                        @if (!string.IsNullOrEmpty(context.Description))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Description</MudText>
                                        }
                                    </MudStack>
                                </MudTd>
                                <MudTd DataLabel="Tipo">
                                    <MudBadge Color="@(context.BackupType == "Full" ? Color.Primary : Color.Secondary)">
                                        @context.BackupType
                                    </MudBadge>
                                </MudTd>
                                <MudTd DataLabel="Tamaño">
                                    @FormatBytes(context.SizeInBytes)
                                </MudTd>
                                <MudTd DataLabel="Fecha">
                                    @context.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </MudTd>
                                <MudTd DataLabel="Acciones">
                                    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                                        <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                       Color="Color.Info"
                                                       Size="Size.Small"
                                                       OnClick="@(() => DownloadBackup(context))"
                                                       title="Descargar a mi equipo" />
                                        <MudIconButton Icon="@(_isRestoring ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.RestorePage)"
                                                       Color="Color.Success"
                                                       Size="Size.Small"
                                                       Disabled="@_isRestoring"
                                                       OnClick="@(() => RestoreBackup(context))"
                                                       title="@(_isRestoring ? "Restaurando..." : "Restaurar")" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => DeleteBackup(context))"
                                                       title="Eliminar" />
                                    </MudButtonGroup>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudCardContent>
            </MudCard>

            <!-- Advertencias -->
            <MudCard Elevation="2" Class="mt-4">
                <MudCardContent>
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        <strong>⚠️ Importante:</strong>
                        <ul class="my-2">
                            <li>La restauración sobrescribirá todos los datos actuales</li>
                            <li>Se recomienda crear o descargar un respaldo antes de restaurar</li>
                            <li>La aplicación debe reiniciarse después de una restauración</li>
                            <li>Asegúrese de que no haya usuarios conectados durante la restauración</li>
                        </ul>
                    </MudAlert>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private IEnumerable<BackupDto> _backups = Enumerable.Empty<BackupDto>();
    private bool _isLoading = false;
    private bool _isCreatingBackup = false;
    private bool _isUploadingBackup = false;
    private bool _isRestoring = false;
    private string _backupDescription = string.Empty;
    private string _backupDirectory = "Backups";
    private bool _isSavingDirectory = false;
    private DatabaseConnectionInfoDto? _dbInfo;
    private int _retentionLimit = 10;

    // Estado del seguimiento de restauración en vivo
    private bool _showRestoreProgress = false;
    private string _currentRestoringFile = string.Empty;
    private RestoreStage _restoreStage = RestoreStage.NotStarted;
    private RestoreStage _failedAtStage = RestoreStage.NotStarted;
    private int _restorePercentage = 0;
    private string _restoreStatusText = string.Empty;
    private readonly List<RestoreLogEntry> _liveLogs = new();

    private class RestoreLogEntry
    {
        public DateTime Timestamp { get; set; } = DateTime.Now;
        public string Message { get; set; } = string.Empty;
        public bool IsError { get; set; }
    }

    private Color GetStageColor(RestoreStage stage)
    {
        if (_restoreStage == RestoreStage.Failed)
        {
            return _failedAtStage == stage ? Color.Error : (_restoreStage > stage ? Color.Success : Color.Default);
        }

        if (_restoreStage == stage)
        {
            return Color.Primary;
        }

        if (_restoreStage > stage || _restoreStage == RestoreStage.Completed)
        {
            return Color.Success;
        }

        return Color.Default;
    }

    private Color GetProgressColor()
    {
        if (_restoreStage == RestoreStage.Failed) return Color.Error;
        if (_restoreStage == RestoreStage.Completed) return Color.Success;
        return Color.Primary;
    }

    private async Task CopyLogsToClipboard()
    {
        if (!_liveLogs.Any()) return;
        var fullText = string.Join(Environment.NewLine, _liveLogs.Select(l => $"[{l.Timestamp:HH:mm:ss}] {l.Message}"));
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", fullText);
            Snackbar.Add("Logs copiados al portapapeles", Severity.Success);
        }
        catch
        {
            Snackbar.Add("No se pudo copiar automáticamente al portapapeles", Severity.Warning);
        }
    }

    private void ClearLogs()
    {
        _liveLogs.Clear();
    }


    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadBackups(), LoadDirectoryConfig(), LoadDbInfo());
    }

    private async Task LoadDbInfo()
    {
        try
        {
            _dbInfo = await Mediator.Send(new GetDatabaseConnectionInfoQuery());
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar información de la base de datos: {ex.Message}", Severity.Warning);
        }
    }

    private async Task LoadDirectoryConfig()
    {
        try
        {
            var configResult = await Mediator.Send(new GetSystemConfigurationQuery());
            if (configResult.IsSuccess && configResult.Value != null)
            {
                _backupDirectory = configResult.Value.BackupDirectory;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar configuración de directorio: {ex.Message}", Severity.Warning);
        }
    }


    private async Task SaveBackupDirectory()
    {
        if (string.IsNullOrWhiteSpace(_backupDirectory))
        {
            Snackbar.Add("El directorio de respaldos no puede estar vacío.", Severity.Warning);
            return;
        }

        _isSavingDirectory = true;
        try
        {
            var command = new UpdateBackupDirectoryCommand(_backupDirectory);
            var result = await Mediator.Send(command);

            if (result.IsSuccess)
            {
                Snackbar.Add("Directorio de respaldos actualizado exitosamente.", Severity.Success);
                await LoadBackups();
            }
            else
            {
                Snackbar.Add($"Error al actualizar directorio: {result.Error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error inesperado: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSavingDirectory = false;
        }
    }

    private async Task OpenFolderPicker()
    {
        var parameters = new DialogParameters<FolderPickerDialog>
        {
            { x => x.InitialPath, _backupDirectory }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<FolderPickerDialog>("Seleccionar Directorio de Almacenamiento", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is string selectedPath)
        {
            _backupDirectory = selectedPath;
            Snackbar.Add("Carpeta seleccionada. Haga clic en 'Guardar Directorio' para aplicar.", Severity.Info);
        }
    }

    private async Task LoadBackups()
    {
        _isLoading = true;
        try
        {
            var query = new GetBackupsQuery();
            _backups = await Mediator.Send(query);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar respaldos: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateFullBackup()
    {
        _isCreatingBackup = true;
        try
        {
            var command = new CreateBackupCommand("Full", _backupDescription);
            var result = await Mediator.Send(command);

            if (result.Success)
            {
                Snackbar.Add($"Respaldo creado exitosamente: {Path.GetFileName(result.BackupFilePath ?? "")}", Severity.Success);
                _backupDescription = string.Empty;
                await LoadBackups();
            }
            else
            {
                Snackbar.Add($"Error al crear respaldo: {result.Message}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error inesperado: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCreatingBackup = false;
        }
    }

