    private async Task RestoreBackup(BackupDto backup)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"¿Está seguro de que desea restaurar el respaldo '{backup.FileName}'? Esta acción sobrescribirá todos los datos actuales y la aplicación deberá reiniciarse.",
            ["ButtonText"] = "Restaurar",
            ["Color"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Confirmar Restauración", parameters);
        var dialogResult = await dialog.Result;

        if (dialogResult is not null && !dialogResult.Canceled)
        {
            _isRestoring = true;
            _showRestoreProgress = true;
            _currentRestoringFile = backup.FileName;
            _restoreStage = RestoreStage.SafetySnapshot;
            _failedAtStage = RestoreStage.NotStarted;
            _restorePercentage = 5;
            _restoreStatusText = "Iniciando proceso de restauración...";
            _liveLogs.Clear();
            await InvokeAsync(StateHasChanged);

            try
            {
                Snackbar.Add("Iniciando restauración... Puede seguir el avance en el panel en vivo.", Severity.Info);

                var progressReporter = new Progress<RestoreProgressReport>(report =>
                {
                    _restoreStage = report.Stage;
                    if (!string.IsNullOrWhiteSpace(report.StageTitle))
                    {
                        _restoreStatusText = report.StageTitle;
                    }
                    if (report.ProgressPercentage.HasValue)
                    {
                        _restorePercentage = report.ProgressPercentage.Value;
                    }
                    if (!string.IsNullOrWhiteSpace(report.LogLine))
                    {
                        _liveLogs.Add(new RestoreLogEntry
                        {
                            Timestamp = report.EventTime,
                            Message = report.LogLine,
                            IsError = report.IsError
                        });

                        if (_liveLogs.Count > 1000)
                        {
                            _liveLogs.RemoveAt(0);
                        }
                    }
                    if (report.IsError)
                    {
                        _failedAtStage = report.Stage;
                    }

                    _ = InvokeAsync(() =>
                    {
                        StateHasChanged();
                        _ = JSRuntime.InvokeVoidAsync("eval", "var el = document.getElementById('restoreLogContainer'); if(el) el.scrollTop = el.scrollHeight;");
                    });
                });

                var command = new RestoreBackupCommand(backup.FilePath, progressReporter);
                var result = await Mediator.Send(command);

                if (result.Success)
                {
                    _restoreStage = RestoreStage.Completed;
                    _restorePercentage = 100;
                    _restoreStatusText = "Restauración completada exitosamente";
                    Snackbar.Add("✓ Restauración completada exitosamente", Severity.Success);

                    // Mostrar diálogo informando que debe reiniciar
                    var restartParams = new DialogParameters
                    {
                        ["ContentText"] = $"La restauración se completó exitosamente.\n\n" +
                                        $"Detalles:\n" +
                                        $"• Archivo: {backup.FileName}\n" +
                                        $"• Fecha del respaldo: {backup.CreatedAt:dd/MM/yyyy HH:mm}\n\n" +
                                        $"IMPORTANTE: Debe reiniciar la aplicación para que los cambios surtan efecto.",
                        ["ButtonText"] = "Entendido",
                        ["Color"] = Color.Success
                    };
                    await DialogService.ShowAsync<ConfirmationDialog>("✓ Restauración Exitosa", restartParams);

                    await LoadBackups(); // Recargar lista
                }
                else
                {
                    _restoreStage = RestoreStage.Failed;
                    _restoreStatusText = $"Fallo: {result.Message}";
                    Snackbar.Add($"✗ Error al restaurar: {result.Message}", Severity.Error);

                    // Mostrar diálogo con detalles del error
                    var errorParams = new DialogParameters
                    {
                        ["ContentText"] = $"No se pudo completar la restauración.\n\n" +
                                        $"Error: {result.Message}\n\n" +
                                        $"Por favor, revise la consola de logs en vivo para más detalles.",
                        ["ButtonText"] = "Cerrar",
                        ["Color"] = Color.Error
                    };
                    await DialogService.ShowAsync<ConfirmationDialog>("✗ Error en Restauración", errorParams);
                }
            }
            catch (Exception ex)
            {
                _restoreStage = RestoreStage.Failed;
                _restoreStatusText = $"Excepción: {ex.Message}";
                Snackbar.Add($"✗ Error inesperado: {ex.Message}", Severity.Error);

                // Mostrar diálogo con error inesperado
                var errorParams = new DialogParameters
                {
                    ["ContentText"] = $"Ocurrió un error inesperado durante la restauración.\n\n" +
                                    $"Error: {ex.Message}\n\n" +
                                    $"Por favor, contacte al administrador del sistema.",
                    ["ButtonText"] = "Cerrar",
                    ["Color"] = Color.Error
                };
                await DialogService.ShowAsync<ConfirmationDialog>("✗ Error Crítico", errorParams);
            }
            finally
            {
                _isRestoring = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }


    private async Task DeleteBackup(BackupDto backup)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"¿Está seguro de que desea eliminar el respaldo '{backup.FileName}'? Esta acción no se puede deshacer.",
            ["ButtonText"] = "Eliminar",
            ["Color"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Confirmar Eliminación", parameters);
        var dialogResult = await dialog.Result;

        if (dialogResult is not null && !dialogResult.Canceled)
        {
            try
            {
                var command = new DeleteBackupCommand(backup.FilePath);
                var result = await Mediator.Send(command);

                if (result)
                {
                    Snackbar.Add("Respaldo eliminado exitosamente", Severity.Success);
                    await LoadBackups();
                }
                else
                {
                    Snackbar.Add("Error al eliminar respaldo", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error inesperado: {ex.Message}", Severity.Error);
            }
        }
    }

    private void DownloadBackup(BackupDto backup)
    {
        if (backup == null || string.IsNullOrWhiteSpace(backup.FileName)) return;
        NavigationManager.NavigateTo($"/api/backup/download/{Uri.EscapeDataString(backup.FileName)}", forceLoad: true);
    }

    private async Task UploadBackupFile(IBrowserFile? file)
    {
        if (file == null) return;

        _isUploadingBackup = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            long maxAllowedSize = 1024L * 1024L * 1024L; // 1 GB
            await using var stream = file.OpenReadStream(maxAllowedSize);
            var command = new UploadBackupCommand(file.Name, stream);
            var result = await Mediator.Send(command);

            if (result.Success)
            {
                Snackbar.Add($"✓ Respaldo '{file.Name}' cargado exitosamente.", Severity.Success);
                await LoadBackups();
            }
            else
            {
                Snackbar.Add($"✗ Error al cargar respaldo: {result.Message}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"✗ Error al procesar archivo: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUploadingBackup = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string FormatBytes(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
