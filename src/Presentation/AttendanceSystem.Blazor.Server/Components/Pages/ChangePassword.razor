@page "/account/password"
@using AttendanceSystem.Application.Features.Users.Commands.ChangeOwnPassword
@inject ISender Sender
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Cambiar mi contraseña</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Cambiar mi contraseña</MudText>

<MudPaper Class="pa-4" Style="max-width: 480px">
    <MudForm @ref="_form" @bind-IsValid="_valid">
        <MudTextField @bind-Value="_current" Label="Contraseña actual" InputType="InputType.Password" Required="true" RequiredError="Indique su contraseña actual" />
        <MudTextField @bind-Value="_new" Label="Nueva contraseña" InputType="InputType.Password" Required="true" RequiredError="Indique la nueva contraseña"
                      HelperText="Mínimo 6 caracteres, con mayúscula, minúscula y número" Class="mt-2" />
        <MudTextField @bind-Value="_confirm" Label="Confirmar nueva contraseña" InputType="InputType.Password" Required="true"
                      Validation="@(new Func<string, string?>(Matches))" Class="mt-2" />
    </MudForm>
    <MudText Typo="Typo.caption" Class="mt-3 d-block">Al cambiarla se cerrará su sesión y deberá entrar con la nueva contraseña.</MudText>
    <div class="d-flex justify-end mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_valid || _busy)" OnClick="SaveAsync">Cambiar contraseña</MudButton>
    </div>
</MudPaper>

@code {
    private MudForm _form = default!;
    private bool _valid;
    private bool _busy;
    private string _current = string.Empty;
    private string _new = string.Empty;
    private string _confirm = string.Empty;

    private string? Matches(string value) => value == _new ? null : "Las contraseñas no coinciden";

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_valid) return;

        _busy = true;
        var result = await Sender.Send(new ChangeOwnPasswordCommand(_current, _new));
        _busy = false;

        if (result.IsFailure)
        {
            Snackbar.Add(result.Error, Severity.Error);
            return;
        }

        Snackbar.Add("Contraseña actualizada. Inicie sesión con la nueva contraseña.", Severity.Success);
        Navigation.NavigateTo("Account/Logout", forceLoad: true);
    }
}
