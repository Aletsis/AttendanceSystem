</MudNavMenu>

@code {
    // Caso 14: aviso de marcajes que no cuentan (IDs no registrados, antes del ingreso o después de la baja).
    private int _unmatched;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!await UiPermissions.HasAsync(Permissions.EmployeesView)) return;
            var to = DateOnly.FromDateTime(DateTime.Today);
            var from = to.AddDays(-AttendanceSystem.Application.Features.Attendance.Queries.GetUnmatchedPunches.GetUnmatchedPunchesQueryHandler.DefaultLookbackDays);
            var rows = await Sender.Send(new AttendanceSystem.Application.Features.Attendance.Queries.GetUnmatchedPunches.GetUnmatchedPunchesQuery(from, to));
            _unmatched = rows?.Count ?? 0;
        }
        catch
        {
            _unmatched = 0; // el aviso nunca impide mostrar el menú
        }
    }
}
