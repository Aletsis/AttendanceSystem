@using MediatR
@using AttendanceSystem.Application.Features.Attendance.Commands.SetDailyRestDayOverride
@inject IMediator Mediator
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTable Items="@Records" Hover="true" Striped="true" Dense="true">
            <HeaderContent>
                <MudTh>Fecha</MudTh>
                <MudTh>Horario</MudTh>
                <MudTh>Entrada</MudTh>
                <MudTh>Salida</MudTh>
                
                @if (ReportType == "Retardos") { <MudTh>Retardo (min)</MudTh> }
                @if (ReportType == "HorasExtra") { <MudTh>Extra / Laborado</MudTh> }
                @if (ReportType == "DescansoTrabajado") { <MudTh>Tipo</MudTh> }
                @if (ReportType == "DescansoErroneo" && _canAdjust) { <MudTh>Acciones</MudTh> }
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Date.ToShortDateString()</MudTd>
                <MudTd>@context.ShiftName</MudTd>
                <MudTd>@context.CheckIn</MudTd>
                <MudTd>@context.CheckOut</MudTd>

                @if (ReportType == "Retardos") { <MudTd Style="color:red">@context.LateMinutes</MudTd> }
                @if (ReportType == "HorasExtra") 
                { 
                    <MudTd>
                        <MudText Typo="Typo.body2" Color="Color.Success">Extra: @($"{(int)TimeSpan.FromMinutes(context.OvertimeMinutes).TotalHours:00}:{TimeSpan.FromMinutes(context.OvertimeMinutes).Minutes:00}")</MudText>
                        <MudText Typo="Typo.caption">Lab: @context.WorkedHours</MudText>
                    </MudTd> 
                }
                @if (ReportType == "DescansoTrabajado") { <MudTd>Descanso Trabajado</MudTd> }
                @if (ReportType == "DescansoErroneo" && _canAdjust) 
                { 
                    <MudTd>
                        @if (context.DailyAttendanceId is { } id && _updated.Contains(id))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">Actualizado</MudChip>
                        }
                        else if (context.IsRestDay)
                        {
                             <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" OnClick="@(() => ToggleRestDay(context))">Hacer Laborable</MudButton>
                        }
                        else
                        {
                             <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="@(() => ToggleRestDay(context))">Hacer Descanso</MudButton>
                        }
                    </MudTd> 
                }
            </RowTemplate>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Submit">@(_updated.Count > 0 ? "Cerrar y actualizar reporte" : "Cerrar")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<AttendanceSystem.Application.DTOs.AdvancedReportDetailDto> Records { get; set; } = new();
    [Parameter] public string ReportType { get; set; } = string.Empty;

    // Caso 13: sólo RH y Administrador corrigen; los días corregidos quedan marcados y el reporte se regenera al cerrar.
    private bool _canAdjust;
    private readonly HashSet<Guid> _updated = new();

    protected override async Task OnInitializedAsync() =>
        _canAdjust = await UiPermissions.HasAsync(Permissions.AttendanceAdjust);

    async Task ToggleRestDay(AttendanceSystem.Application.DTOs.AdvancedReportDetailDto item)
    {
        if (item.DailyAttendanceId is not { } id) return;
        
        bool newStatus = !item.IsRestDay;
        var result = await Mediator.Send(new SetDailyRestDayOverrideCommand(id, newStatus));
        
        if (result.IsSuccess)
        {
            _updated.Add(id);
            Snackbar.Add(newStatus ? "Día marcado como Descanso." : "Día marcado como Laborable.", Severity.Success);
        }
        else
        {
            // Otro usuario o un recálculo cambió el día: se cierra para regenerar el reporte con los datos actuales.
            Snackbar.Add($"{result.Error} El reporte se actualizará con los datos actuales.", Severity.Warning);
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    void Submit() => MudDialog.Close(DialogResult.Ok(_updated.Count > 0));
}
