@* Caso 15: fecha desde la que aplica un cambio que afecta el cálculo, con el aviso de lo que se recalculará. *@
@using AttendanceSystem.Application.Features.Attendance.Consolidation

<MudDialog>
    <DialogContent>
        <MudText Class="mb-3">@Message</MudText>
        <MudDatePicker Label="Aplica desde" Date="_date" DateChanged="OnDateChanged" MaxDate="DateTime.Today.AddYears(1)" Editable="true"
                       HelperText="Hoy o una fecha pasada recalcula los días ya calculados desde esa fecha; una fecha futura no recalcula nada." />
        @if (_impact == null)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-3" />
        }
        else
        {
            <MudAlert Severity="@(_impact.IsEmpty ? Severity.Info : Severity.Warning)" Class="mt-3" Dense="true">@_impact.Describe()</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Disabled="@(_date == null)" OnClick="@(() => MudDialog.Close(DialogResult.Ok(_date!.Value.Date)))">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public Func<DateTime, Task<RecalculationImpactDto>> Impact { get; set; } = default!;

    private DateTime? _date = DateTime.Today;
    private RecalculationImpactDto? _impact;

    protected override Task OnInitializedAsync() => OnDateChanged(_date);

    private async Task OnDateChanged(DateTime? date)
    {
        _date = date;
        _impact = null;
        if (date is { } value) _impact = await Impact(value.Date);
    }

    /// <summary>Pide la fecha de vigencia; devuelve <c>null</c> si se canceló.</summary>
    public static async Task<DateTime?> AskAsync(IDialogService dialogs, string title, string message, Func<DateTime, Task<RecalculationImpactDto>> impact)
    {
        var dialog = await dialogs.ShowAsync<EffectiveDateDialog>(title, new DialogParameters<EffectiveDateDialog>
        {
            { x => x.Message, message },
            { x => x.Impact, impact }
        }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        return result is { Canceled: false, Data: DateTime date } ? date : null;
    }
}
