@using AttendanceSystem.Domain.Enumerations
@using AttendanceSystem.Application.DTOs
@using AttendanceSystem.Application.Features.Shifts.Commands.CreateShift
@using AttendanceSystem.Application.Features.Shifts.Commands.UpdateShift

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Nombre del Turno" Required="true" />
        
        <MudSelect @bind-Value="_shiftType" Label="Tipo de Turno" Class="mt-4 mb-4">
            @foreach (ShiftType type in AvailableShiftTypes)
            {
                <MudSelectItem Value="@type">@GetShiftTypeName(type)</MudSelectItem>
            }
        </MudSelect>

        <MudNumericField @bind-Value="_toleranceMinutes" Label="Tolerancia (minutos)" Min="0" Class="mb-4" />

        @if (_shiftType == ShiftType.Mixto)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Configuración por Día</MudText>
            <MudTable Items="_days" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                <HeaderContent>
                    <MudTh>Día</MudTh>
                    <MudTh>Tipo de Turno</MudTh>
                    <MudTh>Hora Inicio</MudTh>
                    <MudTh>Hora Fin</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Día">@context.DayName</MudTd>
                    <MudTd DataLabel="Tipo de Turno">
                        <MudSelect @bind-Value="context.ShiftType" Margin="Margin.Dense">
                            @foreach (ShiftType type in AvailableDayShiftTypes)
                            {
                                <MudSelectItem Value="@type">@GetShiftTypeName(type)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd DataLabel="Hora Inicio">
                        <MudTimePicker @bind-Time="context.StartTime" Required="true" Editable="true" />
                    </MudTd>
                    <MudTd DataLabel="Hora Fin">
                        <MudTimePicker @bind-Time="context.EndTime" Required="true" Editable="true" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else if (_shiftType == ShiftType.Flexible)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-1">Modalidad de Marcaje:</MudText>
            <MudRadioGroup @bind-Value="_punchTrackingMode" Class="mb-3">
                <MudRadio Value="@(PunchTrackingMode.SingleInterval)" Color="Color.Primary">Tiempo Corrido (1 Entrada, 1 Salida)</MudRadio>
                <MudRadio Value="@(PunchTrackingMode.MultiInterval)" Color="Color.Primary">Multi-Marcaje (Entradas y Salidas Libres Acumulables)</MudRadio>
            </MudRadioGroup>

            <MudCheckBox @bind-Value="_hasEntryWindow" Label="Habilitar Ventana de Llegada (con control de retardo)" Color="Color.Primary" Class="mb-2" />
            @if (_hasEntryWindow)
            {
                <MudGrid Class="mb-4">
                    <MudItem xs="6">
                        <MudTimePicker @bind-Time="_startTime" Label="Inicio Ventana Llegada" Required="true" Editable="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTimePicker @bind-Time="_flexWindowEndTime" Label="Fin Ventana Llegada" Required="true" Editable="true" />
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    * Entrada abierta (00:00). El empleado puede ingresar a cualquier hora del día sin generar retardos.
                </MudText>
            }

            <MudText Typo="Typo.subtitle2" Class="mb-1">Esquema de Horas Objetivo:</MudText>
            <MudRadioGroup @bind-Value="_flexTargetType" Class="mb-3">
                <MudRadio Value="@("Daily")" Color="Color.Primary">Por Día (Horas Diarias)</MudRadio>
                <MudRadio Value="@("Weekly")" Color="Color.Primary">Por Semana (Bolsa de Horas)</MudRadio>
            </MudRadioGroup>
            <MudGrid Class="mb-4">
                @if (_flexTargetType == "Daily")
                {
                    <MudItem xs="12">
                        <MudNumericField @bind-Value="_targetHours" Label="Horas Diarias Objetivo" Min="1" Max="24" Step="1" HelperText="Horas de trabajo requeridas al día" Required="true" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudNumericField @bind-Value="_weeklyHours" Label="Horas Semanales Objetivo (Bolsa)" Min="1" Max="168" Step="1" HelperText="Meta semanal acumulada requerida" Required="true" />
                    </MudItem>
                }
            </MudGrid>
            <MudCheckBox @bind-Value="_roundingsEnabled" Label="Habilitar Redondeos en Entrada" Color="Color.Primary" Class="mb-2" />
            @if (_roundingsEnabled)
            {
                <MudSelect @bind-Value="_roundingInterval" Label="Intervalo de Redondeo" Class="mb-4">
                    <MudSelectItem Value="15">15 minutos</MudSelectItem>
                    <MudSelectItem Value="30">30 minutos</MudSelectItem>
                    <MudSelectItem Value="60">1 hora (60 minutos)</MudSelectItem>
                </MudSelect>
            }
        }
        else if (_shiftType == ShiftType.Partido)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Primary">Primer Bloque</MudText>
            <MudGrid Class="mb-3">
                <MudItem xs="4">
                    <MudTimePicker @bind-Time="_startTime" Label="Entrada Bloque 1" Required="true" Editable="true" />
                </MudItem>
                <MudItem xs="4">
                    <MudTimePicker @bind-Time="_endTime" Label="Salida Bloque 1" Required="true" Editable="true" />
                </MudItem>
                <MudItem xs="4">
                    <MudNumericField @bind-Value="_toleranceMinutes" Label="Tolerancia Bloque 1 (min)" Min="0" Max="60" Step="1" />
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Primary">Segundo Bloque</MudText>
            <MudGrid Class="mb-3">
                <MudItem xs="4">
                    <MudTimePicker @bind-Time="_secondBlockStartTime" Label="Entrada Bloque 2" Required="true" Editable="true" />
                </MudItem>
                <MudItem xs="4">
                    <MudTimePicker @bind-Time="_secondBlockEndTime" Label="Salida Bloque 2" Required="true" Editable="true" />
                </MudItem>
                <MudItem xs="4">
                    <MudNumericField @bind-Value="_secondBlockToleranceMinutes" Label="Tolerancia Bloque 2 (min)" Min="0" Max="60" Step="1" />
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4">
                * Requiere 4 marcajes obligatorios. Si la salida del bloque 2 es menor a su entrada, se computa como salida del día siguiente (nocturno).
            </MudText>
        }
        else
        {
            <MudTimePicker @bind-Time="_startTime" Label="Hora de Inicio" Required="true" Editable="true" />
            <MudTimePicker @bind-Time="_endTime" Label="Hora de Fin" Required="true" Editable="true" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid? ShiftId { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public TimeSpan? StartTime { get; set; }
    [Parameter] public TimeSpan? WorkHours { get; set; }
    [Parameter] public int ToleranceMinutes { get; set; }
    [Parameter] public ShiftType ShiftType { get; set; }
    [Parameter] public IEnumerable<ShiftDayDto>? Days { get; set; }
    [Parameter] public bool RoundingsEnabled { get; set; }
    [Parameter] public int RoundingInterval { get; set; }
    [Parameter] public TimeSpan? FlexWindowEndTime { get; set; }
    [Parameter] public TimeSpan? WeeklyWorkHours { get; set; }
    [Parameter] public TimeSpan? SecondBlockStartTime { get; set; }
    [Parameter] public TimeSpan? SecondBlockEndTime { get; set; }
    [Parameter] public int? SecondBlockToleranceMinutes { get; set; }
    [Parameter] public PunchTrackingMode PunchTrackingMode { get; set; } = PunchTrackingMode.SingleInterval;
    [Parameter] public bool HasEntryWindow { get; set; } = true;

    private string _name = "";
    private TimeSpan? _startTime;
    private TimeSpan? _endTime;
    private TimeSpan? _secondBlockStartTime;
    private TimeSpan? _secondBlockEndTime;
    private int _secondBlockToleranceMinutes = 10;
    private TimeSpan? _flexWindowEndTime;
    private int _toleranceMinutes;
    private int _targetHours = 8;
    private int _weeklyHours = 40;
    private string _flexTargetType = "Daily";
    private ShiftType _shiftType;
    private bool _roundingsEnabled;
    private int _roundingInterval = 15;
    private PunchTrackingMode _punchTrackingMode = PunchTrackingMode.SingleInterval;
    private bool _hasEntryWindow = true;
    
    private List<DayConfig> _days = new();

    public class DayConfig
    {
        public DayOfWeek DayOfWeek { get; set; }
        public string DayName { get; set; } = "";
        public TimeSpan? StartTime { get; set; }
        public TimeSpan? EndTime { get; set; }
        public ShiftType ShiftType { get; set; } = ShiftType.Matutino;
    }

    private static readonly ShiftType[] AvailableShiftTypes =
    [
        ShiftType.Matutino,
        ShiftType.Vespertino,
        ShiftType.Nocturno,
        ShiftType.Mixto,
        ShiftType.Flexible,
        ShiftType.Partido
    ];

    private static readonly ShiftType[] AvailableDayShiftTypes =
    [
        ShiftType.Matutino,
        ShiftType.Vespertino,
        ShiftType.Nocturno,
        ShiftType.Flexible,
        ShiftType.Partido
    ];

    protected override void OnInitialized()
    {
        _name = Name;
        _startTime = StartTime ?? new TimeSpan(9, 0, 0); // Default 9 AM
        _toleranceMinutes = ToleranceMinutes;
        _shiftType = ShiftType;
        if (_shiftType == ShiftType.Continuo)
        {
            _shiftType = ShiftType.Flexible;
            _hasEntryWindow = false;
        }
        else if (_shiftType == ShiftType.Rotativo)
        {
            _shiftType = ShiftType.Matutino;
        }
        _roundingsEnabled = RoundingsEnabled;
        _roundingInterval = RoundingInterval == 0 ? 15 : RoundingInterval;
        _flexWindowEndTime = FlexWindowEndTime ?? (_startTime.HasValue ? _startTime.Value.Add(TimeSpan.FromHours(1.5)) : new TimeSpan(9, 30, 0));
        _secondBlockStartTime = SecondBlockStartTime ?? new TimeSpan(16, 0, 0);
        _secondBlockEndTime = SecondBlockEndTime ?? new TimeSpan(20, 0, 0);
        _secondBlockToleranceMinutes = SecondBlockToleranceMinutes ?? ToleranceMinutes;
        _punchTrackingMode = PunchTrackingMode;
        _hasEntryWindow = HasEntryWindow;
        
        if (WeeklyWorkHours.HasValue && WeeklyWorkHours.Value > TimeSpan.Zero)
        {
            _flexTargetType = "Weekly";
            _weeklyHours = (int)WeeklyWorkHours.Value.TotalHours;
        }
        else
        {
            _flexTargetType = "Daily";
        }
        
        if (WorkHours.HasValue && WorkHours.Value > TimeSpan.Zero)
        {
             _targetHours = (int)WorkHours.Value.TotalHours;
             if (StartTime.HasValue)
             {
                 _endTime = StartTime.Value.Add(WorkHours.Value);
             }
        }
        else
        {
             _endTime = _startTime.Value.Add(TimeSpan.FromHours(9)); // Default 9 hours
        }

        InitDays();
    }

    private void InitDays()
    {
        var spanishDays = new Dictionary<DayOfWeek, string>
        {
            { DayOfWeek.Monday, "Lunes" },
            { DayOfWeek.Tuesday, "Martes" },
            { DayOfWeek.Wednesday, "Miércoles" },
            { DayOfWeek.Thursday, "Jueves" },
            { DayOfWeek.Friday, "Viernes" },
            { DayOfWeek.Saturday, "Sábado" },
            { DayOfWeek.Sunday, "Domingo" }
        };

        foreach (var kvp in spanishDays)
        {
            var existing = Days?.FirstOrDefault(d => d.DayOfWeek == kvp.Key);
            if (existing != null)
            {
                var end = existing.StartTime.Add(existing.WorkHours);
                if (end.TotalDays >= 1) end = end.Subtract(TimeSpan.FromDays(1));

                _days.Add(new DayConfig
                {
                    DayOfWeek = kvp.Key,
                    DayName = kvp.Value,
                    StartTime = existing.StartTime,
                    EndTime = end,
                    ShiftType = existing.ShiftType
                });
            }
            else
            {
                _days.Add(new DayConfig
                {
                    DayOfWeek = kvp.Key,
                    DayName = kvp.Value,
                    StartTime = new TimeSpan(9, 0, 0),
                    EndTime = new TimeSpan(18, 0, 0),
                    ShiftType = ShiftType.Matutino
                });
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_name))
            return;

        if (_shiftType == ShiftType.Flexible)
        {
            _startTime ??= new TimeSpan(8, 0, 0);
            _flexWindowEndTime ??= _startTime.Value.Add(TimeSpan.FromHours(1.5));
            _endTime = _flexWindowEndTime.Value.Add(TimeSpan.FromHours(_targetHours));
        }
        else if (_shiftType != ShiftType.Mixto && (_startTime == null || _endTime == null))
        {
            return;
        }

        var start = _startTime ?? new TimeSpan(9, 0, 0);
        var end = _endTime ?? new TimeSpan(18, 0, 0);
        
        var durationEnd = end;
        if (durationEnd <= start)
            durationEnd = durationEnd.Add(TimeSpan.FromHours(24));
        
        TimeSpan workHours;
        TimeSpan? weekly = null;
        TimeSpan? b2Start = null;
        TimeSpan? b2End = null;
        int? b2Tol = null;

        if (_shiftType == ShiftType.Flexible)
        {
            if (_flexTargetType == "Daily")
            {
                workHours = TimeSpan.FromHours(_targetHours);
                weekly = null;
            }
            else
            {
                workHours = TimeSpan.Zero;
                weekly = TimeSpan.FromHours(_weeklyHours);
            }
        }
        else if (_shiftType == ShiftType.Partido)
        {
            b2Start = _secondBlockStartTime ?? new TimeSpan(16, 0, 0);
            b2End = _secondBlockEndTime ?? new TimeSpan(20, 0, 0);
            b2Tol = _secondBlockToleranceMinutes;

            var b1Dur = durationEnd - start;
            var b2DurEnd = b2End.Value <= b2Start.Value ? b2End.Value.Add(TimeSpan.FromHours(24)) : b2End.Value;
            var b2Dur = b2DurEnd - b2Start.Value;
            workHours = b1Dur + b2Dur;
        }
        else
        {
            workHours = durationEnd - start;
        }

        var dtos = new List<ShiftDayDto>();
        if (_shiftType == ShiftType.Mixto)
        {
            foreach (var d in _days)
            {
                if (d.StartTime.HasValue && d.EndTime.HasValue)
                {
                    var dStart = d.StartTime.Value;
                    var dEnd = d.EndTime.Value;
                    var dDur = dEnd <= dStart ? dEnd.Add(TimeSpan.FromHours(24)) : dEnd;
                    
                    dtos.Add(new ShiftDayDto(d.DayOfWeek, dStart, dEnd, dDur - dStart, d.ShiftType));
                }
            }
        }

        TimeSpan? flexEnd = null;
        if (_shiftType == ShiftType.Flexible)
        {
            if (_hasEntryWindow)
            {
                flexEnd = _flexWindowEndTime ?? start;
            }
            else
            {
                start = TimeSpan.Zero;
                flexEnd = null;
            }
        }

        bool effectiveHasEntryWindow = _shiftType == ShiftType.Flexible ? _hasEntryWindow : true;

        if (ShiftId.HasValue)
        {
            var command = new UpdateShiftCommand(
                ShiftId.Value,
                _name,
                start,
                _toleranceMinutes,
                workHours,
                _shiftType,
                dtos,
                LunchBreakMinutes: 0,
                RoundingsEnabled: _roundingsEnabled,
                RoundingInterval: _roundingInterval,
                FlexWindowEndTime: flexEnd,
                WeeklyWorkHours: weekly,
                SecondBlockStartTime: b2Start,
                SecondBlockEndTime: b2End,
                SecondBlockToleranceMinutes: b2Tol,
                PunchTrackingMode: _punchTrackingMode,
                HasEntryWindow: effectiveHasEntryWindow);
            MudDialog.Close(DialogResult.Ok(command));
        }
        else
        {
            var command = new CreateShiftCommand(
                _name,
                start,
                _toleranceMinutes,
                workHours,
                _shiftType,
                dtos,
                LunchBreakMinutes: 0,
                RoundingsEnabled: _roundingsEnabled,
                RoundingInterval: _roundingInterval,
                FlexWindowEndTime: flexEnd,
                WeeklyWorkHours: weekly,
                SecondBlockStartTime: b2Start,
                SecondBlockEndTime: b2End,
                SecondBlockToleranceMinutes: b2Tol,
                PunchTrackingMode: _punchTrackingMode,
                HasEntryWindow: effectiveHasEntryWindow);
            MudDialog.Close(DialogResult.Ok(command));
        }
    }

    private string GetShiftTypeName(ShiftType type) => type switch
    {
        ShiftType.Matutino => "Matutino",
        ShiftType.Vespertino => "Vespertino",
        ShiftType.Nocturno => "Nocturno",
        ShiftType.Mixto => "Mixto",
        ShiftType.Continuo => "Continuo",
        ShiftType.Flexible => "Flexible",
        ShiftType.Partido => "Partido / Doble Turno",
        ShiftType.Rotativo => "Rotativo",
        _ => type.ToString()
    };
}
