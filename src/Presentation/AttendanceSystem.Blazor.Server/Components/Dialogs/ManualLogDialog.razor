<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudGrid>
                <MudItem xs="12">
                    <MudText>Agregando registro manual para: <b>@Values.EmployeeName</b></MudText>
                    <MudText Typo="Typo.caption">
                        Capture la fecha y hora reales del marcaje. El sistema decide si es entrada, salida o comida y a qué jornada pertenece
                        (p. ej. la salida de las 06:00 de un turno nocturno se captura con la fecha del día siguiente).
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Fecha" @bind-Date="Date" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="Hora" @bind-Time="Time" Required="true" AmPm="false" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Reason" Label="Motivo" Required="true" RequiredError="Indique el motivo" MaxLength="500" Lines="2" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(!success)">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ManualLogCallbackValues Values { get; set; } = null!;

    private MudForm form = default!;
    private bool success;
    private DateTime? Date;
    private TimeSpan? Time = DateTime.Now.TimeOfDay;
    private string Reason = string.Empty;

    protected override void OnInitialized() => Date = Values.Date.ToDateTime(TimeOnly.MinValue);

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (Date.HasValue && Time.HasValue && !string.IsNullOrWhiteSpace(Reason))
        {
            var dateTime = Date.Value.Date + new TimeSpan(Time.Value.Hours, Time.Value.Minutes, 0);
            MudDialog.Close(DialogResult.Ok(new ManualLogResult(dateTime, Reason.Trim())));
        }
    }

    public record ManualLogCallbackValues(string EmployeeName, DateOnly Date);
    public record ManualLogResult(DateTime DateTime, string Reason);
}
