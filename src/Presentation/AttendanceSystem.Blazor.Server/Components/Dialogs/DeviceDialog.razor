@using MudBlazor
@using AttendanceSystem.Application.DTOs
@using AttendanceSystem.Application.Features.Devices.Commands.CreateDevice
@using AttendanceSystem.Application.Features.Devices.Commands.UpdateDevice
@using AttendanceSystem.Domain.Enumerations
@using AttendanceSystem.Application.Abstractions
@using AttendanceSystem.Application.Common
@inject IAuthoritativeTimeZoneResolver TimeZoneResolver

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField @bind-Value="Name" Label="Nombre" Required="true" RequiredError="El nombre es requerido" />
            <MudTextField @bind-Value="IpAddress" Label="Dirección IP" Required="true" RequiredError="La IP es requerida" />
            <MudNumericField @bind-Value="Port" Label="Puerto" Required="true" Min="1" Max="65535" />
            <MudTextField @bind-Value="Location" Label="Ubicación" />

            <MudSelect T="string" @bind-Value="TimeZoneId" Label="Zona horaria del reloj" Required="true" RequiredError="La zona horaria es requerida"
                       HelperText="La hora que marca el reloj se interpreta en esta zona; al cambiarla se sincroniza su hora." Class="mb-3">
                @foreach (var zone in _zones)
                {
                    <MudSelectItem Value="@zone.Id">@TimeZoneCatalog.Describe(zone.Id)</MudSelectItem>
                }
            </MudSelect>
            
            <MudSelect T="DeviceBrand" Label="Marca" Value="Brand" ValueChanged="OnBrandChanged" Required="true" Class="mb-3">
                <MudSelectItem Value="@DeviceBrand.ZKTeco">ZKTeco</MudSelectItem>
                <MudSelectItem Value="@DeviceBrand.Hikvision">Hikvision</MudSelectItem>
            </MudSelect>

            @if (Brand == DeviceBrand.ZKTeco)
            {
                <MudSelect T="DeviceDownloadMethod" Label="Método de Descarga" Value="DownloadMethod" ValueChanged="OnDownloadMethodChanged" Required="true" Class="mb-3">
                    <MudSelectItem Value="@DeviceDownloadMethod.Sdk">SDK (Pull)</MudSelectItem>
                    <MudSelectItem Value="@DeviceDownloadMethod.Adms">ADMS (Push)</MudSelectItem>
                </MudSelect>
            }

            @if (Brand == DeviceBrand.ZKTeco && DownloadMethod == DeviceDownloadMethod.Adms)
            {
                <MudTextField @bind-Value="SerialNumber" Label="Número de Serie (Requerido para ADMS)" 
                              HelperText="Para dispositivos ADMS (Push), ingrese el número de serie exacto."
                              Required="true" 
                              RequiredError="Para ADMS, el número de serie es obligatorio." />
            }

            @if (DownloadMethod == DeviceDownloadMethod.Sdk)
            {
                <MudSwitch @bind-Value="ShouldClearAfterDownload" Label="Borrar registros después de descargar" Color="Color.Secondary" Class="mt-2" />
            }

            @if (Brand == DeviceBrand.Hikvision)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">Credenciales (Hikvision)</MudText>
                <MudTextField @bind-Value="Username" Label="Usuario" HelperText="Por defecto 'admin' para Hikvision" />
                <MudTextField @bind-Value="Password" Label="Contraseña" InputType="InputType.Password" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? DeviceId { get; set; }
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string IpAddress { get; set; } = string.Empty;
    [Parameter] public int Port { get; set; } = 4370;
    [Parameter] public string? Location { get; set; }
    [Parameter] public DeviceBrand Brand { get; set; } = DeviceBrand.ZKTeco;
    [Parameter] public bool ShouldClearAfterDownload { get; set; }
    [Parameter] public DeviceDownloadMethod DownloadMethod { get; set; } = DeviceDownloadMethod.Sdk;
    [Parameter] public string? SerialNumber { get; set; }
    [Parameter] public string? Username { get; set; }
    [Parameter] public string? Password { get; set; }
    [Parameter] public string? TimeZoneId { get; set; }

    private IReadOnlyList<TimeZoneCatalog.Entry> _zones = TimeZoneCatalog.Common;

    private bool success;
    private MudForm form = default!;

    protected override async Task OnInitializedAsync()
    {
        // Reloj nuevo o sin zona: se propone la zona del sistema.
        if (string.IsNullOrWhiteSpace(TimeZoneId))
        {
            TimeZoneId = await TimeZoneResolver.GetSystemDefaultTimeZoneAsync();
        }
        if (_zones.All(z => z.Id != TimeZoneId))
        {
            _zones = _zones.Prepend(new TimeZoneCatalog.Entry(TimeZoneId!, TimeZoneId!)).ToList();
        }

        if (Brand == DeviceBrand.Hikvision)
        {
            DownloadMethod = DeviceDownloadMethod.Sdk;
            if (string.IsNullOrWhiteSpace(Username) && string.IsNullOrEmpty(DeviceId))
            {
                Username = "admin";
            }
        }
    }

    private void OnBrandChanged(DeviceBrand newBrand)
    {
        Brand = newBrand;
        if (Brand == DeviceBrand.Hikvision)
        {
            DownloadMethod = DeviceDownloadMethod.Sdk;
            if (Port == 4370)
            {
                Port = 80;
            }
            if (string.IsNullOrWhiteSpace(Username))
            {
                Username = "admin";
            }
        }
        else if (Brand == DeviceBrand.ZKTeco)
        {
            if (Port == 80)
            {
                Port = 4370;
            }
        }
    }

    private void OnDownloadMethodChanged(DeviceDownloadMethod newMethod)
    {
        DownloadMethod = newMethod;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.ValidateAsync();

        if (success)
        {
            var finalSerialNumber = (Brand == DeviceBrand.ZKTeco && DownloadMethod == DeviceDownloadMethod.Adms)
                ? SerialNumber
                : (string.IsNullOrEmpty(DeviceId) ? SerialNumber : null);
            var finalUsername = Brand == DeviceBrand.Hikvision ? Username : null;
            var finalPassword = Brand == DeviceBrand.Hikvision ? Password : null;

            if (string.IsNullOrEmpty(DeviceId))
            {
                MudDialog.Close(DialogResult.Ok(new CreateDeviceCommand(Name, IpAddress, Port, Location, Brand, ShouldClearAfterDownload, DownloadMethod, finalSerialNumber, finalUsername, finalPassword, TimeZoneId)));
            }
            else
            {
                MudDialog.Close(DialogResult.Ok(new UpdateDeviceCommand(Guid.Parse(DeviceId), Name, IpAddress, Port, Location, Brand, ShouldClearAfterDownload, DownloadMethod, finalSerialNumber, finalUsername, finalPassword, TimeZoneId)));
            }
        }
    }
}
