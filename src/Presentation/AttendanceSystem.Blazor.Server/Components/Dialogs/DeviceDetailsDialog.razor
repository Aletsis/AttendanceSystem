@using AttendanceSystem.Application.DTOs
@using AttendanceSystem.Application.Abstractions
@using MediatR
@using AttendanceSystem.Application.Features.Devices.Queries.GetDeviceUsers
@using AttendanceSystem.Application.Features.Devices.Commands.DeleteDeviceUser
@using AttendanceSystem.Application.Features.Devices.Commands.DeleteDeviceUserFingerprints
@using AttendanceSystem.Application.Features.Devices.Commands.SetDeviceTime
@using AttendanceSystem.Application.Features.Devices.Commands.ResetDeviceToFactory
@using AttendanceSystem.Application.Features.Devices.Commands.ClearDeviceLogs
@using AttendanceSystem.Application.Features.Devices.Commands.QueryDeviceOptions
@using AttendanceSystem.Application.Features.Devices.Commands.RefreshDeviceInfo
@using AttendanceSystem.Application.Features.Devices.Queries
@inject ISender Sender
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IDeviceQueries DeviceQueries

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6">
            <MudTabPanel Text="Información" Icon="@Icons.Material.Filled.Info">
                <MudGrid>
                    <!-- Encabezado con estado y acción de refrescar -->
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4 mb-2" Outlined="true" Style="border-left: 5px solid var(--mud-palette-primary);">
                            <div class="d-flex align-center justify-space-between flex-wrap gap-3">
                                <div>
                                    <div class="d-flex align-center gap-2">
                                        <MudText Typo="Typo.h5" Class="font-weight-bold">@Device.Name</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(Device.Status)">
                                            @Device.Status
                                        </MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="@(Device.IsActive ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                                            @(Device.IsActive ? "Activo" : "Inactivo")
                                        </MudChip>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                        Marca: <b>@Device.Brand</b> &bull; Método: <b>@Device.DownloadMethod</b> &bull; IP: <b>@Device.IpAddress:@Device.Port</b>
                                    </MudText>
                                </div>
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Primary" 
                                           StartIcon="@Icons.Material.Filled.Refresh" 
                                           OnClick="RefreshInfo" 
                                           Disabled="@_refreshingInfo" 
                                           Size="Size.Small">
                                    @if (_refreshingInfo)
                                    {
                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                        <MudText Class="ms-2">Consultando...</MudText>
                                    }
                                    else
                                    {
                                        <MudText>Actualizar Información</MudText>
                                    }
                                </MudButton>
                            </div>
                        </MudPaper>
                    </MudItem>

                    <!-- Firmware, Sistema y Hardware -->
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-4 h-100" Outlined="true">
                            <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-bold" Color="Color.Primary">
                                <MudIcon Icon="@Icons.Material.Filled.Memory" Class="mr-2" Size="Size.Small" />
                                Sistema y Hardware
                            </MudText>
                            <MudSimpleTable Dense="true" Hover="false" Outlined="false" Class="mud-width-full">
                                <tbody>
                                    <tr>
                                        <td class="font-weight-medium" style="width: 48%;">Número de Serie:</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(Device.SerialNumber))
                                            {
                                                <code class="font-weight-bold">@Device.SerialNumber</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No disponible</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-medium">Versión de Firmware:</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(Device.FirmwareVersion))
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@Device.FirmwareVersion</MudChip>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No disponible</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-medium">Versión de SDK:</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(Device.SdkVersion))
                                            {
                                                <span class="font-weight-bold">@Device.SdkVersion</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No disponible</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-medium">Versión de ADMS (Push):</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(Device.PushVersion))
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@Device.PushVersion</MudChip>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No disponible</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-medium">Plataforma / Hardware:</td>
                                        <td>@(Device.Platform ?? "No disponible")</td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-medium">Tipo de Dispositivo:</td>
                                        <td>
                                            @(Device.DeviceType switch
                                            {
                                                "acc" => "Control de Acceso (acc)",
                                                "att" => "Control de Asistencia (att)",
                                                null or "" => "No especificado",
                                                var t => t
                                            })
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-medium">Dirección MAC:</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(Device.MacAddress))
                                            {
                                                <code>@Device.MacAddress</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No disponible</span>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    </MudItem>

                    <!-- Conectividad y Red -->
                    <MudItem xs="12" md="6">
                        <MudPaper Elevation="0" Class="pa-4 h-100" Outlined="true">
                            <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-bold" Color="Color.Primary">
                                <MudIcon Icon="@Icons.Material.Filled.SettingsEthernet" Class="mr-2" Size="Size.Small" />
                                Red y Sincronización
                            </MudText>
                            <MudSimpleTable Dense="true" Hover="false" Outlined="false" Class="mud-width-full">
                                <tbody>
                                    <tr>
                                        <td class="font-weight-medium" style="width: 48%;">Dirección IP:</td>
                                        <td class="font-weight-bold">@Device.IpAddress</td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-medium">Puerto de Conexión:</td>
                                        <td>@Device.Port</td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-medium">Ubicación Asignada:</td>
                                        <td>@(Device.Location ?? "No especificada")</td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-medium">Método de Descarga:</td>
                                        <td>
                                            <MudChip T="string" Size="Size.Small" Color="@(Device.DownloadMethod == AttendanceSystem.Domain.Enumerations.DeviceDownloadMethod.Adms ? Color.Primary : Color.Secondary)">
                                                @Device.DownloadMethod
                                            </MudChip>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-medium">Última Sincronización:</td>
                                        <td>@(Device.LastDownloadAt?.ToString("g") ?? "Nunca")</td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-medium">Total de Descargas:</td>
                                        <td>@Device.TotalDownloadCount</td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-medium">Limpieza tras Descarga:</td>
                                        <td>
                                            <MudChip T="string" Size="Size.Small" Color="@(Device.ShouldClearAfterDownload ? Color.Warning : Color.Default)" Variant="Variant.Outlined">
                                                @(Device.ShouldClearAfterDownload ? "Activada" : "Desactivada")
                                            </MudChip>
                                        </td>
                                    </tr>
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    </MudItem>

                    <!-- Capacidades y Almacenamiento -->
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4" Outlined="true">
                            <MudText Typo="Typo.subtitle1" Class="mb-3 font-weight-bold" Color="Color.Primary">
                                <MudIcon Icon="@Icons.Material.Filled.Storage" Class="mr-2" Size="Size.Small" />
                                Capacidades y Almacenamiento
                            </MudText>
                            <MudSimpleTable Style="overflow-x: auto;" Dense="true" Hover="true" Striped="true">
                                <thead>
                                    <tr>
                                        <th>Tipo de Dato</th>
                                        <th style="text-align:center">Usado</th>
                                        <th style="text-align:center">Capacidad</th>
                                        <th style="width: 30%;">Nivel de Uso</th>
                                        <th style="text-align:right">% Uso</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" Color="Color.Primary" /> Usuarios</td>
                                        <td style="text-align:center" class="font-weight-bold">@(Device.UserCount?.ToString() ?? "-")</td>
                                        <td style="text-align:center">@(Device.UserCapacity?.ToString() ?? "-")</td>
                                        <td>
                                            <MudProgressLinear Color="@GetUsageColor(Device.UserCount, Device.UserCapacity)" Value="@GetUsageValue(Device.UserCount, Device.UserCapacity)" Rounded="true" Size="Size.Medium" />
                                        </td>
                                        <td style="text-align:right" class="font-weight-bold">@GetUsagePercentage(Device.UserCount, Device.UserCapacity)</td>
                                    </tr>
                                    <tr>
                                        <td><MudIcon Icon="@Icons.Material.Filled.Fingerprint" Size="Size.Small" Class="mr-1" Color="Color.Secondary" /> Huellas Digitales</td>
                                        <td style="text-align:center" class="font-weight-bold">@(Device.FingerprintCount?.ToString() ?? "-")</td>
                                        <td style="text-align:center">@(Device.FingerprintCapacity?.ToString() ?? "-")</td>
                                        <td>
                                            <MudProgressLinear Color="@GetUsageColor(Device.FingerprintCount, Device.FingerprintCapacity)" Value="@GetUsageValue(Device.FingerprintCount, Device.FingerprintCapacity)" Rounded="true" Size="Size.Medium" />
                                        </td>
                                        <td style="text-align:right" class="font-weight-bold">@GetUsagePercentage(Device.FingerprintCount, Device.FingerprintCapacity)</td>
                                    </tr>
                                    <tr>
                                        <td><MudIcon Icon="@Icons.Material.Filled.Face" Size="Size.Small" Class="mr-1" Color="Color.Info" /> Rostros</td>
                                        <td style="text-align:center" class="font-weight-bold">@(Device.FaceCount?.ToString() ?? "-")</td>
                                        <td style="text-align:center">@(Device.FaceCapacity?.ToString() ?? "-")</td>
                                        <td>
                                            <MudProgressLinear Color="@GetUsageColor(Device.FaceCount, Device.FaceCapacity)" Value="@GetUsageValue(Device.FaceCount, Device.FaceCapacity)" Rounded="true" Size="Size.Medium" />
                                        </td>
                                        <td style="text-align:right" class="font-weight-bold">@GetUsagePercentage(Device.FaceCount, Device.FaceCapacity)</td>
                                    </tr>
                                    <tr>
                                        <td><MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" Color="Color.Warning" /> Registros de Asistencia</td>
                                        <td style="text-align:center" class="font-weight-bold">@(Device.AttendanceRecordCount?.ToString() ?? "-")</td>
                                        <td style="text-align:center">@(Device.AttendanceRecordCapacity?.ToString() ?? "-")</td>
                                        <td>
                                            <MudProgressLinear Color="@GetUsageColor(Device.AttendanceRecordCount, Device.AttendanceRecordCapacity)" Value="@GetUsageValue(Device.AttendanceRecordCount, Device.AttendanceRecordCapacity)" Rounded="true" Size="Size.Medium" />
                                        </td>
                                        <td style="text-align:right" class="font-weight-bold">@GetUsagePercentage(Device.AttendanceRecordCount, Device.AttendanceRecordCapacity)</td>
                                    </tr>
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Usuarios" Icon="@Icons.Material.Filled.People">
                <MudGrid>
                    <MudItem xs="12" Class="d-flex align-center gap-4 flex-wrap">
                        <MudText Typo="Typo.h6" Class="mr-auto">Gestión de Usuarios</MudText>
                        
                        <MudSelect T="int?" Label="Filtrar por Rol" @bind-Value="_selectedPrivilegeFilter" Style="max-width: 200px;" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                            <MudSelectItem T="int?" Value="@((int?)null)">Todos</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)0)">Usuario</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)1)">Registrador</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)2)">Admin</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)3)">Super Admin</MudSelectItem>
                        </MudSelect>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadUsers" Disabled="@_loadingUsers">
                            @if (_loadingUsers)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                                <MudText Class="ms-2">Cargando...</MudText>
                            }
                            else
                            {
                                <MudText>Cargar Usuarios</MudText>
                            }
                        </MudButton>
                    </MudItem>
                    <MudItem xs="12">
                         <MudTable Items="@FilteredUsers" Hover="true" Loading="@_loadingUsers" Dense="true" Striped="true" FixedHeader="true" Height="400px">
                             <HeaderContent>
                                 <MudTh>ID</MudTh>
                                 <MudTh>Nombre</MudTh>
                                 <MudTh>Privilegio</MudTh>
                                 <MudTh>Habilitado</MudTh>
                                 <MudTh>Acciones</MudTh>
                             </HeaderContent>
                             <RowTemplate>
                                 <MudTd DataLabel="ID">@context.UserId</MudTd>
                                 <MudTd DataLabel="Nombre">@context.Name</MudTd>
                                 <MudTd DataLabel="Privilegio">
                                     @(context.Privilege switch
                                     {
                                         3 => "Super Admin",
                                         2 => "Admin",
                                         14 => "Admin",
                                         1 => "Registrador",
                                         _ => "Usuario"
                                     })
                                 </MudTd>
                                 <MudTd DataLabel="Habilitado">
                                     <MudCheckBox T="bool" Value="@context.Enabled" ReadOnly="true" Dense="true" Size="Size.Small"></MudCheckBox>
                                 </MudTd>
                                 <MudTd DataLabel="Acciones">
                                     <MudTooltip Text="Borrar Huellas">
                                         <MudIconButton Icon="@Icons.Material.Filled.Fingerprint" Color="Color.Warning" Size="Size.Small" OnClick="@(() => DeleteFingerprints(context))"/>
                                     </MudTooltip>
                                     <MudTooltip Text="Eliminar Usuario">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteUser(context))"/>
                                     </MudTooltip>
                                 </MudTd>
                             </RowTemplate>
                             <PagerContent>
                                 <MudTablePager />
                             </PagerContent>
                         </MudTable>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Configuración Remota" Icon="@Icons.Material.Filled.SettingsRemote">
                 <MudGrid>
                     <MudItem xs="12">
                         <MudText Typo="Typo.h6" Class="mb-4">Herramientas de Configuración</MudText>
                         <MudAlert Severity="Severity.Warning" Class="mb-4">Estas acciones afectan directamente al dispositivo físico. Úselas con precaución.</MudAlert>
                     </MudItem>

                     <MudItem xs="12" md="4">
                          <MudCard Elevation="3">
                              <MudCardHeader>
                                  <CardHeaderContent>
                                      <MudText Typo="Typo.h6">Sincronización de Hora</MudText>
                                  </CardHeaderContent>
                                  <CardHeaderActions>
                                      <MudIcon Icon="@Icons.Material.Filled.AccessTime" />
                                  </CardHeaderActions>
                              </MudCardHeader>
                              <MudCardContent>
                                  <MudText>Configura la fecha y hora del dispositivo a la hora actual del servidor.</MudText>
                                  <MudText Class="mt-2" Typo="Typo.caption">Hora del Servidor: @DateTime.Now.ToString("g")</MudText>
                              </MudCardContent>
                              <MudCardActions>
                                  <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="SyncTime" Disabled="@_processingAction">Sincronizar Hora</MudButton>
                              </MudCardActions>
                          </MudCard>
                      </MudItem>

                      <MudItem xs="12" md="4">
                          <MudCard Elevation="3">
                              <MudCardHeader>
                                  <CardHeaderContent>
                                      <MudText Typo="Typo.h6" Color="Color.Warning">Borrar Logs de Asistencia</MudText>
                                  </CardHeaderContent>
                                  <CardHeaderActions>
                                      <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" Color="Color.Warning"/>
                                  </CardHeaderActions>
                              </MudCardHeader>
                              <MudCardContent>
                                  <MudText Class="mb-3">Borra los registros de asistencia almacenados en el reloj checador.</MudText>
                                  <MudDateRangePicker Label="Rango de Fechas (Opcional)" @bind-DateRange="_dateRange" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Class="mb-3"/>
                                  <MudText Color="Color.Warning" Class="font-weight-bold">Si no selecciona un rango, se borrarán TODOS los registros.</MudText>
                              </MudCardContent>
                              <MudCardActions>
                                  <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="ClearLogs" Disabled="@_processingAction">Borrar Logs</MudButton>
                              </MudCardActions>
                          </MudCard>
                      </MudItem>

                       <MudItem xs="12" md="4">
                          <MudCard Elevation="3">
                              <MudCardHeader>
                                  <CardHeaderContent>
                                      <MudText Typo="Typo.h6" Color="Color.Error">Restablecimiento de Fábrica</MudText>
                                  </CardHeaderContent>
                                  <CardHeaderActions>
                                      <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error"/>
                                  </CardHeaderActions>
                              </MudCardHeader>
                              <MudCardContent>
                                  <MudText>Borra <b>TODOS</b> los datos del dispositivo (Usuarios, Huellas, Registros, Logs).</MudText>
                                  <MudText Color="Color.Error" Class="mt-2 font-weight-bold">Esta acción no se puede deshacer.</MudText>
                              </MudCardContent>
                              <MudCardActions>
                                  <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="FactoryReset" Disabled="@_processingAction">Restablecer Datos</MudButton>
                              </MudCardActions>
                          </MudCard>
                      </MudItem>

                       @if (Device.DownloadMethod == AttendanceSystem.Domain.Enumerations.DeviceDownloadMethod.Adms)
                       {
                           <MudItem xs="12" md="4">
                               <MudCard Elevation="3">
                                   <MudCardHeader>
                                       <CardHeaderContent>
                                           <MudText Typo="Typo.h6" Color="Color.Primary">Parámetros ADMS</MudText>
                                       </CardHeaderContent>
                                       <CardHeaderActions>
                                           <MudIcon Icon="@Icons.Material.Filled.SettingsSuggest" Color="Color.Primary"/>
                                       </CardHeaderActions>
                                   </MudCardHeader>
                                   <MudCardContent>
                                       <MudText>Solicita las opciones y variables internas del reloj (<code>DATA QUERY tablename=options</code>) para diagnóstico.</MudText>
                                   </MudCardContent>
                                   <MudCardActions>
                                       <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="QueryOptions" Disabled="@_processingAction">Consultar Opciones</MudButton>
                                   </MudCardActions>
                               </MudCard>
                           </MudItem>
                       }
                 </MudGrid>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Primary">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public required DeviceDto Device { get; set; }

    private List<DeviceUserDto> _users = new();
    private bool _loadingUsers = false;
    private bool _processingAction = false;
    private DateRange? _dateRange;
    private int? _selectedPrivilegeFilter = null;

    private IEnumerable<DeviceUserDto> FilteredUsers
    {
        get
        {
            if (!_selectedPrivilegeFilter.HasValue)
                return _users;

            return _users.Where(u => _selectedPrivilegeFilter.Value switch
            {
                0 => u.Privilege == 0,
                1 => u.Privilege == 1,
                2 => u.Privilege == 2 || u.Privilege == 14,
                3 => u.Privilege == 3,
                _ => true
            });
        }
    }

    void Cancel()
    {
        MudDialog?.Close();
    }

    private async Task LoadUsers()
    {
        _loadingUsers = true;
        
        var result = await Sender.Send(new GetDeviceUsersQuery(Device.DeviceId));
        
        if (result.IsSuccess)
        {
            _users = result.Value
                .OrderBy(u => int.TryParse(u.UserId, out var id) ? id : int.MaxValue)
                .ThenBy(u => u.UserId)
                .ToList();
            Snackbar.Add($"{_users.Count} usuarios obtenidos", Severity.Success);
        }
        else
        {
             Snackbar.Add($"Error: {result.Error}", Severity.Error);
        }
        
        _loadingUsers = false;
    }

    private async Task DeleteUser(DeviceUserDto user)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirmar Eliminación", 
            $"¿Está seguro de eliminar al usuario {user.Name} ({user.UserId}) del dispositivo? Esta acción borrará sus huellas y datos.", 
            yesText: "Eliminar", cancelText: "Cancelar");

        if (confirm == true)
        {
            var result = await Sender.Send(new DeleteDeviceUserCommand(Device.DeviceId, user.UserId));
            
            if (result.IsSuccess)
            {
                Snackbar.Add("Usuario eliminado", Severity.Success);
                _users.Remove(user);
            }
            else
            {
                 Snackbar.Add($"Error al eliminar usuario: {result.Error}", Severity.Error);
            }
        }
    }

    private async Task DeleteFingerprints(DeviceUserDto user)
    {
         var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirmar Eliminación de Huellas", 
            $"¿Borrar todas las huellas de {user.Name} ({user.UserId})?",
            yesText: "Borrar", cancelText: "Cancelar");

        if (confirm == true)
        {
             var result = await Sender.Send(new DeleteDeviceUserFingerprintsCommand(Device.DeviceId, user.UserId));
             
             if (result.IsSuccess) Snackbar.Add("Huellas eliminadas", Severity.Success);
             else Snackbar.Add($"Error al eliminar huellas: {result.Error}", Severity.Error);
        }
    }

    private async Task SyncTime()
    {
        _processingAction = true;
        var result = await Sender.Send(new SetDeviceTimeCommand(Device.DeviceId, DateTime.Now));
        
        if (result.IsSuccess) Snackbar.Add("Hora sincronizada correctamente", Severity.Success);
        else Snackbar.Add($"Error al sincronizar hora: {result.Error}", Severity.Error);
        
        _processingAction = false;
    }

    private async Task QueryOptions()
    {
        _processingAction = true;
        var result = await Sender.Send(new QueryDeviceOptionsCommand(Device.DeviceId));
        
        if (result.IsSuccess) Snackbar.Add("Comando de consulta de opciones (DATA QUERY) encolado. El reloj responderá en su siguiente latido.", Severity.Success);
        else Snackbar.Add($"Error al consultar opciones: {result.Error}", Severity.Error);
        
        _processingAction = false;
    }

    private async Task FactoryReset()
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "PELIGRO: RESTABLECIMIENTO DE FÁBRICA", 
            "¿ESTÁ ABSOLUTAMENTE SEGURO? Se borrarán TODOS los usuarios y registros del dispositivo.",
            yesText: "SÍ, BORRAR TODO", cancelText: "Cancelar");

        if (confirm == true)
        {
             _processingAction = true;
             var result = await Sender.Send(new ResetDeviceToFactoryCommand(Device.DeviceId));
             
             if (result.IsSuccess) Snackbar.Add("Dispositivo restablecido (Datos borrados)", Severity.Success);
             else Snackbar.Add($"Error al restablecer: {result.Error}", Severity.Error);
             
             _processingAction = false;
        }
    }

    private async Task ClearLogs()
    {
        string rangeMsg = _dateRange != null && _dateRange.Start.HasValue && _dateRange.End.HasValue
            ? $"en el rango del {_dateRange.Start.Value:dd/MM/yyyy} al {_dateRange.End.Value:dd/MM/yyyy}"
            : "TODOS los logs de asistencia (borrado completo)";

        var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirmar Eliminación de Logs", 
            $"¿Está seguro de que desea borrar {rangeMsg} de este dispositivo? Esta acción eliminará los registros del reloj checador y no se puede deshacer.",
            yesText: "Sí, Borrar Logs", cancelText: "Cancelar");

        if (confirm == true)
        {
             _processingAction = true;
             var result = await Sender.Send(new ClearDeviceLogsCommand(
                 Device.DeviceId, 
                 _dateRange?.Start, 
                 _dateRange?.End?.Date.AddDays(1).AddSeconds(-1)));
             
             if (result.IsSuccess) Snackbar.Add("Logs del dispositivo borrados correctamente", Severity.Success);
             else Snackbar.Add($"Error al borrar logs: {result.Error}", Severity.Error);
             
             _processingAction = false;
        }
    }

    private bool _refreshingInfo = false;

    private async Task RefreshInfo()
    {
        _refreshingInfo = true;
        try
        {
            if (Device.DownloadMethod == AttendanceSystem.Domain.Enumerations.DeviceDownloadMethod.Adms)
            {
                var cmdResult = await Sender.Send(new QueryDeviceOptionsCommand(Device.DeviceId));
                if (cmdResult.IsSuccess)
                {
                    Snackbar.Add("Solicitud de consulta de opciones enviada al reloj ADMS. El dispositivo responderá en su siguiente sincronización.", Severity.Info);
                }
                else
                {
                    Snackbar.Add($"Aviso ADMS: {cmdResult.Error}", Severity.Warning);
                }
            }
            else
            {
                var refreshResult = await Sender.Send(new RefreshDeviceInfoCommand(Guid.Parse(Device.DeviceId)));
                if (refreshResult.IsSuccess)
                {
                    Snackbar.Add("Información del dispositivo actualizada en tiempo real vía SDK.", Severity.Success);
                }
                else
                {
                    Snackbar.Add($"No se pudo conectar directamente con el dispositivo: {refreshResult.Error}", Severity.Warning);
                }
            }

            var updated = await DeviceQueries.GetDeviceByIdAsync(Device.DeviceId);
            if (updated != null)
            {
                Device = updated;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al actualizar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _refreshingInfo = false;
        }
    }

    Color GetStatusColor(string status) => status?.ToLowerInvariant() switch
    {
        "online" or "en línea" => Color.Success,
        "error" => Color.Error,
        _ => Color.Default
    };

    Color GetUsageColor(int? count, int? capacity)
    {
        if (!count.HasValue || !capacity.HasValue || capacity.Value == 0) return Color.Default;
        double pc = (double)count.Value / capacity.Value * 100;
        if (pc < 70) return Color.Success;
        if (pc < 90) return Color.Warning;
        return Color.Error;
    }

    double GetUsageValue(int? count, int? capacity)
    {
        if (!count.HasValue || !capacity.HasValue || capacity.Value == 0) return 0;
        return Math.Round((double)count.Value / capacity.Value * 100, 1);
    }

    string GetUsagePercentage(int? count, int? capacity)
    {
        if (!count.HasValue || !capacity.HasValue || capacity.Value == 0) return "-";
        double pc = (double)count.Value / capacity.Value * 100;
        return $"{pc:F1}%";
    }
}

