@using AttendanceSystem.Application.Features.Roster.Commands.GenerateRotationPattern
@using AttendanceSystem.Application.DTOs
@using AttendanceSystem.Application.Features.Employees
@using AttendanceSystem.Application.Features.Employees.Queries
@using AttendanceSystem.Application.Features.Shifts.Queries.GetShifts
@using AttendanceSystem.Application.Features.Branches.Queries.GetBranches
@using MediatR
@inject ISender Sender
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <RotationSchemeConfigForm Model="_model" Shifts="_shifts" Disabled="_isProcessing" />
            </MudItem>

            @if (!string.IsNullOrEmpty(PreselectedEmployeeId))
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Filled.Person">
                        Modificando esquema para: <b>@(PreselectedEmployeeName ?? PreselectedEmployeeId)</b> (ID: @PreselectedEmployeeId)
                    </MudAlert>
                </MudItem>
            }
            else
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Empleados a asignar:</MudText>
                    <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_selectedEmployeeIds" Label="Seleccionar Empleados" SelectAll="true" SelectAllText="Seleccionar todos" MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectionText))" Disabled="_isProcessing">
                        @foreach (var emp in _employees)
                        {
                            <MudSelectItem T="string" Value="@emp.Id">@emp.FullName (@emp.Id)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isProcessing">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_isProcessing">
            @if (_isProcessing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Guardando...</span>
            }
            else
            {
                <span>@(string.IsNullOrEmpty(PreselectedEmployeeId) ? "Generar Roster" : "Guardar Esquema")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string? PreselectedEmployeeId { get; set; }
    [Parameter] public string? PreselectedEmployeeName { get; set; }
    [Parameter] public string? InitialSchemeName { get; set; }

    private RotationSchemeModel _model = new();
    private List<ShiftDto> _shifts = new();
    private List<EmployeeDto> _employees = new();
    private IReadOnlyCollection<string> _selectedEmployeeIds = new HashSet<string>();
    private bool _isProcessing;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(PreselectedEmployeeId))
        {
            _selectedEmployeeIds = new HashSet<string> { PreselectedEmployeeId };
        }

        if (!string.IsNullOrEmpty(InitialSchemeName))
        {
            if (InitialSchemeName.Contains("4x3", StringComparison.OrdinalIgnoreCase))
                _model.SchemeType = RotationSchemeType.Esquema4x3;
            else if (InitialSchemeName.Contains("24x48", StringComparison.OrdinalIgnoreCase))
                _model.SchemeType = RotationSchemeType.Esquema24x48;
            else if (InitialSchemeName.Contains("2x8", StringComparison.OrdinalIgnoreCase))
                _model.SchemeType = RotationSchemeType.Rotativo2x8;
            else if (InitialSchemeName.Contains("3x8", StringComparison.OrdinalIgnoreCase))
                _model.SchemeType = RotationSchemeType.Rotativo3x8;
        }

        var shiftsResult = await Sender.Send(new GetShiftsQuery());
        if (shiftsResult.IsSuccess)
        {
            _shifts = shiftsResult.Value.ToList();
            _model.InitializeShifts(_shifts);
        }

        var empsResult = await Sender.Send(new GetAllEmployeesQuery());
        _employees = empsResult.IsSuccess ? empsResult.Value.OrderBy(e => e.FullName).ToList() : new();

        if (!string.IsNullOrEmpty(PreselectedEmployeeId))
        {
            var preselectedEmp = _employees.FirstOrDefault(e => e.Id == PreselectedEmployeeId);
            if (preselectedEmp?.RestDays != null && preselectedEmp.RestDays.Any())
            {
                _model.SelectedFixedRestDays = preselectedEmp.RestDays.Select(d => (DayOfWeek)d).ToHashSet();
            }
            else if (preselectedEmp?.RestDay.HasValue == true)
            {
                _model.SelectedFixedRestDays = new HashSet<DayOfWeek> { (DayOfWeek)preselectedEmp.RestDay.Value };
            }
        }
    }

    private string GetMultiSelectionText(IReadOnlyList<string> selectedValues)
    {
        return $"{selectedValues.Count} empleado(s) seleccionado(s)";
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        var validation = _model.Validate();
        if (!validation.IsValid)
        {
            Snackbar.Add(validation.ErrorMessage!, Severity.Warning);
            return;
        }

        if (!_selectedEmployeeIds.Any())
        {
            Snackbar.Add("Debe seleccionar al menos un empleado.", Severity.Warning);
            return;
        }

        try
        {
            _isProcessing = true;
            var command = _model.ToCommand(_selectedEmployeeIds.ToList());
            var count = await Sender.Send(command);

            string horizonText = _model.IndefiniteHorizonMonths switch
            {
                6 => "6 meses",
                12 => "1 año",
                24 => "2 años",
                _ => $"{_model.IndefiniteHorizonMonths} meses"
            };

            var successMsg = _model.IsIndefinite
                ? $"Se generaron {count} asignaciones continuas (esquema indefinido proyectado a {horizonText}) con éxito."
                : $"Se generaron {count} asignaciones de turno con éxito.";

            Snackbar.Add(successMsg, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al generar el esquema: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }
}
