@using AttendanceSystem.Application.DTOs
@using AttendanceSystem.Application.Features.Employees
@using AttendanceSystem.Application.Features.Employees.Queries
@using AttendanceSystem.Application.Features.Employees.Commands
@using AttendanceSystem.Application.Features.Devices.Queries.GetAllDevices
@using AttendanceSystem.Application.Features.Devices.Commands.SendEmployeeToDevice
@using AttendanceSystem.Domain.Enumerations
@using MediatR
@using MudBlazor
@inject ISender Sender
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
        else if (_employee == null)
        {
            <MudAlert Severity="Severity.Error">No se encontró el empleado.</MudAlert>
        }
        else
        {
            <div class="d-flex flex-column align-center pa-4 mb-2">
                @if (!string.IsNullOrEmpty(_employee.Photo))
                {
                    <MudAvatar Style="height:120px; width:120px;" Elevation="4">
                        <MudImage Src="@($"data:image/jpeg;base64,{_employee.Photo}")" />
                    </MudAvatar>
                }
                else
                {
                    <MudAvatar Color="Color.Default" Style="height:120px; width:120px;" Elevation="4">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" />
                    </MudAvatar>
                }
                <MudText Typo="Typo.h6" Class="mt-2">@_employee.FullName</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">ID: @_employee.Id</MudText>
            </div>

            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
                <MudTabPanel Text="Información General">
                    <MudGrid>
                        <MudItem xs="6">
                            <MudText Typo="Typo.subtitle2">ID</MudText>
                            <MudText>@_employee.Id</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.subtitle2">Nombre Completo</MudText>
                            <MudText>@_employee.FullName</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.subtitle2">Departamento / Puesto</MudText>
                            <MudText>@_employee.DepartmentName / @_employee.PositionName</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.subtitle2">Sucursal</MudText>
                            <MudText>@_employee.BranchName</MudText>
                        </MudItem>
                         <MudItem xs="6">
                            <MudText Typo="Typo.subtitle2">Fecha Ingreso</MudText>
                            <MudText>@_employee.HireDate.ToShortDateString()</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.subtitle2">Estado</MudText>
                             <MudChip T="string" Color="@(_employee.Status == EmployeeStatus.Alta ? Color.Success : Color.Error)" Size="Size.Small">
                                @_employee.Status
                            </MudChip>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.subtitle2">Turno / Horario</MudText>
                            @if (_employee.ShiftType == ShiftType.Rotativo)
                            {
                                <div class="d-flex align-center gap-1">
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.AutoMode">
                                        Rotativo
                                    </MudChip>
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.CalendarMonth" OnClick="OpenRosterProjection">
                                        Ver Proyección
                                    </MudButton>
                                </div>
                            }
                            else
                            {
                                <MudText>@(_employee.ScheduleName ?? "Sin horario asignado")</MudText>
                            }
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.subtitle2">Día(s) de Descanso</MudText>
                            <MudText>@(_employee.RestDayName ?? (_employee.ShiftType == ShiftType.Rotativo ? "Según ciclo de rotación" : "No asignado"))</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.subtitle2">Alta en Sistema</MudText>
                            <MudText>@(_employee.CreatedAt == default ? "Histórico" : _employee.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss"))</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.subtitle2">Registrado por</MudText>
                            <MudText>@(string.IsNullOrWhiteSpace(_employee.CreatedBy) ? "Sistema" : _employee.CreatedBy)</MudText>
                        </MudItem>
                        @if (_employee.UpdatedAt.HasValue)
                        {
                            <MudItem xs="6">
                                <MudText Typo="Typo.subtitle2">Última Modificación</MudText>
                                <MudText>@_employee.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</MudText>
                            </MudItem>
                            <MudItem xs="6">
                                <MudText Typo="Typo.subtitle2">Modificado por</MudText>
                                <MudText>@(string.IsNullOrWhiteSpace(_employee.UpdatedBy) ? "Sistema" : _employee.UpdatedBy)</MudText>
                            </MudItem>
                        }
                    </MudGrid>
                </MudTabPanel>
                <MudTabPanel Text="Biometría y Acceso">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.subtitle2">Número de Tarjeta</MudText>
                            <MudText>@(_employee.CardNumber ?? "No registrado")</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.subtitle2">Contraseña Dispositivo</MudText>
                            <MudText>@(_employee.DevicePassword ?? "No establecida")</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.subtitle2">Huellas Registradas</MudText>
                            <MudText>@_employee.FingerprintCount</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.subtitle2">Rostro Registrado</MudText>
                            <MudChip T="string" Color="@(_employee.HasFace ? Color.Success : Color.Default)" Size="Size.Small">
                                @(_employee.HasFace ? "Sí" : "No")
                            </MudChip>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.subtitle2">Privilegio en Checador</MudText>
                            <MudChip T="string" Color="@(_employee.DevicePrivilege switch {
                                DevicePrivilege.SuperAdmin => Color.Error,
                                DevicePrivilege.Admin => Color.Warning,
                                DevicePrivilege.Registrar => Color.Info,
                                _ => Color.Default
                            })" Size="Size.Small">
                                @(_employee.DevicePrivilege switch
                                {
                                    DevicePrivilege.User => "Usuario Normal",
                                    DevicePrivilege.Registrar => "Registrador",
                                    DevicePrivilege.Admin => "Administrador",
                                    DevicePrivilege.SuperAdmin => "Super Administrador",
                                    _ => _employee.DevicePrivilege.ToString()
                                })
                            </MudChip>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
                <MudTabPanel Text="Sincronización">
                    <MudText Typo="Typo.body1" Class="mb-3">Enviar datos de este empleado (incluyendo biometría y privilegios) a un reloj checador:</MudText>
                    
                    <MudGrid>
                        <!-- Selección de Dispositivo -->
                        <MudItem xs="12">
                             <MudSelect T="string" Label="Seleccionar Reloj Checador de Destino" Value="_selectedDeviceId" ValueChanged="OnSelectedDeviceChanged" AnchorOrigin="Origin.BottomCenter" Required="true">
                                @foreach (var device in _devices)
                                {
                                    var statusIcon = device.Status == "En Línea" ? "🟢" : "🔴";
                                    var brandBadge = device.Brand == DeviceBrand.Hikvision ? "[Hikvision]" : (device.DownloadMethod == DeviceDownloadMethod.Adms ? "[ZKTeco ADMS]" : "[ZKTeco SDK]");
                                    <MudSelectItem Value="@device.DeviceId">@statusIcon @brandBadge @device.Name (@device.IpAddress) - @device.Status</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        @if (SelectedDevice != null)
                        {
                            <MudItem xs="12">
                                <MudPaper Class="pa-3 mb-2" Elevation="0" Outlined="true" Style="background-color: var(--mud-palette-background-grey);">
                                    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                        <div class="d-flex align-center gap-2">
                                            <MudChip T="string" Size="Size.Small" Color="@(SelectedDevice.Brand == DeviceBrand.Hikvision ? Color.Info : Color.Primary)" Variant="Variant.Filled">
                                                @SelectedDevice.Brand
                                            </MudChip>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                                @(SelectedDevice.Brand == DeviceBrand.Hikvision ? "Protocolo ISAPI" : (SelectedDevice.DownloadMethod == DeviceDownloadMethod.Adms ? "Protocolo ADMS (Push Cloud)" : "SDK Standalone (TCP 4370)"))
                                            </MudChip>
                                            @if (!string.IsNullOrEmpty(SelectedDevice.DeviceType))
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                                    @(SelectedDevice.DeviceType == "acc" ? "Control de Acceso" : "Control de Asistencia")
                                                </MudChip>
                                            }
                                        </div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            IP: @SelectedDevice.IpAddress | Estado: @SelectedDevice.Status
                                        </MudText>
                                    </div>
                                </MudPaper>
                            </MudItem>
                        }

                        <!-- Selección de Rol / Privilegio según la marca del reloj -->
                        <MudItem xs="12" sm="7">
                            <MudSelect T="DevicePrivilege" @bind-Value="_devicePrivilege" Label="Rol / Privilegio en este Reloj" AnchorOrigin="Origin.BottomCenter" HelperText="@CurrentPrivilegeOption?.Description">
                                @foreach (var opt in AvailablePrivileges)
                                {
                                    <MudSelectItem Value="@opt.Value">@opt.DisplayName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="5" Class="d-flex align-center">
                            @if (_employee != null && _devicePrivilege != _employee.DevicePrivilege)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Save"
                                           OnClick="SavePrivilege"
                                           Disabled="@(_savingPrivilege || _sending)">
                                    @(_savingPrivilege ? "Guardando..." : "Guardar Privilegio")
                                </MudButton>
                            }
                        </MudItem>

                        @if (SelectedDevice != null && SelectedDevice.Brand == DeviceBrand.Hikvision && (_employee?.DevicePrivilege == DevicePrivilege.SuperAdmin || _employee?.DevicePrivilege == DevicePrivilege.Registrar))
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">
                                    Nota: Los terminales <strong>Hikvision</strong> únicamente admiten roles de <strong>Usuario Normal</strong> y <strong>Administrador</strong>. El rol se ha mapeado automáticamente a <strong>@CurrentPrivilegeOption?.DisplayName</strong>.
                                </MudAlert>
                            </MudItem>
                        }

                        <MudItem xs="12" Class="d-flex justify-end mt-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                                       StartIcon="@Icons.Material.Filled.Send" 
                                       OnClick="SendToDevice" 
                                       Disabled="@(string.IsNullOrEmpty(_selectedDeviceId) || _sending || _savingPrivilege)">
                                @(_sending ? "Enviando..." : "Enviar a Dispositivo")
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
                <MudTabPanel Text="Bitácora de Cambios" Icon="@Icons.Material.Filled.History">
                    @if (_loadingAuditLogs)
                    {
                        <div class="d-flex justify-center pa-6">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        </div>
                    }
                    else if (_auditLogs == null || !_auditLogs.Any())
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-3">
                            No se han registrado modificaciones o eventos en la bitácora para este empleado.
                        </MudAlert>
                    }
                    else
                    {
                        <MudTimeline TimelinePosition="TimelinePosition.Start" TimelineOrientation="TimelineOrientation.Vertical" Class="pa-2">
                            @foreach (var log in _auditLogs)
                            {
                                var badgeColor = log.Action == "Alta de Empleado" 
                                    ? Color.Success 
                                    : (log.Action == "Cambio de Estado" ? Color.Warning : Color.Primary);

                                <MudTimelineItem Color="@badgeColor" Elevation="2" Size="Size.Small">
                                    <ItemContent>
                                        <MudCard Outlined="true" Class="mb-3">
                                            <MudCardHeader Class="pb-1 pt-2">
                                                <CardHeaderAvatar>
                                                    <MudAvatar Color="@badgeColor" Size="Size.Small">
                                                        <MudIcon Icon="@(log.Action == "Alta de Empleado" ? Icons.Material.Filled.PersonAdd : (log.Action == "Cambio de Estado" ? Icons.Material.Filled.SwapHoriz : Icons.Material.Filled.EditNote))" Size="Size.Small" />
                                                    </MudAvatar>
                                                </CardHeaderAvatar>
                                                <CardHeaderContent>
                                                    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                                        <div>
                                                            <MudText Typo="Typo.subtitle2">@log.Action</MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                Por: <strong>@(string.IsNullOrWhiteSpace(log.UserName) ? "Sistema" : log.UserName)</strong>
                                                            </MudText>
                                                        </div>
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Icon="@Icons.Material.Filled.AccessTime">
                                                            @log.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                                                        </MudChip>
                                                    </div>
                                                </CardHeaderContent>
                                            </MudCardHeader>
                                            <MudCardContent Class="pt-1 pb-2">
                                                @if (log.Changes != null && log.Changes.Any())
                                                {
                                                    <MudSimpleTable Dense="true" Hover="true" Bordered="false" Striped="true" Style="overflow-x: auto;">
                                                        <thead>
                                                            <tr>
                                                                <th style="width: 30%;">Campo</th>
                                                                <th style="width: 35%;">Valor Anterior</th>
                                                                <th style="width: 35%;">Valor Nuevo</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var change in log.Changes)
                                                            {
                                                                <tr>
                                                                    <td><strong>@change.DisplayName</strong></td>
                                                                    <td><span class="text-secondary">@(change.OldValue ?? "-")</span></td>
                                                                    <td><span class="mud-primary-text font-weight-bold">@(change.NewValue ?? "-")</span></td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </MudSimpleTable>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(log.Details))
                                                {
                                                    <MudText Typo="Typo.body2">@log.Details</MudText>
                                                }
                                            </MudCardContent>
                                        </MudCard>
                                    </ItemContent>
                                </MudTimelineItem>
                            }
                        </MudTimeline>
                    }
                </MudTabPanel>
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        @if (_employee?.ShiftType == ShiftType.Rotativo)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CalendarMonth" OnClick="OpenRosterProjection">
                Ver Roster / Proyección
            </MudButton>
        }
        <MudSpacer />
        <MudButton OnClick="Cancel">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string EmployeeId { get; set; } = string.Empty;

    private EmployeeDto? _employee;
    private List<DeviceDto> _devices = new();
    private bool _loading = true;
    private string _selectedDeviceId = "";
    private bool _sending = false;
    private DevicePrivilege _devicePrivilege = DevicePrivilege.User;
    private bool _savingPrivilege = false;
    private bool _hasUpdated = false;

    private DeviceDto? SelectedDevice => _devices.FirstOrDefault(d => d.DeviceId == _selectedDeviceId);

    private IReadOnlyList<DevicePrivilegeOption> AvailablePrivileges =>
        SelectedDevice != null
            ? DevicePrivilegeMapper.GetSupportedPrivileges(SelectedDevice.Brand, SelectedDevice.DownloadMethod)
            : DevicePrivilegeMapper.GetSupportedPrivileges(DeviceBrand.ZKTeco);

    private DevicePrivilegeOption? CurrentPrivilegeOption =>
        AvailablePrivileges.FirstOrDefault(p => p.Value == _devicePrivilege);

    private void OnSelectedDeviceChanged(string deviceId)
    {
        _selectedDeviceId = deviceId;
        if (SelectedDevice != null)
        {
            var normalized = DevicePrivilegeMapper.NormalizeForDevice(SelectedDevice.Brand, _devicePrivilege);
            if (_devicePrivilege != normalized)
            {
                _devicePrivilege = normalized;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        
        // Load Employee
        var empResult = await Sender.Send(new GetEmployeeByIdQuery(EmployeeId));
        if (empResult.IsSuccess)
        {
            _employee = empResult.Value;
            _devicePrivilege = _employee.DevicePrivilege;
        }
        else
        {
            Snackbar.Add($"Error al cargar empleado: {empResult.Error}", Severity.Error);
            MudDialog.Cancel();
            return;
        }

        // Load Devices
        var devResult = await Sender.Send(new GetAllDevicesQuery());
        if (devResult.IsSuccess)
        {
            _devices = devResult.Value.Where(d => d.IsActive).ToList();
            if (_devices.Any() && string.IsNullOrEmpty(_selectedDeviceId))
            {
                _selectedDeviceId = _devices.First().DeviceId;
                OnSelectedDeviceChanged(_selectedDeviceId);
            }
        }

        await LoadAuditLogsAsync();

        _loading = false;
    }

    private List<EmployeeAuditLogDto> _auditLogs = new();
    private bool _loadingAuditLogs = false;

    private async Task LoadAuditLogsAsync()
    {
        _loadingAuditLogs = true;
        try
        {
            var auditResult = await Sender.Send(new GetEmployeeAuditLogsQuery(EmployeeId));
            if (auditResult.IsSuccess)
            {
                _auditLogs = auditResult.Value.ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar bitácora: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _loadingAuditLogs = false;
        }
    }

    private async Task SavePrivilege()
    {
        if (_employee == null) return;

        _savingPrivilege = true;
        StateHasChanged();

        try
        {
            var result = await Sender.Send(new UpdateEmployeeDevicePrivilegeCommand(EmployeeId, _devicePrivilege));
            if (result.IsSuccess)
            {
                _employee = _employee with { DevicePrivilege = _devicePrivilege };
                _hasUpdated = true;
                Snackbar.Add("Privilegio de reloj actualizado correctamente", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Error al actualizar privilegio: {result.Error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Excepción: {ex.Message}", Severity.Error);
        }
        finally
        {
            _savingPrivilege = false;
            StateHasChanged();
        }
    }

    private async Task SendToDevice()
    {
        if (string.IsNullOrEmpty(_selectedDeviceId)) return;

        _sending = true;
        StateHasChanged();

        var device = _devices.FirstOrDefault(d => d.DeviceId == _selectedDeviceId);
        
        try
        {
            var result = await Sender.Send(new SendEmployeeToDeviceCommand(EmployeeId, _selectedDeviceId, _devicePrivilege));
            
            if (result.IsSuccess)
            {
                if (_employee != null)
                {
                    _employee = _employee with { DevicePrivilege = _devicePrivilege };
                }
                _hasUpdated = true;
                Snackbar.Add($"Empleado enviado exitosamente a {device?.Name}", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Error al enviar: {result.Error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Excepción: {ex.Message}", Severity.Error);
        }
        finally
        {
            _sending = false;
            StateHasChanged();
        }
    }

    private async Task OpenRosterProjection()
    {
        if (_employee == null) return;
        var parameters = new DialogParameters
        {
            { nameof(RosterProjectionDialog.EmployeeId), _employee.Id },
            { nameof(RosterProjectionDialog.EmployeeName), _employee.FullName },
            { nameof(RosterProjectionDialog.SchemeName), "Rotativo" }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<RosterProjectionDialog>($"Proyección de Turnos - {_employee.FullName}", parameters, options);
    }

    private void Cancel()
    {
        if (_hasUpdated)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            MudDialog.Cancel();
        }
    }
}
