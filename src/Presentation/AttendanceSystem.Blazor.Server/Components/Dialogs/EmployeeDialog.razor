@using AttendanceSystem.Application.Features.Employees.Commands
@using AttendanceSystem.Application.Features.Employees.Queries
@using AttendanceSystem.Application.Features.ExternalEmployees.Commands
@using AttendanceSystem.Application.Features.ExternalEmployees.Queries
@using AttendanceSystem.Application.Features.Branches.Queries.GetBranches
@using AttendanceSystem.Application.Features.Departments.Queries.GetDepartments
@using AttendanceSystem.Application.Features.Positions.Queries.GetPositions
@using AttendanceSystem.Application.Features.Shifts.Queries.GetShifts
@using AttendanceSystem.Application.Features.Roster.Queries.GetRosterEmployees
@using AttendanceSystem.Application.Features.Roster.Commands.GenerateRotationPattern
@using AttendanceSystem.Application.DTOs
@using MediatR
@using ShiftTypeEnum = AttendanceSystem.Domain.Enumerations.ShiftType
@using WeekDayEnum = AttendanceSystem.Domain.Enumerations.WeekDay
@using StatusEnum = AttendanceSystem.Domain.Enumerations.EmployeeStatus
@using GenderEnum = AttendanceSystem.Domain.Enumerations.Gender
@using OvertimeEnum = AttendanceSystem.Domain.Enumerations.OvertimeCalculationMethod
@using OvertimeCapEnum = AttendanceSystem.Domain.Enumerations.OvertimeCapType
@using DevicePrivilegeEnum = AttendanceSystem.Domain.Enumerations.DevicePrivilege
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject ISender Sender
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <div class="d-flex flex-column align-center pa-4 mb-2">
                @if (!string.IsNullOrEmpty(Photo))
                {
                    <MudAvatar Style="height:100px; width:100px;" Elevation="4">
                        <MudImage Src="@($"data:image/jpeg;base64,{Photo}")" />
                    </MudAvatar>
                }
                else
                {
                    <MudAvatar Color="Color.Default" Style="height:100px; width:100px;" Elevation="4">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" />
                    </MudAvatar>
                }
                @if (!string.IsNullOrEmpty(FirstName))
                {
                    <MudText Typo="Typo.h6" Class="mt-2">@FirstName @LastName</MudText>
                }
            </div>

            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6">
                <MudTabPanel Text="General">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Id" Label="ID de Empleado" Required="true" RequiredError="El ID es requerido" Disabled="@(_isEditing)" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="FirstName" Label="Nombre" Required="true" RequiredError="El nombre es requerido" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="LastName" Label="Apellido" Required="true" RequiredError="El apellido es requerido" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="_hireDate" Label="Fecha de Contratación" Required="@(!IsSelectedBranchExternal)" Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" Disabled="@(!_canEditAll || IsSelectedBranchExternal)" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Email" Label="Email" InputType="InputType.Email" Disabled="@(!_canEditAll)" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="PhoneNumber" Label="Teléfono" Disabled="@(!_canEditAll)" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="GenderEnum" @bind-Value="Gender" Label="Sexo" Required="@(!IsSelectedBranchExternal)" RequiredError="El sexo es requerido" Disabled="@(!_canEditAll || IsSelectedBranchExternal)">
                                @foreach (var gender in Enum.GetValues<GenderEnum>())
                                {
                                    <MudSelectItem T="GenderEnum" Value="@gender">@(gender == GenderEnum.Male ? "Masculino" : "Femenino")</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="StatusEnum" @bind-Value="Status" Label="Estatus" Required="true">
                                @foreach (var status in Enum.GetValues<StatusEnum>())
                                {
                                    <MudSelectItem T="StatusEnum" Value="@status">@status.ToString()</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
                <MudTabPanel Text="Puesto">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="Guid" Value="BranchId" ValueChanged="OnBranchChanged" Label="Sucursal" Required="true" RequiredError="La sucursal es requerida" Disabled="@(!_canEditAll)">
                                @foreach (var branch in _branches)
                                {
                                    <MudSelectItem T="Guid" Value="@branch.Id">@branch.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="Guid" Value="DepartmentId" ValueChanged="OnDepartmentChanged" Label="Departamento" Required="@(!IsSelectedBranchExternal)" RequiredError="El departamento es requerido" Clearable="@IsSelectedBranchExternal">
                                @foreach (var department in _departments)
                                {
                                    <MudSelectItem T="Guid" Value="@department.Id">@department.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="Guid" @bind-Value="PositionId" Label="Puesto" Required="@(!IsSelectedBranchExternal)" RequiredError="El puesto es requerido" Clearable="@IsSelectedBranchExternal">
                                @foreach (var position in _filteredPositions)
                                {
                                    <MudSelectItem T="Guid" Value="@position.Id">@position.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
                <MudTabPanel Text="Horario">
                    @if (IsSelectedBranchExternal)
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-4">Esta sucursal es externa. El horario será gestionado en la sucursal de origen.</MudAlert>
                    }
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="ShiftTypeEnum?" Value="_selectedShiftType" ValueChanged="OnShiftTypeChanged" Label="Turno" Clearable="true" Disabled="@(!_canEditAll || IsSelectedBranchExternal)">
                                @foreach (var type in AvailableShiftTypes)
                                {
                                    <MudSelectItem T="ShiftTypeEnum?" Value="@type">@GetShiftTypeName(type)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        @if (_selectedShiftType == ShiftTypeEnum.Rotativo)
                        {
                            @if (_existingRoster != null && _existingRoster.HasRoster)
                            {
                                <MudItem xs="12">
                                    <MudPaper Class="pa-4 mb-2" Elevation="0" Outlined="true" Style="border-left: 4px solid var(--mud-palette-primary); background-color: var(--mud-palette-background-grey);">
                                        <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-2">
                                            <div class="d-flex align-center gap-2">
                                                <MudIcon Icon="@Icons.Material.Filled.AutoMode" Color="Color.Primary" Size="Size.Medium" />
                                                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Esquema Rotativo Activo</MudText>
                                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">@_existingRoster.SchemeName</MudChip>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.CalendarMonth" OnClick="OpenProjectionViewer">
                                                    Ver Proyección
                                                </MudButton>
                                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.EditCalendar" OnClick="@(() => _showEditRotationForm = !_showEditRotationForm)">
                                                    @(_showEditRotationForm ? "Ocultar Editor" : "Modificar Esquema")
                                                </MudButton>
                                            </div>
                                        </div>
                                        <MudGrid Class="mt-1">
                                            <MudItem xs="12" sm="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Vigencia Proyectada</MudText>
                                                <MudText Typo="Typo.body2">
                                                    @(_existingRoster.StartDate?.ToString("dd/MM/yyyy") ?? "—") al @(_existingRoster.EndDate?.ToString("dd/MM/yyyy") ?? "—")
                                                </MudText>
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Días Asignados</MudText>
                                                <MudText Typo="Typo.body2">@_existingRoster.TotalAssignments días</MudText>
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Estado / Turno Hoy</MudText>
                                                <MudText Typo="Typo.body2">@(_existingRoster.TodayStatus ?? "Sin turno hoy")</MudText>
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                </MudItem>
                            }

                            @if (_showEditRotationForm || _existingRoster == null || !_existingRoster.HasRoster)
                            {
                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                                        @(!_isEditing 
                                            ? "Este empleado trabajará bajo un esquema de turnos rotativos. Configure los parámetros para generar su calendario de turnos al guardar." 
                                            : "Configure los parámetros para generar o actualizar el esquema rotativo del empleado.")
                                    </MudAlert>
                                    <RotationSchemeConfigForm Model="_rotationModel" Shifts="_shifts" Disabled="@(!_canEditAll || IsSelectedBranchExternal)" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudCheckBox @bind-Value="_applyRotationScheme" Label="Generar / Actualizar proyección de turnos automáticamente al guardar" Color="Color.Primary" Disabled="@(!_canEditAll || IsSelectedBranchExternal)" />
                                </MudItem>
                            }
                        }
                        else
                        {
                            <MudItem xs="12" sm="6">
                                <MudSelect T="Guid?" @bind-Value="ScheduleId" Label="Horario" Clearable="true" HelperText="Mostrar solo los que coincidan con el turno seleccionado" Disabled="@(!_selectedShiftType.HasValue || !_canEditAll || IsSelectedBranchExternal)">
                                    @foreach (var shift in FilteredSchedules)
                                    {
                                        <MudSelectItem T="Guid?" Value="@shift.Id">@shift.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="WeekDayEnum" MultiSelection="true" @bind-SelectedValues="_selectedRestDays" Label="Día(s) de Descanso" MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetRestDaysSelectionText))" Clearable="true" AnchorOrigin="Origin.BottomCenter" Disabled="@(!_canEditAll || IsSelectedBranchExternal)">
                                    @foreach (var day in Enum.GetValues<WeekDayEnum>())
                                    {
                                        <MudSelectItem T="WeekDayEnum" Value="@day">@GetWeekDaySpanish(day)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        }

                        <MudItem xs="12" sm="6" Class="d-flex align-center">
                            <MudCheckBox @bind-Value="OvertimeAuthorized" Label="Autorizar Horas Extras" Color="Color.Primary" Disabled="@(!_canEditAll || IsSelectedBranchExternal)" />
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="d-flex align-center">
                            <MudCheckBox @bind-Value="CalculateOvertimeBeforeEntry" Label="Calcular Tiempo Extra Antes de Entrada" Color="Color.Secondary" Disabled="@(!OvertimeAuthorized || !_canEditAll || IsSelectedBranchExternal)" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="OvertimeEnum" @bind-Value="OvertimeCalculationMethod" Label="Cálculo Tiempo Extra" Required="true" Disabled="@(!OvertimeAuthorized || !_canEditAll || IsSelectedBranchExternal)">
                                @foreach (var method in Enum.GetValues<OvertimeEnum>())
                                {
                                    <MudSelectItem T="OvertimeEnum" Value="@method">
                                        @(method switch
                                        {
                                            OvertimeEnum.NoRounding => "Sin redondeo",
                                            OvertimeEnum.RoundByHalfHour => "Medias Horas",
                                            OvertimeEnum.RoundByHour => "Horas Completas",
                                            _ => method.ToString()
                                        })
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="OvertimeCapEnum" @bind-Value="OvertimeCapType" Label="Tope Tiempo Extra" Disabled="@(!_canEditAll || IsSelectedBranchExternal)">
                                @foreach (var type in Enum.GetValues<OvertimeCapEnum>())
                                {
                                    <MudSelectItem T="OvertimeCapEnum" Value="@type">
                                        @(type switch
                                        {
                                            OvertimeCapEnum.None => "Sin Tope",
                                            OvertimeCapEnum.Daily => "Por Día",
                                            OvertimeCapEnum.Period => "Por Periodo",
                                            _ => type.ToString()
                                        })
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="OvertimeCapMinutes" Label="Minutos Tope" Disabled="@(OvertimeCapType == OvertimeCapEnum.None || !_canEditAll || IsSelectedBranchExternal)" Min="0" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
                <MudTabPanel Text="Acceso">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="CardNumber" Label="Número de Tarjeta" HelperText="Deje vacío si no aplica" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="DevicePassword" Label="Contraseña PIN" HelperText="@(IsSelectedBranchExternal ? "No aplica para sucursales externas" : "Máximo 8 dígitos")" InputType="InputType.Password" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" Disabled="@IsSelectedBranchExternal" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="_loading">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? EmployeeId { get; set; }
    [Parameter] public Guid? ExternalEmployeeId { get; set; }
    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public string FirstName { get; set; } = string.Empty;
    [Parameter] public string LastName { get; set; } = string.Empty;
    [Parameter] public string Email { get; set; } = string.Empty;
    [Parameter] public string? PhoneNumber { get; set; }
    [Parameter] public DateTime HireDate { get; set; } = DateTime.Today;
    [Parameter] public Guid BranchId { get; set; }
    [Parameter] public Guid DepartmentId { get; set; }
    [Parameter] public Guid PositionId { get; set; }
    [Parameter] public StatusEnum Status { get; set; }
    [Parameter] public ShiftTypeEnum? ShiftType { get; set; }
    [Parameter] public Guid? ScheduleId { get; set; }
    [Parameter] public WeekDayEnum? RestDay { get; set; }
    [Parameter] public IEnumerable<int>? RestDays { get; set; }
    [Parameter] public bool OvertimeAuthorized { get; set; }
    [Parameter] public GenderEnum Gender { get; set; }
    [Parameter] public OvertimeEnum OvertimeCalculationMethod { get; set; }
    [Parameter] public OvertimeCapEnum OvertimeCapType { get; set; }
    [Parameter] public double? OvertimeCapMinutes { get; set; }
    [Parameter] public bool CalculateOvertimeBeforeEntry { get; set; }
    [Parameter] public string? CardNumber { get; set; }
    [Parameter] public string? DevicePassword { get; set; }
    [Parameter] public string? Photo { get; set; }
    [Parameter] public DevicePrivilegeEnum DevicePrivilege { get; set; } = DevicePrivilegeEnum.User;

    private DateTime? _hireDate;
    private bool _loading = true;
    private bool _isAdmin;
    private bool _isEditing => !string.IsNullOrEmpty(EmployeeId) || ExternalEmployeeId.HasValue;
    private bool _canEditAll => _isAdmin || !_isEditing;
    private bool IsSelectedBranchExternal => _branches.FirstOrDefault(b => b.Id == BranchId)?.IsExternal ?? false;
    private ShiftTypeEnum? _selectedShiftType;
    private IReadOnlyCollection<WeekDayEnum> _selectedRestDays = new HashSet<WeekDayEnum>();
    private List<BranchDto> _branches = new();
    private List<DepartmentDto> _departments = new();
    private List<PositionDto> _positions = new();
    private List<ShiftDto> _shifts = new();

    // Roster integration fields
    private RotationSchemeModel _rotationModel = new();
    private RosterEmployeeDto? _existingRoster;
    private bool _showEditRotationForm;
    private bool _applyRotationScheme = true;

    private static readonly ShiftTypeEnum[] AvailableShiftTypes =
    [
        ShiftTypeEnum.Matutino,
        ShiftTypeEnum.Vespertino,
        ShiftTypeEnum.Nocturno,
        ShiftTypeEnum.Mixto,
        ShiftTypeEnum.Flexible,
        ShiftTypeEnum.Partido,
        ShiftTypeEnum.Rotativo
    ];

    private IEnumerable<ShiftDto> FilteredSchedules
    {
        get
        {
            if (!_selectedShiftType.HasValue) return Enumerable.Empty<ShiftDto>();
            if (_selectedShiftType.Value == ShiftTypeEnum.Rotativo) return _shifts.OrderBy(s => s.StartTime).ToList();
            return _shifts.Where(s => s.ShiftType == _selectedShiftType.Value).OrderBy(s => s.StartTime).ToList();
        }
    }

    private IEnumerable<PositionDto> _filteredPositions = new List<PositionDto>();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("Administrador");

        _hireDate = HireDate;
        
        if (!string.IsNullOrEmpty(EmployeeId) && string.IsNullOrEmpty(Id))
        {
            Id = EmployeeId;
        }

        if (RestDays != null && RestDays.Any())
        {
            _selectedRestDays = RestDays.Select(d => (WeekDayEnum)d).ToHashSet();
            if (!RestDay.HasValue)
            {
                RestDay = _selectedRestDays.FirstOrDefault();
            }
        }
        else if (RestDay.HasValue)
        {
            _selectedRestDays = new HashSet<WeekDayEnum> { RestDay.Value };
        }

        await LoadData();
        
        if (ShiftType.HasValue)
        {
            _selectedShiftType = ShiftType.Value == ShiftTypeEnum.Continuo ? ShiftTypeEnum.Flexible : ShiftType;
        }
        else if (ScheduleId.HasValue)
        {
            var currentSchedule = _shifts.FirstOrDefault(s => s.Id == ScheduleId.Value);
            if (currentSchedule != null)
            {
                _selectedShiftType = currentSchedule.ShiftType == ShiftTypeEnum.Continuo ? ShiftTypeEnum.Flexible : currentSchedule.ShiftType;
            }
        }

        if (_selectedShiftType == ShiftTypeEnum.Rotativo)
        {
            _rotationModel.InitializeShifts(_shifts);
            await LoadRosterInfo();
        }
    }

    private void OnShiftTypeChanged(ShiftTypeEnum? newType)
    {
        _selectedShiftType = newType;
        if (_selectedShiftType == ShiftTypeEnum.Rotativo)
        {
            _applyRotationScheme = true;
            _rotationModel.InitializeShifts(_shifts);
            if (_existingRoster == null && !string.IsNullOrEmpty(Id))
            {
                _ = LoadRosterInfo();
            }
        }
    }

    private async Task LoadRosterInfo()
    {
        if (!string.IsNullOrEmpty(Id) && !IsSelectedBranchExternal)
        {
            try
            {
                var rosterList = await Sender.Send(new GetRosterEmployeesQuery(null, Id));
                _existingRoster = rosterList?.FirstOrDefault(r => r.EmployeeId == Id);
                if (_existingRoster != null && _existingRoster.HasRoster)
                {
                    if (_existingRoster.SchemeName.Contains("4x3", StringComparison.OrdinalIgnoreCase))
                        _rotationModel.SchemeType = RotationSchemeType.Esquema4x3;
                    else if (_existingRoster.SchemeName.Contains("24x48", StringComparison.OrdinalIgnoreCase))
                        _rotationModel.SchemeType = RotationSchemeType.Esquema24x48;
                    else if (_existingRoster.SchemeName.Contains("2x8", StringComparison.OrdinalIgnoreCase))
                        _rotationModel.SchemeType = RotationSchemeType.Rotativo2x8;
                    else if (_existingRoster.SchemeName.Contains("3x8", StringComparison.OrdinalIgnoreCase))
                        _rotationModel.SchemeType = RotationSchemeType.Rotativo3x8;
                }
            }
            catch
            {
                // Ignorar error si no hay datos de roster aún
            }
        }
    }

    private async Task OpenProjectionViewer()
    {
        if (string.IsNullOrEmpty(Id)) return;

        var fullName = $"{FirstName} {LastName}".Trim();
        var parameters = new DialogParameters
        {
            { nameof(RosterProjectionDialog.EmployeeId), Id },
            { nameof(RosterProjectionDialog.EmployeeName), string.IsNullOrEmpty(fullName) ? Id : fullName },
            { nameof(RosterProjectionDialog.SchemeName), _existingRoster?.SchemeName ?? "Rotativo" }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<RosterProjectionDialog>($"Proyección de Turnos - {fullName}", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await LoadRosterInfo();
        }
    }

    private void OnBranchChanged(Guid branchId)
    {
        BranchId = branchId;
        if (IsSelectedBranchExternal)
        {
            _selectedShiftType = null;
            ScheduleId = null;
            RestDay = null;
            _selectedRestDays = new HashSet<WeekDayEnum>();
            OvertimeAuthorized = false;
            CalculateOvertimeBeforeEntry = false;
            OvertimeCalculationMethod = OvertimeEnum.NoRounding;
            OvertimeCapType = OvertimeCapEnum.None;
            OvertimeCapMinutes = null;
        }
    }

    private void OnDepartmentChanged(Guid newDepartmentId)
    {
        DepartmentId = newDepartmentId;
        UpdateFilteredPositions();
        
        if (PositionId != Guid.Empty && !_filteredPositions.Any(p => p.Id == PositionId))
        {
            PositionId = Guid.Empty;
        }
    }

    private void UpdateFilteredPositions()
    {
        if (DepartmentId == Guid.Empty)
        {
            _filteredPositions = new List<PositionDto>();
        }
        else
        {
            var selectedDepartment = _departments.FirstOrDefault(d => d.Id == DepartmentId);
            if (selectedDepartment != null && selectedDepartment.PositionIds != null)
            {
                var validPositionIds = new HashSet<Guid>(selectedDepartment.PositionIds);
                _filteredPositions = _positions.Where(p => validPositionIds.Contains(p.Id)).OrderBy(p => p.Name).ToList();
            }
            else
            {
                _filteredPositions = new List<PositionDto>();
            }
        }
    }

    private async Task LoadData()
    {
        _loading = true;

        var branchesResult = await Sender.Send(new GetBranchesQuery());
        var departmentsResult = await Sender.Send(new GetDepartmentsQuery());
        var positionsResult = await Sender.Send(new GetPositionsQuery());
        var shiftsResult = await Sender.Send(new GetShiftsQuery());

        if (branchesResult.IsSuccess)
            _branches = branchesResult.Value.ToList();
        else
            Snackbar.Add("Error al cargar sucursales", Severity.Error);

        if (departmentsResult.IsSuccess)
            _departments = departmentsResult.Value.OrderBy(d => d.Name).ToList();
        else
            Snackbar.Add("Error al cargar departamentos", Severity.Error);

        if (positionsResult.IsSuccess)
            _positions = positionsResult.Value.OrderBy(p => p.Name).ToList();
        else
            Snackbar.Add("Error al cargar puestos", Severity.Error);

        if (shiftsResult.IsSuccess)
        {
            _shifts = shiftsResult.Value.OrderBy(s => s.StartTime).ToList();
            _rotationModel.InitializeShifts(_shifts);
        }
        else
            Snackbar.Add("Error al cargar turnos", Severity.Error);
            
        UpdateFilteredPositions();

        _loading = false;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(Id) || 
            string.IsNullOrWhiteSpace(FirstName) || 
            string.IsNullOrWhiteSpace(LastName) ||
            BranchId == Guid.Empty)
        {
            Snackbar.Add("Por favor complete todos los campos requeridos", Severity.Warning);
            return;
        }

        if (!IsSelectedBranchExternal)
        {
            if (DepartmentId == Guid.Empty ||
                PositionId == Guid.Empty ||
                !_hireDate.HasValue ||
                Gender == 0)
            {
                Snackbar.Add("Por favor complete todos los campos requeridos para el empleado", Severity.Warning);
                return;
            }

            if (!_filteredPositions.Any(p => p.Id == PositionId))
            {
                Snackbar.Add("El puesto seleccionado no pertenece al departamento seleccionado", Severity.Warning);
                return;
            }

            // Validar turno rotativo vs fijo
            if (_selectedShiftType == ShiftTypeEnum.Rotativo)
            {
                if (_applyRotationScheme)
                {
                    var validation = _rotationModel.Validate();
                    if (!validation.IsValid)
                    {
                        Snackbar.Add(validation.ErrorMessage!, Severity.Warning);
                        return;
                    }
                }
            }
            else
            {
                if (ScheduleId.HasValue && _selectedShiftType.HasValue)
                {
                    var selectedSchedule = _shifts.FirstOrDefault(s => s.Id == ScheduleId.Value);
                    if (selectedSchedule != null && selectedSchedule.ShiftType != _selectedShiftType.Value)
                    {
                        Snackbar.Add("El horario seleccionado no corresponde al turno seleccionado", Severity.Warning);
                        return;
                    }
                }
            }
        }

        // Validación de unicidad de ID
        if (!_isEditing)
        {
            if (!IsSelectedBranchExternal)
            {
                var existingEmployeeResult = await Sender.Send(new GetEmployeeByIdQuery(Id));
                if (existingEmployeeResult.IsSuccess)
                {
                    Snackbar.Add($"El ID '{Id}' ya se encuentra registrado. Utilice un ID diferente.", Severity.Error);
                    return;
                }
            }
            else
            {
                var branchName = _branches.FirstOrDefault(b => b.Id == BranchId)?.Name ?? "seleccionada";
                var externalEmployeesResult = await Sender.Send(new GetExternalEmployeesQuery(BranchId.ToString()));
                if (externalEmployeesResult.IsSuccess && externalEmployeesResult.Value != null)
                {
                    if (externalEmployeesResult.Value.Any(e => e.EmployeeNumber.Trim().Equals(Id.Trim(), StringComparison.OrdinalIgnoreCase)))
                    {
                        Snackbar.Add($"El ID '{Id}' ya se encuentra registrado en la sucursal externa '{branchName}'. Utilice un ID diferente.", Severity.Error);
                        return;
                    }
                }
            }
        }
        else if (IsSelectedBranchExternal)
        {
            var branchName = _branches.FirstOrDefault(b => b.Id == BranchId)?.Name ?? "seleccionada";
            var externalEmployeesResult = await Sender.Send(new GetExternalEmployeesQuery(BranchId.ToString()));
            if (externalEmployeesResult.IsSuccess && externalEmployeesResult.Value != null)
            {
                var targetId = ExternalEmployeeId;
                if (!targetId.HasValue && !string.IsNullOrEmpty(EmployeeId) && Guid.TryParse(EmployeeId, out var parsedGuid))
                {
                    targetId = parsedGuid;
                }

                if (externalEmployeesResult.Value.Any(e => 
                    (!targetId.HasValue || e.Id != targetId.Value) && 
                    e.EmployeeNumber.Trim().Equals(Id.Trim(), StringComparison.OrdinalIgnoreCase)))
                {
                    Snackbar.Add($"El ID '{Id}' ya se encuentra registrado para otro empleado en la sucursal externa '{branchName}'.", Severity.Error);
                    return;
                }
            }
        }

        var result = new EmployeeDialogResult();

        if (IsSelectedBranchExternal)
        {
            var deptName = _departments.FirstOrDefault(d => d.Id == DepartmentId)?.Name;
            var posName = _positions.FirstOrDefault(p => p.Id == PositionId)?.Name;

            var targetExtId = ExternalEmployeeId;
            if (!targetExtId.HasValue && !string.IsNullOrEmpty(EmployeeId) && Guid.TryParse(EmployeeId, out var parsedId))
            {
                targetExtId = parsedId;
            }

            if (targetExtId.HasValue)
            {
                result.UpdateExternalCommand = new UpdateExternalEmployeeCommand(
                    targetExtId.Value,
                    BranchId.ToString(),
                    Id,
                    FirstName,
                    LastName,
                    Email,
                    PhoneNumber,
                    posName,
                    deptName,
                    Status,
                    CardNumber);
            }
            else
            {
                result.CreateExternalCommand = new CreateExternalEmployeeCommand(
                    BranchId.ToString(),
                    Id,
                    FirstName,
                    LastName,
                    Email,
                    PhoneNumber,
                    posName,
                    deptName,
                    Status,
                    CardNumber);
            }
        }
        else
        {
            // Determinar fallback de ScheduleId y RestDay / RestDays
            Guid? effectiveScheduleId = ScheduleId;
            WeekDayEnum? effectiveRestDay = _selectedRestDays?.Cast<WeekDayEnum?>().FirstOrDefault() ?? RestDay;
            List<int>? effectiveRestDays = _selectedRestDays?.Select(d => (int)d).ToList();

            if (_selectedShiftType == ShiftTypeEnum.Rotativo)
            {
                if (_rotationModel.SchemeType == RotationSchemeType.Rotativo3x8 || _rotationModel.SchemeType == RotationSchemeType.Rotativo2x8)
                {
                    effectiveScheduleId = _rotationModel.Shift1 != Guid.Empty ? _rotationModel.Shift1 : ScheduleId;
                    if (_rotationModel.SelectedFixedRestDays != null && _rotationModel.SelectedFixedRestDays.Any())
                    {
                        effectiveRestDay = (WeekDayEnum?)(int)_rotationModel.SelectedFixedRestDays.First();
                        effectiveRestDays = _rotationModel.SelectedFixedRestDays.Select(d => (int)d).ToList();
                    }
                }
                else
                {
                    effectiveScheduleId = _rotationModel.BaseShift != Guid.Empty ? _rotationModel.BaseShift : ScheduleId;
                }

                if (_applyRotationScheme)
                {
                    result.RotationPatternCommand = _rotationModel.ToCommand(new List<string> { Id });
                }
            }

            if (!string.IsNullOrEmpty(EmployeeId))
            {
                result.UpdateCommand = new UpdateEmployeeCommand(
                    Id,
                    FirstName,
                    LastName,
                    Email,
                    PhoneNumber,
                    _hireDate!.Value,
                    Gender,
                    Status,
                    BranchId.ToString(),
                    DepartmentId.ToString(),
                    PositionId.ToString(),
                    _selectedShiftType,
                    effectiveScheduleId?.ToString(),
                    (int?)effectiveRestDay,
                    OvertimeAuthorized,
                    OvertimeCalculationMethod,
                    OvertimeCapType,
                    OvertimeCapMinutes,
                    CalculateOvertimeBeforeEntry,
                    CardNumber,
                    DevicePassword,
                    Photo,
                    DevicePrivilege,
                    effectiveRestDays);
            }
            else
            {
                result.CreateCommand = new CreateEmployeeCommand(
                    Id,
                    FirstName,
                    LastName,
                    Email,
                    PhoneNumber,
                    _hireDate!.Value,
                    Gender,
                    BranchId.ToString(),
                    DepartmentId.ToString(),
                    PositionId.ToString(),
                    _selectedShiftType,
                    effectiveScheduleId?.ToString(),
                    (int?)effectiveRestDay,
                    OvertimeAuthorized,
                    OvertimeCalculationMethod,
                    OvertimeCapType,
                    OvertimeCapMinutes,
                    CalculateOvertimeBeforeEntry,
                    CardNumber,
                    DevicePassword,
                    Photo,
                    DevicePrivilege,
                    effectiveRestDays);
            }
        }

        MudDialog.Close(DialogResult.Ok(result));
    }

    private string GetRestDaysSelectionText(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues == null || !selectedValues.Any()) return "Ningún día seleccionado";
        return string.Join(", ", selectedValues.Select(v =>
        {
            if (Enum.TryParse<WeekDayEnum>(v, true, out var wd))
            {
                return GetWeekDaySpanish(wd);
            }
            return v;
        }));
    }

    private static string GetWeekDaySpanish(WeekDayEnum day) => day switch
    {
        WeekDayEnum.Domingo => "Domingo",
        WeekDayEnum.Lunes => "Lunes",
        WeekDayEnum.Martes => "Martes",
        WeekDayEnum.Miercoles => "Miércoles",
        WeekDayEnum.Jueves => "Jueves",
        WeekDayEnum.Viernes => "Viernes",
        WeekDayEnum.Sabado => "Sábado",
        _ => day.ToString()
    };

    private static string GetShiftTypeName(ShiftTypeEnum type) => type switch
    {
        ShiftTypeEnum.Partido => "Partido / Doble Turno",
        _ => type.ToString()
    };
}
