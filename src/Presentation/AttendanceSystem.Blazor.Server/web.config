<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- startupTimeLimit: el arranque aplica las migraciones pendientes (con respaldo previo) antes de atender
           peticiones; con los 120 s por defecto, IIS abandona una actualización grande a la mitad.
           Debe ser al menos Database:MigrationTimeoutMinutes (30 min por defecto). -->
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" startupTimeLimit="1800" />
    </system.webServer>
  </location>
</configuration>
