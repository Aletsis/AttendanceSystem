<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- startupTimeLimit: el arranque aplica las migraciones pendientes (con respaldo previo) antes de atender
           peticiones; con los 120 s por defecto, IIS abandona una actualización grande a la mitad.
           3600 s es el máximo de IIS. Debe ser mayor que Database:StartupMigrationBudgetMinutes (50 min por defecto):
           así el arranque se rinde y lo registra antes de que IIS lo mate sin dejar rastro. -->
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" startupTimeLimit="3600" />
    </system.webServer>
  </location>
</configuration>
