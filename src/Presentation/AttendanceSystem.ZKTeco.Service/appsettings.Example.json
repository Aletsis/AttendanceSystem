{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  // Puerto TCP en el que escuchará el servicio gRPC (HTTP/2 sin TLS para red local)
  "GrpcPort": 5001,

  // Clave secreta compartida para autorizar las solicitudes gRPC entre Blazor Server / API y este servicio.
  // Debe coincidir con el valor 'ZKTecoService:ApiKey' configurado en la aplicación cliente.
  "ApiKey": "REEMPLAZAR_CON_UNA_CLAVE_SEGURA_DURANTE_LA_INSTALACION",

  // Tiempo de espera máximo (en segundos) para cerrar conexiones limpiamente al detener el servicio Windows
  "ShutdownTimeoutSeconds": 15,

  // Escucha de marcajes en tiempo real por SDK (los relojes los define la aplicación con SetRealtimeDevices).
  // HeartbeatInterval: cada cuánto se lee la hora del reloj para detectar una caída (el SDK no la avisa).
  // ReconnectDelays: esperas entre reintentos de conexión; el último se repite.
  // ChannelCapacity: eventos guardados mientras la aplicación no está suscrita (luego se descartan los más viejos).
  "Realtime": {
    "HeartbeatInterval": "00:00:30",
    "ReconnectDelays": [ "00:00:05", "00:00:10", "00:00:30", "00:01:00" ],
    "ChannelCapacity": 10000
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Grpc": "Information"
      }
    }
  }
}
