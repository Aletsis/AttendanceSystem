{
  "ConnectionStrings": {
    "AttendanceDb": "__DB_CONNECTION__",
    "HangfireDb": "__DB_CONNECTION__"
  },
  "Hosting": {
    "Standalone": __STANDALONE__
  },
  "ZKTecoService": {
    "Url": "http://localhost:5001",
    "ApiKey": "__API_KEY__"
  },
  "Backup": {
    "PostgresBinPath": "__PG_BIN__"
  },
  "Maintenance": {
    "PollIntervalSeconds": 5
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/wpf-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "AttendanceSystem.WPF"
    }
  }
}
