{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": {
      "3": {
        "Args": {
          "connectionString": "__DB_CONNECTION__"
        }
      }
    }
  },
  "ConnectionStrings": {
    "AttendanceDb": "__DB_CONNECTION__",
    "HangfireDb": "__DB_CONNECTION__"
  },
  "ZKTecoService": {
    "Url": "http://localhost:5001",
    "ApiKey": "__API_KEY__"
  }
}
